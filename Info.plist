<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>mailin</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>3</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2025-2026 mailin. All rights reserved.</string>

	<!-- Encryption: only Apple frameworks (CryptoKit, Security.framework, HTTPS) -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Privacy Usage Descriptions -->
	<key>NSDocumentsFolderUsageDescription</key>
	<string>mailin needs access to your Documents folder to import and export email archives (.mbox and .eml files).</string>

	<key>NSDesktopFolderUsageDescription</key>
	<string>mailin needs access to your Desktop to import email archives and export analysis results.</string>

	<key>NSDownloadsFolderUsageDescription</key>
	<string>mailin needs access to your Downloads folder to import email archives downloaded from email providers.</string>

	<key>NSFaceIDUsageDescription</key>
	<string>mailin uses Face ID or Touch ID to unlock the app and protect your email archives.</string>

	<key>NSContactsUsageDescription</key>
	<string>mailin uses your Contacts to identify email senders and enrich AI-powered analysis. All lookups happen on-device — no data leaves your Mac.</string>

	<key>NSCalendarsUsageDescription</key>
	<string>mailin checks your Calendar to correlate meetings with email discussions. All checks happen on-device — no data leaves your Mac.</string>

	<!-- iOS Document Browser Support -->
	<key>UISupportsDocumentBrowser</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- iOS Launch Screen (required for iOS submission) -->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- App Category -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>

	<!-- iOS Supported Interface Orientations -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Document Types -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>mbox</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>MBOX Email Archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.mail.mbox</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>eml</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Email Message</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.mail.email</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>emlx</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Apple Mail Message</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>msg</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Outlook Message</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>pst</string>
				<string>ost</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Outlook Archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
		</dict>
	</array>

	<!-- Exported Type Identifiers -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeDescription</key>
			<string>MBOX Email Archive</string>
			<key>UTTypeIdentifier</key>
			<string>com.apple.mail.mbox</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mbox</string>
				</array>
			</dict>
		</dict>
	</array>

</dict>
</plist>
