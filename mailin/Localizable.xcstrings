    "Subscriptions auto-renew until cancelled. Manage subscriptions in System Settings. Lifetime purchase is a one-time payment with no expiration." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnements verlängern sich automatisch bis zur Kündigung. Verwalten Sie Abonnements in den Systemeinstellungen. Der Lebenszeitkauf ist eine einmalige Zahlung ohne Ablaufdatum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones se renuevan automáticamente hasta cancelarlas. Gestiona las suscripciones en Ajustes del Sistema. La compra de por vida es un pago único sin fecha de caducidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements se renouvellent automatiquement jusqu'à annulation. Gérez vos abonnements dans les Réglages Système. L'achat à vie est un paiement unique sans date d'expiration."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सदस्यताएं रद्द होने तक स्वतः नवीनीकृत होती हैं। सिस्टम सेटिंग्स में सदस्यताएं प्रबंधित करें। आजीवन खरीद एकबारगी भुगतान है, कोई समाप्ति तिथि नहीं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションはキャンセルするまで自動更新されます。システム設定でサブスクリプションを管理できます。永久ライセンスは一回払いで有効期限はありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas são renovadas automaticamente até o cancelamento. Gerencie assinaturas nos Ajustes do Sistema. A compra vitalícia é um pagamento único sem data de expiração."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅将自动续订直至取消。在系统设置中管理订阅。终身购买为一次性付款，永不过期。"
          }
        }
      }
    },
