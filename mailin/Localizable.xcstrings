    "Buy once, own forever. No subscriptions." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal kaufen, für immer nutzen. Kein Abo."
