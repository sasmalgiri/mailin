    "Attach a file from your computer — copied into this case so it stays with the record, offline" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datei von Ihrem Computer anhängen — sie wird in diesen Fall kopiert, damit sie offline beim Datensatz bleibt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjunta un archivo de tu ordenador — se copia en este caso para que permanezca con el expediente, sin conexión"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joindre un fichier de votre ordinateur — copié dans ce dossier pour rester avec l'enregistrement, hors ligne"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने कंप्यूटर से फ़ाइल संलग्न करें — इस केस में कॉपी होती है ताकि ऑफ़लाइन रिकॉर्ड के साथ रहे"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allega un file dal tuo computer — viene copiato in questo caso così resta con il fascicolo, offline"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータからファイルを添付 — この案件にコピーされ、オフラインで記録と一緒に保持されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터에서 파일 첨부 — 이 사건으로 복사되어 오프라인에서 기록과 함께 유지됩니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anexe um arquivo do seu computador — copiado para este caso para que fique com o registro, offline"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从电脑附加文件——复制到此案件中，使其离线也随记录保存"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從電腦附加檔案——拷貝到此案件中，使其離線也隨記錄保存"
          }
        }
      }
    },
    "Attach archive emails as evidence rows, then rate each against every hypothesis (CC · C · N · I · II)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiv-E-Mails als Beweiszeilen anhängen, dann jede gegen jede Hypothese bewerten (CC · C · N · I · II)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjunta correos del archivo como filas de evidencia y luego valora cada uno frente a cada hipótesis (CC · C · N · I · II)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joignez des e-mails de l'archive comme lignes de preuve, puis évaluez chacun face à chaque hypothèse (CC · C · N · I · II)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संग्रह के ईमेल को साक्ष्य पंक्तियों के रूप में संलग्न करें, फिर हर एक को हर परिकल्पना के विरुद्ध रेट करें (CC · C · N · I · II)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allega email dell'archivio come righe di prova, poi valuta ciascuna rispetto a ogni ipotesi (CC · C · N · I · II)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブのメールを証拠行として添付し、それぞれを各仮説に対して評価します（CC · C · N · I · II）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함 이메일을 증거 행으로 첨부한 다음 각각을 모든 가설에 대해 평가하세요(CC · C · N · I · II)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anexe e-mails do arquivo como linhas de evidência e depois avalie cada um em relação a cada hipótese (CC · C · N · I · II)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将归档邮件附加为证据行，然后针对每个假设对其逐一评级（CC · C · N · I · II）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將封存郵件附加為證據列，然後針對每個假設逐一評等（CC · C · N · I · II）。"
          }
        }
      }
    },
