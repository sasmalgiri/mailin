    "Work a single reported email start to finish — analyze, verdict, contain, close — and post the verdict number your ticket cites." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine einzelne gemeldete E-Mail von Anfang bis Ende bearbeiten — analysieren, beurteilen, eindämmen, abschließen — und die Urteilsnummer veröffentlichen, auf die Ihr Ticket verweist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabajar un único correo notificado de principio a fin — analizar, dictaminar, contener, cerrar — y publicar el número de dictamen que cita tu ticket."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traiter un seul e-mail signalé du début à la fin — analyser, statuer, contenir, clore — et publier le numéro de verdict cité par votre ticket."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक रिपोर्ट किए गए ईमेल पर शुरू से अंत तक काम करें — विश्लेषण, निर्णय, रोकथाम, समापन — और वह निर्णय संख्या प्रकाशित करें जिसका आपका टिकट उल्लेख करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavorare una singola email segnalata dall'inizio alla fine — analizzare, decidere, contenere, chiudere — e pubblicare il numero di verdetto citato dal tuo ticket."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "報告された 1 通のメールを最初から最後まで処理 — 分析、判定、封じ込め、クローズ — チケットが参照する判定番号を掲載します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신고된 이메일 하나를 처음부터 끝까지 처리 — 분석, 판정, 차단, 종료 — 티켓이 인용하는 판정 번호를 게시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalhar um único e-mail relatado do início ao fim — analisar, decidir, conter, encerrar — e publicar o número do veredito que seu chamado cita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从头到尾处理一封被报告的邮件 — 分析、判定、遏制、结案 — 并发布你的工单所引用的判定编号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從頭到尾處理一封被回報的郵件 — 分析、判定、圍堵、結案 — 並發布你的工單所引用的判定編號。"
          }
        }
      }
    },
    "Work a suspected mailbox takeover end to end — scope, analyze rules/logins, verdict, contain and recover, report." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine vermutete Postfachübernahme von Anfang bis Ende bearbeiten — Umfang bestimmen, Regeln/Anmeldungen analysieren, beurteilen, eindämmen und wiederherstellen, berichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabajar una sospecha de toma de control de buzón de principio a fin — delimitar, analizar reglas/inicios de sesión, dictaminar, contener y recuperar, informar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traiter une prise de contrôle de boîte aux lettres suspectée de bout en bout — délimiter, analyser règles/connexions, statuer, contenir et rétablir, rendre compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संदिग्ध मेलबॉक्स अधिग्रहण पर शुरू से अंत तक काम करें — दायरा तय करें, नियमों/लॉगिन का विश्लेषण करें, निर्णय दें, रोकथाम और बहाली करें, रिपोर्ट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavorare una sospetta compromissione di casella dall'inizio alla fine — delimitare, analizzare regole/accessi, decidere, contenere e ripristinare, riferire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールボックス乗っ取りの疑いを最初から最後まで処理 — 範囲特定、ルール/ログインの分析、判定、封じ込めと復旧、報告。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사서함 탈취 의심 건을 처음부터 끝까지 처리 — 범위 파악, 규칙/로그인 분석, 판정, 차단 및 복구, 보고."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalhar uma suspeita de tomada de caixa de correio de ponta a ponta — delimitar, analisar regras/logins, decidir, conter e recuperar, relatar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从头到尾处理疑似邮箱被接管事件 — 确定范围、分析规则/登录、判定、遏制并恢复、报告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從頭到尾處理疑似郵件信箱遭接管事件 — 確定範圍、分析規則/登入、判定、圍堵並復原、報告。"
          }
        }
      }
    },
