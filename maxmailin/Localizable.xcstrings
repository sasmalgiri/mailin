    "encrypted for %@; no matching private key in this device's keychain — import the recipient's S/MIME identity (.p12) in Settings ▸ Health" : {
      "comment" : "A reason a locked S/MIME row states. The argument is a list of the recipients' names.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "verschlüsselt für %@; kein passender privater Schlüssel im Schlüsselbund dieses Geräts – importieren Sie die S/MIME-Identität (.p12) des Empfängers unter Einstellungen ▸ Zustand"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cifrado para %@; no hay una clave privada coincidente en el llavero de este dispositivo: importa la identidad S/MIME (.p12) del destinatario en Ajustes ▸ Estado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "chiffré pour %@ ; aucune clé privée correspondante dans le trousseau de cet appareil — importez l’identité S/MIME (.p12) du destinataire dans Réglages ▸ État"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के लिए एन्क्रिप्टेड; इस डिवाइस की कीचेन में कोई मेल खाती निजी कुंजी नहीं — सेटिंग्स ▸ स्वास्थ्य में प्राप्तकर्ता की S/MIME पहचान (.p12) आयात करें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cifrato per %@; nessuna chiave privata corrispondente nel portachiavi di questo dispositivo — importa l’identità S/MIME (.p12) del destinatario in Impostazioni ▸ Stato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 宛てに暗号化されています。このデバイスのキーチェーンに一致する秘密鍵がありません — 設定 ▸ 状態 で受信者の S/MIME ID（.p12）を読み込んでください"
