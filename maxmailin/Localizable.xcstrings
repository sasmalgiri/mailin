    "Every email in scope with a hash-tree proof to the archive fingerprint — verifiable with SHA-256 alone" : {
      "comment" : "A description of the export functionality.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede E-Mail im Umfang mit einem Hash-Baum-Nachweis zum Archiv-Fingerabdruck — allein mit SHA-256 prüfbar"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
