    "Set a verdict before containment — don't lock a user out on a hunch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor der Eindämmung ein Urteil festlegen — sperren Sie niemanden aufgrund einer Ahnung aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establece un veredicto antes de la contención — no bloquees a un usuario por una corazonada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendez un verdict avant le confinement — ne bloquez pas un utilisateur sur une intuition."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नियंत्रण से पहले निर्णय तय करें — अनुमान पर किसी उपयोगकर्ता को लॉक न करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilisci un verdetto prima del contenimento — non bloccare un utente per un sospetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封じ込めの前に判定を下してください — 勘でユーザーを締め出さないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "격리 전에 판정을 내리세요 — 추측만으로 사용자를 차단하지 마세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina um veredito antes da contenção — não bloqueie um usuário por palpite."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遏制前先作出裁定 — 不要凭直觉封锁用户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圍堵前先做出裁定 — 不要憑直覺封鎖使用者。"
          }
        }
      }
    },
    "Set a verdict first — an incident can't be closed without a disposition on record." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuerst ein Urteil festlegen — ein Vorfall kann nicht ohne aktenkundige Entscheidung geschlossen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establece primero un veredicto — un incidente no puede cerrarse sin una resolución registrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendez d'abord un verdict — un incident ne peut être clos sans décision consignée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले निर्णय तय करें — रिकॉर्ड पर निपटान के बिना घटना बंद नहीं की जा सकती।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilisci prima un verdetto — un incidente non può essere chiuso senza una decisione agli atti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず判定を下してください — 処置が記録されないままインシデントを閉じることはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 판정을 내리세요 — 처리 결정이 기록되지 않으면 인시던트를 종결할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina um veredito primeiro — um incidente não pode ser encerrado sem uma decisão registrada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先作出裁定 — 没有记录在案的处置，事件无法关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先做出裁定 — 沒有記錄在案的處置，事件無法結案。"
          }
        }
      }
    },
