          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントもメールサーバもデータ収集もありません。アーカイブがデバイスの外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정도, 메일 서버도, 데이터 수집도 없습니다. 보관함은 기기 밖으로 나가지 않습니다."
