    "Tidy a personal archive — import, dedupe, categorize, and export a clean backup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein persönliches Archiv aufräumen — importieren, deduplizieren, kategorisieren und eine saubere Sicherung exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordenar un archivo personal — importar, deduplicar, categorizar y exportar una copia de seguridad limpia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ranger une archive personnelle — importer, dédupliquer, catégoriser et exporter une sauvegarde propre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "व्यक्तिगत आर्काइव व्यवस्थित करें — आयात करें, डुप्लिकेट हटाएँ, वर्गीकृत करें और साफ़ बैकअप निर्यात करें।"
