    "%lld message%@ %@ stored from headers only, because %@ too large to read fully. %@ read from the original file when opened or exported, so keep that file where it was imported from. %@ text is not searchable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Nachricht%2$@ %3$@ nur aus den Headern gespeichert, weil %4$@ zu groß zum vollständigen Lesen. %5$@ beim Öffnen oder Exportieren aus der Originaldatei gelesen; lassen Sie diese Datei daher dort, wo sie importiert wurde. %6$@ Text ist nicht durchsuchbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld message%2$@ %3$@ stored from headers only, because %4$@ too large to read fully. %5$@ read from the original file when opened or exported, so keep that file where it was imported from. %6$@ text is not searchable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld mensaje%2$@ %3$@ guardado(s) solo con las cabeceras, porque %4$@ demasiado grande(s) para leerse por completo. %5$@ se lee(n) del archivo original al abrir o exportar, así que conserva ese archivo donde se importó. %6$@ texto no se puede buscar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld message%2$@ %3$@ stocké(s) à partir des en-têtes seulement, car %4$@ trop volumineux pour être lu(s) en entier. %5$@ lu(s) depuis le fichier d'origine à l'ouverture ou à l'export : conservez donc ce fichier là où il a été importé. %6$@ texte n'est pas interrogeable."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld संदेश%2$@ %3$@ केवल हेडर से संग्रहीत, क्योंकि %4$@ पूरा पढ़ने के लिए बहुत बड़ा। %5$@ खोलने या निर्यात करने पर मूल फ़ाइल से पढ़ा जाता है, इसलिए उस फ़ाइल को वहीं रखें जहाँ से आयात की गई। %6$@ पाठ खोजने योग्य नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld messaggio%2$@ %3$@ archiviato/i solo dalle intestazioni, perché %4$@ troppo grande/i per essere letto/i per intero. %5$@ letto/i dal file originale all'apertura o all'esportazione: lascia quel file dove è stato importato. %6$@ testo non è ricercabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージ %1$lld 件%2$@ %3$@ は、%4$@ 全文を読むには大きすぎるため、ヘッダのみで保存されました。%5$@ 開くときや書き出すときに元のファイルから読み込むので、そのファイルは読み込んだ場所に置いたままにしてください。%6$@ 本文は検索できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지 %1$lld개%2$@ %3$@은(는) %4$@ 전체를 읽기에 너무 커서 헤더만 저장되었습니다. %5$@ 열거나 내보낼 때 원본 파일에서 읽으므로, 해당 파일을 가져온 위치에 그대로 두세요. %6$@ 본문은 검색할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld mensagem%2$@ %3$@ armazenada(s) apenas pelos cabeçalhos, porque %4$@ grande(s) demais para leitura completa. %5$@ lida(s) do arquivo original ao abrir ou exportar, então mantenha esse arquivo onde foi importado. %6$@ texto não é pesquisável."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld 条消息%2$@ %3$@ 仅按邮件头存储，因为 %4$@ 过大，无法完整读取。%5$@ 在打开或导出时从原始文件读取，因此请将该文件保留在导入时的位置。%6$@ 正文不可搜索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld 則訊息%2$@ %3$@ 僅以郵件標頭儲存，因為 %4$@ 過大而無法完整讀取。%5$@ 在開啟或匯出時從原始檔案讀取，因此請將該檔案留在匯入時的位置。%6$@ 內文無法搜尋。"
          }
        }
      }
    },
