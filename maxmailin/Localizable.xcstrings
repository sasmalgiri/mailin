      }
    },
    "Bates numbers provide unique sequential identifiers for each document in legal proceedings. These numbers are permanent — once assigned, they create a fixed reference for production and court citation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bates-Nummern sind eindeutige fortlaufende Kennungen für jedes Dokument in Gerichtsverfahren. Sie sind dauerhaft — einmal vergeben, bilden sie eine feste Referenz für Produktion und Zitierung vor Gericht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los números Bates son identificadores secuenciales únicos para cada documento en procedimientos legales. Son permanentes: una vez asignados, crean una referencia fija para la producción y la cita judicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les numéros Bates fournissent des identifiants séquentiels uniques pour chaque document dans les procédures judiciaires. Ils sont permanents — une fois attribués, ils créent une référence fixe pour la production et la citation devant le tribunal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bates नंबर कानूनी कार्यवाही में हर दस्तावेज़ के लिए अद्वितीय क्रमिक पहचानकर्ता देते हैं। ये स्थायी हैं — एक बार दिए जाने पर उत्पादन और अदालती उद्धरण के लिए स्थिर संदर्भ बनाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I numeri Bates forniscono identificativi sequenziali univoci per ogni documento nei procedimenti legali. Sono permanenti — una volta assegnati, creano un riferimento fisso per la produzione e la citazione in giudizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bates 番号は、法的手続きにおける各書類の一意な連番識別子です。永続的なもので、一度割り当てると、提出や法廷での引用のための固定参照になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bates 번호는 법적 절차에서 각 문서에 대한 고유한 순차 식별자를 제공합니다. 이 번호는 영구적입니다 — 한 번 할당되면 제출 및 법정 인용을 위한 고정 참조가 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os números Bates fornecem identificadores sequenciais exclusivos para cada documento em processos judiciais. Eles são permanentes — uma vez atribuídos, criam uma referência fixa para produção e citação em juízo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bates 编号为法律程序中的每份文档提供唯一的连续标识符。这些编号是永久的——一经分配，即成为生成和法庭引用的固定参考。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bates 編號為法律程序中的每份文件提供唯一的連續識別碼。這些編號是永久的——一經指派，即成為產出和法庭引用的固定參考。"
          }
        }
      }
    },
