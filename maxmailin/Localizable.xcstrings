    "What mailin reads, and on what evidence. “Spec-built” means tested on fixtures written from the format description, not on files from the program itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was mailin liest und auf welcher Grundlage. „Spezifikationsbasiert“ heißt: getestet mit Testdateien, die aus der Formatbeschreibung erstellt wurden, nicht mit Dateien des Programms selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué lee mailin y con qué evidencia. «Según especificación» significa probado con archivos de prueba construidos a partir de la descripción del formato, no con archivos del propio programa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que mailin lit, et sur quelle preuve. « D'après la spécification » signifie testé sur des fichiers construits à partir de la description du format, pas sur des fichiers du programme lui-même."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin क्या पढ़ता है और किस प्रमाण के आधार पर। “विनिर्देश से बने” का अर्थ है प्रारूप के विवरण से बनाई गई परीक्षण फ़ाइलों पर जाँचा गया, स्वयं प्रोग्राम की फ़ाइलों पर नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa legge mailin e con quali prove. \"Da specifica\" significa testato su file di prova costruiti dalla descrizione del formato, non su file del programma stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin が読み取る内容と、その根拠。「仕様から作成」とは、形式の説明に基づいて作ったテストファイルで検証したことを指し、そのプログラム自体のファイルではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin이 읽는 내용과 그 근거. \"사양 기반\"은 형식 설명을 바탕으로 만든 테스트 파일로 검사했음을 뜻하며, 해당 프로그램의 실제 파일로 검사한 것이 아닙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que o mailin lê e com que evidência. \"Pela especificação\" significa testado em arquivos de teste criados a partir da descrição do formato, não em arquivos do próprio programa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin 读取的内容及其依据。“按规范构建”指在依据格式说明编写的测试文件上测试，而非该程序自身生成的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin 讀取的內容及其依據。「按規格建立」指在依據格式說明編寫的測試檔案上測試，而非該程式本身產生的檔案。"
          }
        }
      }
    },
