    },
    "Moves every verified extra copy to the Trash in one step (restorable); each email keeps exactly one copy, with every folder, label, tag and note merged into it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt jede verifizierte Zusatzkopie in einem Schritt in den Papierkorb (wiederherstellbar); jede E-Mail behält genau eine Kopie, in die alle Ordner, Labels, Tags und Notizen übernommen werden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve cada copia adicional verificada a la Papelera en un solo paso (restaurable); cada correo conserva exactamente una copia, con todas sus carpetas, etiquetas y notas fusionadas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace chaque copie supplémentaire vérifiée vers la Corbeille en une étape (restaurable) ; chaque courriel garde exactement une copie, dans laquelle tous les dossiers, libellés, tags et notes sont fusionnés"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर सत्यापित अतिरिक्त प्रति को एक ही चरण में ट्रैश में ले जाता है (पुनर्स्थापना योग्य); हर ईमेल की ठीक एक प्रति रहती है, जिसमें सभी फ़ोल्डर, लेबल, टैग और नोट मिला दिए जाते हैं"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta ogni copia extra verificata nel Cestino in un solo passaggio (ripristinabile); ogni email conserva esattamente una copia, con tutte le cartelle, etichette, tag e note unite in essa"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検証済みの余分なコピーをすべて1回でゴミ箱へ移動します（復元可能）。各メールはちょうど1つのコピーを保持し、すべてのフォルダ、ラベル、タグ、メモがそこに統合されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검증된 추가 사본을 모두 한 번에 휴지통으로 이동합니다(복원 가능). 각 메일은 정확히 하나의 사본만 유지하며 모든 폴더, 라벨, 태그, 메모가 거기에 병합됩니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move cada cópia extra verificada para o Lixo em um passo (restaurável); cada e-mail mantém exatamente uma cópia, com todas as pastas, marcadores, tags e notas mescladas nela"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一步将所有已验证的多余副本移到废纸篓（可恢复）；每封邮件只保留一份副本，并将所有文件夹、标签、标记和备注合并到其中"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一步將所有已驗證的多餘副本移到垃圾桶（可還原）；每封郵件只保留一份副本，並將所有資料夾、標籤、標記和備註合併到其中"
          }
        }
      }
    },
    "Moves the selected copies to the Trash, restorable; their folders, labels, tags and notes are merged into the kept copy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt die ausgewählten Kopien wiederherstellbar in den Papierkorb; ihre Ordner, Labels, Tags und Notizen werden in die behaltene Kopie übernommen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve las copias seleccionadas a la Papelera, de forma restaurable; sus carpetas, etiquetas y notas se fusionan en la copia conservada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace les copies sélectionnées vers la Corbeille, de façon restaurable ; leurs dossiers, libellés, tags et notes sont fusionnés dans la copie conservée"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चयनित प्रतियों को ट्रैश में ले जाता है, जो पुनर्स्थापित की जा सकती हैं; उनके फ़ोल्डर, लेबल, टैग और नोट रखी गई प्रति में मिला दिए जाते हैं"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta le copie selezionate nel Cestino, in modo ripristinabile; le loro cartelle, etichette, tag e note vengono unite nella copia conservata"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したコピーを復元可能な形でゴミ箱へ移動します。フォルダ、ラベル、タグ、メモは保持されるコピーに統合されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 사본을 복원 가능하게 휴지통으로 이동합니다. 폴더, 라벨, 태그, 메모는 유지되는 사본에 병합됩니다"
          }
        },
        "pt-BR" : {
