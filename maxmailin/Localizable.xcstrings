          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Deep recovery also scans the unused space of %1$@ of PST/OST data — about %2$lld–%3$lld s more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación profunda también analiza el espacio sin usar de %@ de datos PST/OST: unos %lld–%lld s más."
