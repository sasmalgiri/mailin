    "Zero data collection. Everything runs on your device; there is no cloud AI." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Datenerfassung. Alles läuft auf deinem Gerät; es gibt keine Cloud-KI."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cero recopilación de datos. Todo se ejecuta en tu dispositivo; no hay IA en la nube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune collecte de données. Tout s'exécute sur votre appareil ; il n'y a pas d'IA dans le cloud."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शून्य डेटा संग्रह। सब कुछ आपके डिवाइस पर चलता है; कोई क्लाउड AI नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero raccolta di dati. Tutto viene eseguito sul tuo dispositivo; non c'è IA nel cloud."
          }
