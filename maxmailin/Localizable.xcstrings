    },
    "These hashes are of the reconstructed source, not of captured wire bytes." : {
      "comment" : "A warning that the hashes are of the reconstructed source, not of captured wire bytes.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Hashes gelten für die rekonstruierte Quelle, nicht für erfasste Originalbytes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos hashes son de la fuente reconstruida, no de bytes originales capturados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces hachages portent sur la source reconstruite, pas sur des octets d'origine capturés."
