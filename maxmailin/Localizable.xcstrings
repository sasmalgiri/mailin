    "Showing %lld of %lld emails matching current filters. Use tags, risk scores, and hot folders to narrow your forensic review scope." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$lld E-Mails angezeigt, die den aktuellen Filtern entsprechen. Verwenden Sie Tags, Risikowerte und Hot Folders, um den Umfang Ihrer forensischen Prüfung einzugrenzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Showing %1$lld of %2$lld emails matching current filters. Use tags, risk scores, and hot folders to narrow your forensic review scope."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrando %1$lld de %2$lld correos que coinciden con los filtros actuales. Usa etiquetas, puntuaciones de riesgo y carpetas activas para acotar el ámbito de tu revisión forense."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichage de %1$lld e-mails sur %2$lld correspondant aux filtres actuels. Utilisez les étiquettes, les scores de risque et les dossiers actifs pour restreindre le périmètre de votre révision forensique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्तमान फ़िल्टर से मेल खाने वाले %2$lld में से %1$lld ईमेल दिखा रहे हैं। अपनी फ़ोरेंसिक समीक्षा का दायरा सीमित करने के लिए टैग, जोखिम स्कोर और हॉट फ़ोल्डर का उपयोग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizzate %1$lld di %2$lld email corrispondenti ai filtri correnti. Usa tag, punteggi di rischio e cartelle attive per restringere l'ambito della tua revisione forense."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のフィルタに一致する %2$lld 件中 %1$lld 件のメールを表示しています。タグ、リスクスコア、ホットフォルダを使ってフォレンジックレビューの範囲を絞り込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 필터와 일치하는 이메일 %2$lld개 중 %1$lld개를 표시합니다. 태그, 위험 점수, 핫 폴더를 사용해 포렌식 검토 범위를 좁히세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrando %1$lld de %2$lld e-mails que correspondem aos filtros atuais. Use etiquetas, pontuações de risco e pastas ativas para restringir o escopo da sua revisão forense."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在显示符合当前筛选条件的 %2$lld 封邮件中的 %1$lld 封。使用标签、风险评分和热点文件夹来缩小取证审阅范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在顯示符合目前篩選條件的 %2$lld 封郵件中的 %1$lld 封。使用標籤、風險評分和熱點檔案夾來縮小取證審閱範圍。"
          }
        }
      }
    },
