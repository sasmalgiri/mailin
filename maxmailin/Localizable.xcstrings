        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay pistas. Usa el campo de arriba para escribir una, o consulta la sección de pistas detectadas automáticamente para ver puntos de partida sugeridos por la IA."
