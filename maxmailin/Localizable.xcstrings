        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह %@ साफ़ करता है और स्वागत स्क्रीन पर लौटता है। आप कभी भी दोबारा आयात कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione cancella %@ e torna alla schermata di benvenuto. Puoi reimportare in qualsiasi momento."
