    "Running analysis and scheduled digests stop, and the model is unloaded. Saved summaries and reports are kept, and your archive is untouched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laufende Analysen und geplante Digests werden angehalten, und das Modell wird entladen. Gespeicherte Zusammenfassungen und Berichte bleiben erhalten, und Ihr Archiv bleibt unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los análisis en curso y los resúmenes programados se detienen y el modelo se descarga. Los resúmenes e informes guardados se conservan y tu archivo queda intacto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les analyses en cours et les synthèses planifiées s'arrêtent, et le modèle est déchargé. Les résumés et rapports enregistrés sont conservés, et votre archive reste intacte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चल रहे विश्लेषण और निर्धारित डाइजेस्ट रुक जाते हैं और मॉडल अनलोड हो जाता है। सहेजे गए सारांश और रिपोर्ट बने रहते हैं और आपका आर्काइव अछूता रहता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le analisi in corso e i riepiloghi pianificati si fermano e il modello viene scaricato. I riepiloghi e i report salvati vengono conservati e il tuo archivio resta intatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中の分析と予定されたダイジェストは停止し、モデルはアンロードされます。保存済みの要約とレポートは残り、アーカイブには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 중인 분석과 예약된 다이제스트가 중지되고 모델이 언로드됩니다. 저장된 요약과 보고서는 유지되며 아카이브는 그대로입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As análises em andamento e os resumos agendados param, e o modelo é descarregado. Resumos e relatórios salvos são mantidos, e seu arquivo permanece intacto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在运行的分析和计划的摘要会停止，模型会被卸载。已保存的摘要和报告会保留，你的归档不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在執行的分析與排程的摘要會停止，模型會被卸載。已儲存的摘要與報告會保留，你的封存不受影響。"
          }
        }
      }
    },
