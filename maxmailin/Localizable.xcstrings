    "Archives from mailin 1.0 migrate automatically with exact verification — every email, tag and note accounted for, duplicates preserved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive aus mailin 1.0 werden automatisch mit exakter Verifizierung migriert — jede E-Mail, jedes Tag und jede Notiz wird berücksichtigt, Duplikate bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos de mailin 1.0 migran automáticamente con verificación exacta — cada correo, etiqueta y nota queda contabilizado, los duplicados se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les archives de mailin 1.0 migrent automatiquement avec une vérification exacte — chaque e-mail, étiquette et note est comptabilisé, les doublons sont préservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin 1.0 के संग्रह सटीक सत्यापन के साथ स्वतः माइग्रेट होते हैं — हर ईमेल, टैग और नोट का हिसाब, डुप्लिकेट संरक्षित।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli archivi di mailin 1.0 migrano automaticamente con verifica esatta — ogni email, tag e nota è contabilizzata, i duplicati sono conservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin 1.0 のアーカイブは正確な検証付きで自動的に移行されます — すべてのメール、タグ、メモが照合され、重複も保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin 1.0의 아카이브는 정확한 검증과 함께 자동으로 마이그레이션됩니다 — 모든 이메일, 태그, 메모가 확인되고 중복도 보존됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos do mailin 1.0 migram automaticamente com verificação exata — cada e-mail, etiqueta e nota é contabilizado, duplicatas preservadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin 1.0 的归档会自动迁移并精确验证 — 每封邮件、标签和备注都有据可查，重复项保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin 1.0 的封存會自動移轉並精確驗證 — 每封郵件、標籤和備註都有據可查，重複項目保留。"
          }
        }
      }
    },
