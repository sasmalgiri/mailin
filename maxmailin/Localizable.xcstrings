    "Pull every %@ document into one spreadsheet — one row per document, a column for every field. Export to Excel/Numbers." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes %@-Dokument in eine Tabelle ziehen — eine Zeile pro Dokument, eine Spalte pro Feld. Export nach Excel/Numbers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reúne todos los documentos %@ en una hoja de cálculo — una fila por documento, una columna por campo. Exporta a Excel/Numbers."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rassemblez tous les documents %@ dans une feuille de calcul — une ligne par document, une colonne par champ. Export vers Excel/Numbers."
