    "Post a reversal (storno) — the correction model; the record is never edited in place" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stornobuchung buchen — das Korrekturmodell; der Datensatz wird nie direkt bearbeitet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publicar una reversión (storno) — el modelo de corrección; el registro nunca se edita en su lugar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publier une contre-passation (storno) — le modèle de correction ; l'enregistrement n'est jamais modifié sur place"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उलट प्रविष्टि (स्टोर्नो) पोस्ट करें — सुधार मॉडल; रिकॉर्ड कभी जगह पर संपादित नहीं होता"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pubblica uno storno — il modello di correzione; il record non viene mai modificato sul posto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
