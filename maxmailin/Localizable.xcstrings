          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 원본 메시지와 PREMIS 메타데이터가 담긴 BagIt 백 — 기록 보존 표준"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
