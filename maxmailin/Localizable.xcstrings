    "Recover inadvertently produced material — identify it, notify opposing counsel, redact or remove, and log it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versehentlich herausgegebenes Material zurückholen — identifizieren, die Gegenseite informieren, schwärzen oder entfernen und protokollieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperar material producido por error — identificarlo, notificar a la parte contraria, censurar o eliminar, y registrarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupérer du matériel produit par inadvertance — l'identifier, prévenir la partie adverse, caviarder ou retirer, et le consigner."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गलती से प्रस्तुत सामग्री वापस लें — पहचानें, विपक्षी वकील को सूचित करें, छिपाएँ या हटाएँ और लॉग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperare materiale prodotto per errore — identificarlo, avvisare la controparte, oscurare o rimuovere, e registrarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誤って提出した資料を回収 — 特定し、相手方に通知し、墨消しまたは削除して記録します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실수로 제출한 자료 회수 — 식별하고, 상대방에 통지하고, 가리거나 제거하고, 기록합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperar material produzido inadvertidamente — identificá-lo, notificar a parte contrária, ocultar ou remover, e registrar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追回误提交的材料 — 识别、通知对方律师、遮盖或移除，并记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追回誤提交的資料 — 識別、通知對造律師、遮蓋或移除，並記錄。"
          }
        }
      }
    },
    "Recurring: renews every month until cancelled" : {
