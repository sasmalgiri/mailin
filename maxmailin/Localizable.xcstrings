    "Each AI filter you turn on counts once; the count starts again every day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder KI-Filter, den Sie einschalten, zählt einmal; die Zählung beginnt jeden Tag neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada filtro de IA que activas cuenta una vez; el recuento vuelve a empezar cada día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque filtre IA que vous activez compte une fois ; le décompte repart chaque jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जो भी AI फ़िल्टर चालू करते हैं, वह एक बार गिना जाता है; गिनती हर दिन फिर से शुरू होती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni filtro IA che attivi conta una volta; il conteggio riparte ogni giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにした AI フィルタはそれぞれ 1 回と数えられます。回数は毎日リセットされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜는 AI 필터마다 한 번으로 집계되며, 횟수는 매일 다시 시작됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada filtro de IA que você ativa conta uma vez; a contagem recomeça todos os dias."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你打开的每个 AI 过滤器计一次；计数每天重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你開啟的每個 AI 篩選器計一次；計數每天重新開始。"
          }
        }
      }
    },
