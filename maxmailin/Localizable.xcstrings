    "Simple — fast, clean browsing. Search and date range cover the whole archive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfach — schnelles, aufgeräumtes Browsen. Suche und Datumsbereich decken das gesamte Archiv ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simple — navegación rápida y limpia. La búsqueda y el rango de fechas cubren todo el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simple — navigation rapide et épurée. La recherche et la plage de dates couvrent toute l'archive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सरल — तेज़, साफ़ ब्राउज़िंग। खोज और तिथि सीमा पूरे संग्रह को कवर करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semplice — navigazione rapida e pulita. Ricerca e intervallo di date coprono l'intero archivio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シンプル — 高速で見やすいブラウズ。検索と日付範囲はアーカイブ全体を対象とします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "간단 — 빠르고 깔끔한 탐색. 검색과 날짜 범위는 전체 아카이브를 대상으로 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simples — navegação rápida e limpa. Busca e intervalo de datas cobrem todo o arquivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "简洁 — 快速、清爽的浏览。搜索和日期范围覆盖整个归档。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簡潔 — 快速、清爽的瀏覽。搜尋和日期範圍涵蓋整個封存。"
          }
        }
      }
    },
    "Simple reading, search, and attachment recovery" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfaches Lesen, Suchen und Wiederherstellen von Anhängen"
