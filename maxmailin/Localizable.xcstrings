          "stringUnit" : {
            "state" : "translated",
            "value" : "Score de gravité de 0 à 100 %. Au-dessus de 70 % = Critique, 40-70 % = Moyen, en dessous de 40 % = Faible"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गंभीरता स्कोर 0-100%। 70% से ऊपर = गंभीर, 40-70% = मध्यम, 40% से नीचे = कम"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punteggio di gravità da 0 a 100%. Sopra il 70% = Critico, 40-70% = Medio, sotto il 40% = Basso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深刻度スコア 0〜100%。70% 超 = 重大、40〜70% = 中、40% 未満 = 低"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심각도 점수 0-100%. 70% 초과 = 심각, 40-70% = 보통, 40% 미만 = 낮음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pontuação de gravidade de 0-100%. Acima de 70% = Crítico, 40-70% = Médio, abaixo de 40% = Baixo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "严重性评分 0-100%。高于 70% = 严重，40-70% = 中等，低于 40% = 低"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嚴重性評分 0-100%。高於 70% = 嚴重，40-70% = 中等，低於 40% = 低"
          }
        }
      }
    },
