    "Notable quotes detected in emails, ranked by potential newsworthiness." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In E-Mails erkannte bemerkenswerte Zitate, nach möglichem Nachrichtenwert sortiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citas destacadas detectadas en los correos, ordenadas por posible interés periodístico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citations notables détectées dans les e-mails, classées par intérêt médiatique potentiel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ईमेल में पहचाने गए उल्लेखनीय उद्धरण, संभावित समाचार-योग्यता के अनुसार क्रमबद्ध।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citazioni rilevanti rilevate nelle email, ordinate per potenziale notiziabilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールで検出された注目すべき引用。ニュース価値の可能性順。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일에서 감지된 주목할 만한 인용문, 잠재적 뉴스 가치순으로 정렬."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citações notáveis detectadas nos e-mails, classificadas por potencial relevância jornalística."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在邮件中检测到的值得注意的引文，按潜在新闻价值排序。"
