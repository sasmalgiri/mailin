          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आयात किया गया मेल अब खोजा जा सकता है (हेडर और संदेश-पाठ)। अनुलग्नक पाठ: %1$lld ईमेल अभी अनुक्रमित होने बाकी, %2$lld पूर्ण — %3$@।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
