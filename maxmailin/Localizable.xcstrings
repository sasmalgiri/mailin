    "Index covers every message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Index deckt jede Nachricht ab"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El índice cubre todos los mensajes"
          }
        },
        "fr" : {
          "stringUnit" : {
