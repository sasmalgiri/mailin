    "Use \"Redacted Export\" in email detail to strip PII before sharing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie „Geschwärzter Export“ in der E-Mail-Detailansicht, um personenbezogene Daten vor dem Teilen zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa «Exportación redactada» en el detalle del correo para eliminar la PII antes de compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez « Export caviardé » dans le détail de l'e-mail pour retirer les données personnelles avant de partager."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साझा करने से पहले PII हटाने के लिए ईमेल विवरण में \"रिडैक्टेड निर्यात\" का उपयोग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa «Esportazione oscurata» nel dettaglio email per rimuovere le PII prima di condividere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有前に PII を除去するには、メール詳細の「墨消し書き出し」を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 전에 PII를 제거하려면 이메일 세부 정보에서 \"편집 삭제 내보내기\"를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use “Exportação com tarjas” nos detalhes do e-mail para remover PII antes de compartilhar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在邮件详情中使用“涂黑导出”以在共享前移除个人信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在郵件詳細資料中使用「遮蔽匯出」以在分享前移除個人資料。"
          }
        }
      }
    },
    "Use AI to summarize threads, find contradictions, and build timelines" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
