    "All %lld emails verified — SHA-256 hashes match sealed originals. Collection integrity confirmed for e-discovery production." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle %lld E-Mails überprüft — SHA-256-Hashes stimmen mit den versiegelten Originalen überein. Sammlungsintegrität für die E-Discovery-Produktion bestätigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los %lld correos verificados — los hashes SHA-256 coinciden con los originales sellados. Integridad de la colección confirmada para la producción de e-discovery."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
