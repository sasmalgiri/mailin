        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 단계, 체크리스트 및 메모가 재설정됩니다. 실행 취소할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
