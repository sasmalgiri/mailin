            "value" : "E-Discovery"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ई-डिस्कवरी"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-Discovery"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
