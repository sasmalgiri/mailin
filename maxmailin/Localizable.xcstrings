        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI でスレッドを要約し、矛盾を見つけ、タイムラインを作成する"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI를 사용하여 스레드를 요약하고, 모순을 찾고, 타임라인을 구축하세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
