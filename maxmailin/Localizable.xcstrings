    },
    "The AI wants to: %@\n\nThis action will modify your data. Proceed?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI möchte: %@\n\nDiese Aktion ändert Ihre Daten. Fortfahren?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA quiere: %@\n\nEsta acción modificará tus datos. ¿Continuar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'IA souhaite : %@\n\nCette action modifiera vos données. Continuer ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI चाहता है: %@\n\nयह क्रिया आपके डेटा को बदल देगी। आगे बढ़ें?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'IA vuole: %@\n\nQuesta azione modificherà i tuoi dati. Procedere?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI の要求: %@\n\nこの操作はデータを変更します。続行しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI의 요청: %@\n\n이 작업은 데이터를 수정합니다. 진행하시겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A IA quer: %@\n\nEsta ação modificará seus dados. Continuar?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 想要：%@\n\n此操作将修改您的数据。是否继续？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 想要：%@\n\n此動作將修改您的資料。是否繼續？"
          }
        }
      }
    },
    "The AI's best guess about this email. Click to see every AI label — click a wrong one to remove it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die beste Einschätzung der KI zu dieser E-Mail. Klicken, um alle KI-Labels zu sehen — ein falsches anklicken, um es zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mejor estimación de la IA sobre este correo. Haz clic para ver todas las etiquetas de IA — haz clic en una incorrecta para eliminarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La meilleure estimation de l'IA pour cet e-mail. Cliquez pour voir toutes les étiquettes IA — cliquez sur une étiquette erronée pour la supprimer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस ईमेल के बारे में AI का सर्वोत्तम अनुमान। हर AI लेबल देखने के लिए क्लिक करें — किसी गलत लेबल को हटाने के लिए उस पर क्लिक करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La migliore ipotesi dell'IA su questa email. Fai clic per vedere tutte le etichette IA — fai clic su una errata per rimuoverla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このメールに対する AI の最良の推定です。クリックするとすべての AI ラベルが表示されます — 間違ったラベルをクリックすると削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이메일에 대한 AI의 최선의 추정입니다. 클릭하면 모든 AI 레이블이 표시됩니다 — 잘못된 레이블을 클릭하면 제거됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O melhor palpite da IA sobre este e-mail. Clique para ver todos os rótulos de IA — clique em um errado para removê-lo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 对此邮件的最佳推测。点按查看所有 AI 标签 — 点按错误的标签可将其移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 對此郵件的最佳推測。按一下查看所有 AI 標籤 — 按一下錯誤的標籤可將其移除。"
          }
        }
      }
    },
    "The annotation IS the finding." : {
