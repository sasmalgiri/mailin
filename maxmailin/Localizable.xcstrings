    },
    "Legal holds, evidence seals, custodians, custody events and review coding are stored in the archive database with fast bulk updates. The previous files are kept up to date too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechtliche Sperren, Beweissiegel, Verwahrer, Verwahrungsereignisse und Prüfcodierung werden mit schnellen Massenaktualisierungen in der Archivdatenbank gespeichert. Die bisherigen Dateien werden ebenfalls aktuell gehalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las retenciones legales, sellos probatorios, custodios, eventos de custodia y codificación de revisión se guardan en la base de datos del archivo con actualizaciones masivas rápidas. Los archivos anteriores también se mantienen al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservations légales, sceaux de preuve, dépositaires, événements de garde et codage de revue sont stockés dans la base de l’archive avec des mises à jour groupées rapides. Les fichiers précédents restent aussi à jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कानूनी होल्ड, साक्ष्य सील, संरक्षक, अभिरक्षा घटनाएँ और समीक्षा कोडिंग तेज़ थोक अपडेट के साथ आर्काइव डेटाबेस में संग्रहीत होती हैं। पिछली फ़ाइलें भी अद्यतित रखी जाती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocchi legali, sigilli probatori, custodi, eventi di custodia e codifica di revisione sono salvati nel database dell’archivio con aggiornamenti in blocco rapidi. Anche i file precedenti restano aggiornati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リーガルホールド、証拠の封印、保管者、保管履歴、レビューのコーディングは、高速な一括更新でアーカイブのデータベースに保存されます。以前のファイルも最新の状態に保たれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "법적 보존, 증거 봉인, 관리자, 보관 이력, 검토 코딩이 빠른 일괄 업데이트로 보관함 데이터베이스에 저장됩니다. 이전 파일도 계속 최신 상태로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retenções legais, selos de evidência, custodiantes, eventos de custódia e codificação de revisão são armazenados no banco de dados do arquivo com atualizações em massa rápidas. Os arquivos anteriores também continuam atualizados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "法律保留、证据封印、保管人、保管事件和审阅编码通过快速批量更新存储在归档数据库中。之前的文件也会保持最新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "法律保留、證據封印、保管人、保管事件和審閱編碼透過快速批次更新儲存在封存資料庫中。先前的檔案也會保持最新。"
          }
        }
      }
    },
    "Legal keywords automatically detected in this email — these may indicate privilege, litigation relevance, or compliance issues" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
