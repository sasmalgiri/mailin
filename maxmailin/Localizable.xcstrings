    "Repairs store/FTS drift after a crash between commits and collapses duplicate FTS rows; bounded, restartable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repariert Abweichungen zwischen Speicher und FTS nach einem Absturz zwischen Commits und fasst doppelte FTS-Zeilen zusammen; begrenzt, neustartfähig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repara la desviación entre el almacén y FTS tras un fallo entre confirmaciones y colapsa las filas FTS duplicadas; acotado, reanudable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répare la dérive magasin/FTS après un plantage entre deux commits et fusionne les lignes FTS en double ; borné, redémarrable."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कमिट के बीच क्रैश के बाद स्टोर/FTS विचलन सुधारता है और डुप्लिकेट FTS पंक्तियों को समेटता है; सीमित, पुनरारंभ योग्य।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripara la deriva archivio/FTS dopo un arresto anomalo tra i commit e unisce le righe FTS duplicate; limitato, riavviabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コミット間のクラッシュ後のストアと FTS のずれを修復し、重複した FTS 行を統合します。範囲限定で再開可能。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커밋 사이의 충돌 후 저장소/FTS 불일치를 복구하고 중복 FTS 행을 병합합니다. 제한적이며 재시작 가능."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repara o desvio entre armazenamento e FTS após uma falha entre commits e colapsa linhas FTS duplicadas; limitado, reiniciável."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
