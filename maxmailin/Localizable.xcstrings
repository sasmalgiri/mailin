    "Search, legal hold, collection verification, classification, review batches and production files cover the whole archive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche, rechtliche Sperre, Sammlungsprüfung, Klassifizierung, Prüfstapel und Produktionsdateien umfassen das gesamte Archiv."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Búsqueda, retención legal, verificación de la colección, clasificación, lotes de revisión y archivos de producción abarcan todo el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche, conservation légale, vérification de la collection, classification, lots de revue et fichiers de production couvrent toute l’archive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोज, कानूनी होल्ड, संग्रह सत्यापन, वर्गीकरण, समीक्षा बैच और प्रोडक्शन फ़ाइलें पूरे आर्काइव को कवर करती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricerca, blocco legale, verifica della raccolta, classificazione, lotti di revisione e file di produzione coprono l’intero archivio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索、リーガルホールド、コレクションの検証、分類、レビューバッチ、提出ファイルがアーカイブ全体を対象とします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색, 법적 보존, 모음 검증, 분류, 검토 묶음, 제출 파일이 전체 보관함을 대상으로 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca, retenção legal, verificação da coleção, classificação, lotes de revisão e arquivos de produção abrangem o arquivo inteiro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索、法律保留、集合验证、分类、审阅批次和制作文件涵盖整个归档。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜尋、法律保留、集合驗證、分類、審閱批次和製作檔案涵蓋整個封存。"
          }
        }
      }
    },
    "Search, tick the messages you want, then Add them to this step." : {
