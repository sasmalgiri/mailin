    "Map who knew whom — extract the entities, chart the connections, and turn the network into the spine of your story." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbilden, wer wen kannte — Entitäten extrahieren, Verbindungen darstellen und das Netzwerk zum Rückgrat Ihrer Geschichte machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapear quién conocía a quién — extraer las entidades, trazar las conexiones y convertir la red en la columna vertebral de tu historia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartographier qui connaissait qui — extraire les entités, tracer les liens et faire du réseau l'épine dorsale de votre récit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दर्शाएँ कि कौन किसे जानता था — इकाइयाँ निकालें, संबंधों का चार्ट बनाएँ और नेटवर्क को अपनी कहानी की रीढ़ बनाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappare chi conosceva chi — estrarre le entità, tracciare le connessioni e fare della rete la spina dorsale della tua storia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰が誰を知っていたかを図示 — エンティティを抽出し、つながりを描き、ネットワークをストーリーの軸にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누가 누구를 알았는지 매핑 — 개체를 추출하고, 연결을 그리고, 네트워크를 기사의 뼈대로 삼습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapear quem conhecia quem — extrair as entidades, traçar as conexões e transformar a rede na espinha dorsal da sua história."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标出谁认识谁 — 提取实体、绘制关联，并让网络成为报道的骨架。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
