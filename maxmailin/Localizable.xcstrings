    "Personal and Professional remove the daily Ask limit and include Summaries and Reports." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal und Professional heben das tägliche Fragen-Limit auf und enthalten Zusammenfassungen und Berichte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal y Professional eliminan el límite diario de Preguntar e incluyen Resúmenes e Informes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal et Professional suppriment la limite quotidienne de Demander et incluent Résumés et Rapports."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal और Professional दैनिक पूछें सीमा हटाते हैं और सारांश व रिपोर्ट शामिल करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal e Professional rimuovono il limite giornaliero di Chiedi e includono Riepiloghi e Report."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal と Professional では「質問」の 1 日の上限がなくなり、要約とレポートが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal과 Professional은 일일 질문하기 한도를 없애고 요약 및 보고서를 포함합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal e Professional removem o limite diário de Perguntar e incluem Resumos e Relatórios."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal 和 Professional 取消每日提问限制，并包含摘要和报告。"
          }
