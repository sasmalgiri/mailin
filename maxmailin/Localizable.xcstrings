        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दौर %1$lld (%2$@) ने %3$@ का और हिस्सा पढ़ा; जो अभी नहीं पढ़ा गया वह उसके रिकॉर्ड में है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il round %1$lld (%2$@) ha letto altre parti di %3$@; ciò che non è ancora letto è elencato nel suo record."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ラウンド %1$lld（%2$@）で %3$@ をさらに読み取りました。未読み取りの部分は記録に示されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라운드 %1$lld(%2$@)에서 %3$@을(를) 더 읽었습니다. 아직 읽지 않은 부분은 기록에 나와 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rodada %1$lld (%2$@) leu mais de %3$@; o que ainda não foi lido está listado no seu registro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 %1$lld 轮（%2$@）读取了 %3$@ 的更多内容；仍未读取的部分已列在其记录中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
