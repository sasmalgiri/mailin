    "Tag emails as evidence, verify integrity with SHA-256 hashes, and export audit logs for legal review." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-Mails als Beweis taggen, Integrität mit SHA-256-Hashes verifizieren und Prüfprotokolle für die juristische Prüfung exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiqueta correos como evidencia, verifica la integridad con hashes SHA-256 y exporta registros de auditoría para la revisión legal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étiquetez les e-mails comme preuves, vérifiez l'intégrité avec des hachages SHA-256 et exportez les journaux d'audit pour la révision juridique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ईमेल को साक्ष्य के रूप में टैग करें, SHA-256 हैश से अखंडता सत्यापित करें, और कानूनी समीक्षा के लिए ऑडिट लॉग निर्यात करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagga le email come prove, verifica l'integrità con hash SHA-256 ed esporta i registri di audit per la revisione legale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールを証拠としてタグ付けし、SHA-256 ハッシュで完全性を検証し、法務レビュー用に監査ログを書き出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일을 증거로 태그하고, SHA-256 해시로 무결성을 확인하고, 법률 검토를 위해 감사 로그를 내보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquete e-mails como evidência, verifique a integridade com hashes SHA-256 e exporte registros de auditoria para revisão jurídica."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将邮件标记为证据，使用 SHA-256 哈希值验证完整性，并导出审计日志以供法律审阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將郵件標記為證據，使用 SHA-256 雜湊值驗證完整性，並匯出稽核記錄以供法律審閱。"
          }
        }
      }
    },
    "Tag emails as relevant or irrelevant. The system learns your pattern and predicts relevance for unreviewed emails." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-Mails als relevant oder irrelevant taggen. Das System lernt Ihr Muster und sagt die Relevanz für ungeprüfte E-Mails vorher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiqueta los correos como relevantes o irrelevantes. El sistema aprende tu patrón y predice la relevancia de los correos no revisados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étiquetez les e-mails comme pertinents ou non pertinents. Le système apprend votre schéma et prédit la pertinence des e-mails non examinés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ईमेल को प्रासंगिक या अप्रासंगिक के रूप में टैग करें। सिस्टम आपका पैटर्न सीखता है और असमीक्षित ईमेल की प्रासंगिकता का पूर्वानुमान लगाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagga le email come pertinenti o non pertinenti. Il sistema apprende il tuo schema e prevede la pertinenza delle email non esaminate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールを関連あり/無関係としてタグ付けします。システムがパターンを学習し、未レビューのメールの関連性を予測します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일을 관련 또는 무관으로 태그하세요. 시스템이 패턴을 학습하여 검토되지 않은 이메일의 관련성을 예측합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquete e-mails como relevantes ou irrelevantes. O sistema aprende seu padrão e prevê a relevância dos e-mails não revisados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将邮件标记为相关或不相关。系统会学习您的模式并预测未审阅邮件的相关性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將郵件標記為相關或不相關。系統會學習您的模式並預測未審閱郵件的相關性。"
          }
        }
      }
    },
