    "Tidy a personal archive — import, dedupe, categorize, and export a clean backup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein persönliches Archiv aufräumen — importieren, deduplizieren, kategorisieren und eine saubere Sicherung exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordenar un archivo personal — importar, deduplicar, categorizar y exportar una copia de seguridad limpia."
