    "The license key's signature does not match — it was changed or not issued for mailin." : {
      "comment" : "Error message when the signature of the license key does not match.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Signatur des Lizenzschlüssels stimmt nicht — er wurde verändert oder nicht für mailin ausgestellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La firma de la clave de licencia no coincide: se modificó o no se emitió para mailin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La signature de la clé de licence ne correspond pas — elle a été modifiée ou n’a pas été émise pour mailin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइसेंस कुंजी का हस्ताक्षर मेल नहीं खाता — इसे बदला गया है या यह mailin के लिए जारी नहीं की गई।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La firma della chiave di licenza non corrisponde — è stata modificata o non è stata emessa per mailin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライセンスキーの署名が一致しません。変更されたか、mailin 用に発行されたものではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이선스 키의 서명이 일치하지 않습니다. 변경되었거나 mailin용으로 발급되지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A assinatura da chave de licença não confere — ela foi alterada ou não foi emitida para o mailin."
