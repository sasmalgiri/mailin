    "Several reviewers work on one case kept on a shared drive, with signed logs, batches, a conflict list and quality control. No server needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrere Prüfende arbeiten an einem Fall auf einem freigegebenen Laufwerk — mit signierten Protokollen, Stapeln, Konfliktliste und Qualitätskontrolle. Ohne Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varios revisores trabajan en un caso guardado en una unidad compartida, con registros firmados, lotes, lista de conflictos y control de calidad. Sin servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs relecteurs travaillent sur un dossier stocké sur un disque partagé, avec journaux signés, lots, liste de conflits et contrôle qualité. Sans serveur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कई समीक्षक शेयर्ड ड्राइव पर रखे एक केस पर काम करते हैं — हस्ताक्षरित लॉग, बैच, टकराव सूची और गुणवत्ता नियंत्रण के साथ। सर्वर की ज़रूरत नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più revisori lavorano su un caso conservato su un’unità condivisa, con registri firmati, lotti, elenco dei conflitti e controllo qualità. Nessun server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有ドライブ上の 1 つのケースで複数のレビュー担当者が作業します。署名付きログ、バッチ、競合リスト、品質管理付き。サーバー不要。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 검토자가 공유 드라이브에 있는 하나의 케이스에서 작업합니다. 서명된 로그, 배치, 충돌 목록, 품질 관리 포함. 서버 불필요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vários revisores trabalham num caso guardado numa unidade compartilhada, com registros assinados, lotes, lista de conflitos e controle de qualidade. Sem servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多名审阅者在共享驱动器上的同一案件中协作，带签名日志、批次、冲突列表和质量控制。无需服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多名審閱者在共享磁碟上的同一案件中協作，具備簽署日誌、批次、衝突清單與品質控制。無需伺服器。"
          }
        }
      }
    },
    "Severity score from 0-100%. Above 70% = Critical, 40-70% = Medium, below 40% = Low" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schweregrad von 0–100 %. Über 70 % = Kritisch, 40–70 % = Mittel, unter 40 % = Niedrig"
