    "Toggle Pro to access forensic analysis, evidence tagging, legal hold, Bates numbering, and e-discovery tools." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro einschalten, um forensische Analyse, Beweis-Tagging, Legal Hold, Bates-Nummerierung und E-Discovery-Werkzeuge zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Pro para acceder al análisis forense, el etiquetado de evidencia, la retención legal, la numeración Bates y las herramientas de e-discovery."
