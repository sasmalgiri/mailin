    "Use an app-specific password from your Apple Account settings. Keep two-factor authentication on." : {
      "comment" : "Text to display in a note when signing in to iCloud Mail.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie ein app-spezifisches Passwort aus den Einstellungen Ihres Apple Accounts. Lassen Sie die Zwei-Faktor-Authentifizierung eingeschaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use una contraseña específica de app de los ajustes de su Cuenta de Apple. Mantenga activada la autenticación de doble factor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
