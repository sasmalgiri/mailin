    "Semantic similarity between the two claims — higher similarity with opposing meaning suggests a stronger contradiction" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semantische Ähnlichkeit der beiden Aussagen — hohe Ähnlichkeit bei gegensätzlicher Bedeutung deutet auf einen stärkeren Widerspruch hin"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Similitud semántica entre las dos afirmaciones — mayor similitud con significado opuesto sugiere una contradicción más fuerte"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Similarité sémantique entre les deux affirmations — une forte similarité avec un sens opposé suggère une contradiction plus forte"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों दावों के बीच अर्थगत समानता — विपरीत अर्थ के साथ उच्च समानता मज़बूत विरोधाभास का संकेत देती है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somiglianza semantica tra le due affermazioni — maggiore somiglianza con significato opposto suggerisce una contraddizione più forte"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 つの主張間の意味的類似度 — 意味が相反しながら類似度が高い場合、より強い矛盾を示唆します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 주장 간의 의미적 유사성 — 의미가 반대이면서 유사성이 높으면 더 강한 모순을 시사합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semelhança semântica entre as duas afirmações — maior semelhança com significado oposto sugere uma contradição mais forte"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两个主张之间的语义相似度 — 相似度高但含义相反，表明矛盾更强"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩個主張之間的語意相似度 — 相似度高但含義相反，表示矛盾更強"
          }
        }
      }
    },
