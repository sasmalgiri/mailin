    "Press “Open tool” and run the job there. This step completes only when the job's saved receipt says it succeeded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie „Werkzeug öffnen“ und führen Sie den Auftrag dort aus. Dieser Schritt ist erst abgeschlossen, wenn die gesicherte Quittung des Auftrags den Erfolg bestätigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa «Abrir herramienta» y ejecuta allí la tarea. Este paso solo se completa cuando el recibo guardado de la tarea indica que se realizó correctamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur « Ouvrir l'outil » et exécutez-y la tâche. Cette étape n’est terminée que lorsque le reçu enregistré de la tâche indique sa réussite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“टूल खोलें” दबाएँ और कार्य वहीं चलाएँ। यह चरण तभी पूरा होता है जब कार्य की सहेजी गई रसीद बताती है कि वह सफल हुआ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi “Apri strumento” ed esegui lì l’attività. Questo passaggio si completa solo quando la ricevuta salvata dell’attività indica che è riuscita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ツールを開く」を押し、そこでジョブを実行してください。このステップは、ジョブの保存済み受領書が成功を示したときにのみ完了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘도구 열기’를 누르고 그곳에서 작업을 실행하십시오. 이 단계는 작업의 저장된 영수증이 성공했다고 표시할 때만 완료됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione “Abrir ferramenta” e execute a tarefa nela. Esta etapa só é concluída quando o recibo salvo da tarefa indica que ela foi bem-sucedida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按“打开工具”并在其中运行该作业。只有当作业已存储的回执显示成功时，此步骤才会完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按「開啟工具」並在其中執行該工作。只有當工作已儲存的收據顯示成功時，此步驟才會完成。"
          }
        }
      }
    },
