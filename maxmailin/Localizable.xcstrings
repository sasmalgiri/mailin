    "Whole archives are compared by Message-ID and by subject, sender and minute. Nothing is held in memory beyond one page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganze Archive werden nach Message-ID sowie nach Betreff, Absender und Minute verglichen. Über eine Seite hinaus wird nichts im Speicher gehalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos completos se comparan por Message-ID y por asunto, remitente y minuto. No se mantiene en memoria más de una página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les archives entières sont comparées par Message-ID et par sujet, expéditeur et minute. Rien n'est conservé en mémoire au-delà d'une page."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे संग्रहों की तुलना Message-ID तथा विषय, प्रेषक और मिनट के आधार पर की जाती है। एक पेज से अधिक कुछ भी मेमोरी में नहीं रखा जाता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli archivi interi vengono confrontati per Message-ID e per oggetto, mittente e minuto. Nulla viene tenuto in memoria oltre una pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブ全体を Message-ID と、件名・送信者・分単位で比較します。メモリに保持されるのは 1 ページ分のみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 아카이브를 Message-ID와 제목, 발신자, 분 단위로 비교합니다. 한 페이지 이상은 메모리에 보관하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos inteiros são comparados por Message-ID e por assunto, remetente e minuto. Nada é mantido na memória além de uma página."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整个归档按 Message-ID 以及主题、发件人和分钟进行比较。内存中最多只保留一页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整個封存依 Message-ID 以及主旨、寄件者和分鐘進行比較。記憶體中最多只保留一頁。"
          }
        }
      }
    },
