    "Glad to help! Feel free to ask anything about your emails — search, analytics, security scans, or summaries." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gern geschehen! Fragen Sie mich alles zu Ihren E-Mails — Suche, Analysen, Sicherheitsprüfungen oder Zusammenfassungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Encantado de ayudar! Pregúntame lo que quieras sobre tus correos — búsqueda, analíticas, análisis de seguridad o resúmenes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ravi d'aider ! Posez-moi toute question sur vos e-mails — recherche, analyses, contrôles de sécurité ou résumés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मदद करके खुशी हुई! अपने ईमेल के बारे में कुछ भी पूछें — खोज, विश्लेषण, सुरक्षा स्कैन या सारांश।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felice di aiutare! Chiedimi qualsiasi cosa sulle tue email — ricerca, analisi, controlli di sicurezza o riepiloghi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お役に立ててうれしいです！検索、分析、セキュリティスキャン、要約など、メールについて何でもお尋ねください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도움이 되어 기쁩니다! 검색, 분석, 보안 검사, 요약 등 이메일에 관해 무엇이든 물어보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fico feliz em ajudar! Pergunte o que quiser sobre seus e-mails — busca, análises, verificações de segurança ou resumos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很高兴帮忙！关于你的邮件，搜索、分析、安全扫描或摘要，随便问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很高興幫忙！關於你的郵件，搜尋、分析、安全掃描或摘要，儘管問。"
          }
        }
      }
    },
