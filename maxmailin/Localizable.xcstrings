    "Runs actions over the whole archive in batches with progress, Cancel and resume after an interruption, using flat memory at any archive size." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt Aktionen über das gesamte Archiv in Stapeln aus, mit Fortschritt, Abbrechen und Fortsetzen nach einer Unterbrechung, bei gleichbleibendem Speicherbedarf in jeder Archivgröße."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta acciones sobre todo el archivo por lotes, con progreso, Cancelar y reanudación tras una interrupción, con memoria constante en cualquier tamaño de archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécute des actions sur toute l’archive par lots, avec progression, Annuler et reprise après une interruption, avec une mémoire constante quelle que soit la taille de l’archive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे आर्काइव पर कार्रवाइयाँ बैच में चलाता है, प्रगति, रद्द करें और रुकावट के बाद फिर से शुरू करने के साथ, किसी भी आकार के आर्काइव में स्थिर मेमोरी से।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegue azioni sull’intero archivio a lotti, con avanzamento, Annulla e ripresa dopo un’interruzione, con memoria costante a qualsiasi dimensione dell’archivio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブ全体に対する操作をバッチで実行します。進行状況、キャンセル、中断後の再開に対応し、アーカイブのサイズにかかわらずメモリ使用量は一定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 보관함에 대한 작업을 묶음으로 실행합니다. 진행률, 취소, 중단 후 재개를 지원하며 보관함 크기와 관계없이 메모리 사용량이 일정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa ações no arquivo inteiro em lotes, com progresso, Cancelar e retomada após uma interrupção, com memória constante em qualquer tamanho de arquivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以批次方式在整个归档上执行操作，支持进度显示、取消以及中断后继续，无论归档多大内存占用都保持稳定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以批次方式在整個封存上執行動作，支援進度顯示、取消以及中斷後繼續，無論封存多大記憶體用量都保持穩定。"
          }
        }
      }
    },
