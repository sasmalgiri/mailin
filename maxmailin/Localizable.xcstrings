    "Large filter — the first %lld emails were scanned. Narrow the filter to cover the rest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Großer Filter — die ersten %lld E-Mails wurden durchsucht. Grenzen Sie den Filter ein, um den Rest abzudecken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtro amplio — se analizaron los primeros %lld correos. Acota el filtro para cubrir el resto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtre large — les %lld premiers e-mails ont été analysés. Affinez le filtre pour couvrir le reste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बड़ा फ़िल्टर — पहले %lld ईमेल स्कैन किए गए। बाकी को कवर करने के लिए फ़िल्टर संकीर्ण करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtro ampio — sono state analizzate le prime %lld email. Restringi il filtro per coprire il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きなフィルタ — 最初の %lld 件のメールをスキャンしました。残りを対象にするにはフィルタを絞ってください。"
