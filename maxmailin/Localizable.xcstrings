    },
    "THE APP NEVER CONFIRMS A ROOT CAUSE — YOU DO, ON THE RECORD" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DIE APP BESTÄTIGT NIE EINE GRUNDURSACHE — DAS TUN SIE, AKTENKUNDIG"
