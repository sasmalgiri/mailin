    "Builds a fingerprint tree over every email so the whole archive can be verified in seconds and a changed email is pinpointed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baut einen Fingerabdruck-Baum über jede E-Mail auf, sodass das gesamte Archiv in Sekunden geprüft und eine geänderte E-Mail genau bestimmt werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un árbol de huellas sobre cada correo para verificar todo el archivo en segundos y localizar con precisión un correo modificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construit un arbre d’empreintes sur chaque e-mail pour vérifier toute l’archive en quelques secondes et localiser précisément un e-mail modifié."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर ईमेल पर फ़िंगरप्रिंट ट्री बनाता है ताकि पूरा आर्काइव सेकंडों में सत्यापित हो और बदला हुआ ईमेल ठीक-ठीक पहचाना जा सके।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un albero di impronte su ogni email, così l’intero archivio si verifica in pochi secondi e un’email modificata viene individuata con precisione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのメールに指紋ツリーを作成し、アーカイブ全体を数秒で検証して、変更されたメールを特定できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 이메일에 지문 트리를 만들어 전체 보관함을 몇 초 만에 검증하고 변경된 이메일을 정확히 찾아냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cria uma árvore de impressões digitais sobre cada e-mail para verificar o arquivo inteiro em segundos e localizar com precisão um e-mail alterado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每封邮件构建指纹树，可在数秒内验证整个归档并精确定位被更改的邮件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為每封郵件建立指紋樹，可在數秒內驗證整個封存並精確找出被變更的郵件。"
          }
        }
      }
    },
