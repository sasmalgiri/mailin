    "%lld of %lld messages will change on %@; %lld will not. The copies saved in mailin are kept." : {
      "comment" : "A description of the server cleanup process. The first argument is the number of messages that will be changed. The second argument is the total number of messages that will be affected. The third argument is the name of the email account. The fourth argument is the number of messages that will be excluded.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
