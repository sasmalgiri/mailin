    "Uses Apple Intelligence (FoundationModels) when available. All processing stays on your device. The same switch is the AI Insights page in Settings ▸ Modules." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzt Apple Intelligence (FoundationModels), wenn verfügbar. Alles wird auf Ihrem Gerät verarbeitet. Derselbe Schalter ist die Seite „AI Insights“ unter Einstellungen ▸ Module."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Apple Intelligence (FoundationModels) cuando está disponible. Todo se procesa en su dispositivo. El mismo interruptor es la página AI Insights en Ajustes ▸ Módulos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise Apple Intelligence (FoundationModels) si disponible. Tout est traité sur votre appareil. Le même interrupteur est la page AI Insights dans Réglages ▸ Modules."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपलब्ध होने पर Apple Intelligence (FoundationModels) का इस्तेमाल करता है। सारी प्रोसेसिंग आपके डिवाइस पर होती है। यही स्विच सेटिंग्स ▸ मॉड्यूल में AI Insights पेज है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Apple Intelligence (FoundationModels) quando disponibile. Tutto viene elaborato sul tuo dispositivo. Lo stesso interruttore è la pagina AI Insights in Impostazioni ▸ Moduli."
          }
        },
        "ja" : {
          "stringUnit" : {
