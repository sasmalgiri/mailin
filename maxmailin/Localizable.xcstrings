    "New imports are copied into the archive and checked byte for byte, so the archive stays complete when the original file is moved or deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Importe werden ins Archiv kopiert und Byte für Byte geprüft, sodass das Archiv vollständig bleibt, wenn die Originaldatei verschoben oder gelöscht wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las nuevas importaciones se copian en el archivo y se comprueban byte a byte, de modo que el archivo sigue completo si el original se mueve o elimina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles importations sont copiées dans l'archive et vérifiées octet par octet ; l'archive reste complète si le fichier d'origine est déplacé ou supprimé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए आयात संग्रह में कॉपी होकर बाइट-दर-बाइट जाँचे जाते हैं, ताकि मूल फ़ाइल हटने या स्थानांतरित होने पर भी संग्रह पूरा रहे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove importazioni vengono copiate nell'archivio e verificate byte per byte, così l'archivio resta completo se il file originale viene spostato o eliminato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい読み込みはアーカイブにコピーされバイト単位で検証されるため、元のファイルが移動・削除されてもアーカイブは完全なままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로 가져온 파일은 아카이브에 복사되어 바이트 단위로 검사되므로, 원본 파일이 이동되거나 삭제되어도 아카이브는 완전하게 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novas importações são copiadas para o arquivo e verificadas byte a byte, assim o arquivo permanece completo quando o original é movido ou excluído."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新导入的文件会被复制到归档中并逐字节校验，即使原始文件被移动或删除，归档仍保持完整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新匯入的檔案會被複製到封存中並逐位元組檢查，即使原始檔案被移動或刪除，封存仍保持完整。"
          }
        }
      }
    },
