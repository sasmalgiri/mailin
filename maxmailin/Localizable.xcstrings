    "Nothing is replaced or deleted. Preserve the account's mail again, then compare: both copies stay." : {
      "comment" : "Footer for the MailUpgradeInventoryView.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts wird ersetzt oder gelöscht. Bewahren Sie die Mails des Accounts erneut auf und vergleichen Sie dann: Beide Kopien bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se reemplaza ni se elimina nada. Vuelve a conservar el correo de la cuenta y compara: ambas copias se mantienen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est remplacé ni supprimé. Conservez à nouveau le courrier du compte, puis comparez : les deux copies restent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ भी बदला या हटाया नहीं जाता। खाते का मेल फिर से सुरक्षित रखें, फिर तुलना करें: दोनों प्रतियाँ बनी रहती हैं।"
