    "Actions here cover all %@ emails in scope (%@), not only the emails listed." : {
      "comment" : "A line that appears above a tool's 3.0 actions, explaining that the actions cover the whole scope. The first argument is the count of emails in the scope. The second argument is the scope description.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktionen hier betreffen alle %@ E-Mails im Umfang (%@), nicht nur die aufgelisteten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Actions here cover all %1$@ emails in scope (%2$@), not only the emails listed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las acciones aquí abarcan los %@ correos del alcance (%@), no solo los listados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les actions ici couvrent les %@ e-mails du périmètre (%@), pas seulement ceux listés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ की कार्रवाइयाँ दायरे के सभी %@ ईमेल (%@) पर लागू होती हैं, केवल सूचीबद्ध पर नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le azioni qui riguardano tutte le %@ email nell’ambito (%@), non solo quelle elencate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでの操作は、一覧にあるメールだけでなく、範囲内の %@ 件すべてのメール（%@）が対象です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기의 작업은 목록에 있는 이메일만이 아니라 범위의 이메일 %@개 전체(%@)에 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As ações aqui abrangem todos os %@ e-mails do escopo (%@), não só os listados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此处的操作涵盖范围内的全部 %@ 封邮件（%@），而不仅是列出的邮件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此處的動作涵蓋範圍內的全部 %@ 封郵件（%@），而不只是列出的郵件。"
          }
        }
      }
    },
    "Actions here cover every email in scope, not only the emails listed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktionen hier betreffen jede E-Mail im Umfang, nicht nur die aufgelisteten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las acciones aquí abarcan cada correo del alcance, no solo los listados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les actions ici couvrent chaque e-mail du périmètre, pas seulement ceux listés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ की कार्रवाइयाँ दायरे के हर ईमेल पर लागू होती हैं, केवल सूचीबद्ध पर नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le azioni qui riguardano ogni email nell’ambito, non solo quelle elencate."
          }
        },
        "ja" : {
          "stringUnit" : {
