    "Take in a mailbox as evidence and work it end to end — receive, hash, examine, analyze, report — with the chain of custody written for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Postfach als Beweis aufnehmen und von Anfang bis Ende bearbeiten — entgegennehmen, hashen, untersuchen, analysieren, berichten — mit automatisch geführter Chain of Custody."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibir un buzón como prueba y trabajarlo de principio a fin — recibir, calcular hash, examinar, analizar, informar — con la cadena de custodia redactada por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevoir une boîte aux lettres comme preuve et la traiter de bout en bout — réceptionner, hacher, examiner, analyser, rendre compte — avec la chaîne de possession rédigée pour vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेलबॉक्स को साक्ष्य के रूप में लें और शुरू से अंत तक काम करें — प्राप्त करें, हैश करें, जाँचें, विश्लेषण करें, रिपोर्ट करें — चेन ऑफ़ कस्टडी आपके लिए लिखी जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acquisire una casella come prova e lavorarla dall'inizio alla fine — ricevere, calcolare l'hash, esaminare, analizzare, riferire — con la catena di custodia scritta per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールボックスを証拠として受け入れ、最初から最後まで処理 — 受領、ハッシュ、調査、分析、報告 — 保管の連鎖は自動で記録されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사서함을 증거로 접수하고 처음부터 끝까지 처리 — 수령, 해시, 조사, 분석, 보고 — 관리 연속성은 자동으로 기록됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receber uma caixa de correio como evidência e trabalhá-la de ponta a ponta — receber, calcular hash, examinar, analisar, relatar — com a cadeia de custódia escrita para você."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将邮箱作为证据接收并从头到尾处理 — 接收、计算哈希、检查、分析、报告 — 保管链会自动为你记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將郵件信箱作為證據接收並從頭到尾處理 — 接收、計算雜湊、檢查、分析、報告 — 監管鏈會自動為你記錄。"
          }
        }
      }
    },
    "Tame the inbox — find newsletters and promos, unsubscribe, and clear out the old clutter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Posteingang zähmen — Newsletter und Werbung finden, abbestellen und alten Ballast ausräumen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domar la bandeja de entrada — encontrar boletines y promociones, darse de baja y limpiar el desorden antiguo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dompter la boîte de réception — repérer les lettres d'information et les promotions, se désabonner et faire le tri dans l'ancien."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनबॉक्स को व्यवस्थित करें — न्यूज़लेटर और प्रचार ढूँढें, सदस्यता रद्द करें और पुराना कबाड़ साफ़ करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domare la posta in arrivo — trovare newsletter e promozioni, annullare le iscrizioni e ripulire il vecchio disordine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受信箱を整理 — ニュースレターや宣伝を見つけ、配信を停止し、古い不要なメールを片付けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받은편지함 정리 — 뉴스레터와 광고를 찾고, 구독을 해지하고, 오래된 잡동사니를 치웁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domar a caixa de entrada — encontrar newsletters e promoções, cancelar inscrições e limpar a bagunça antiga."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整理收件箱 — 找出简报和推广邮件、退订，并清理旧的杂乱邮件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整理收件匣 — 找出電子報與促銷郵件、取消訂閱，並清理舊的雜亂郵件。"
          }
        }
      }
    },
