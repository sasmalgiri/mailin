      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Ausschalten werden alle E-Mail-Verbindungen beendet. Bereits gespeicherte E-Mails bleiben im Archiv."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desactivarlo se detienen todas las conexiones de correo. El correo ya guardado permanece en el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La désactivation interrompt toutes les connexions de messagerie. Le courrier déjà enregistré reste dans l'archive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे बंद करने से हर मेल कनेक्शन रुक जाता है। पहले से सहेजी गई मेल संग्रह में रहती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
