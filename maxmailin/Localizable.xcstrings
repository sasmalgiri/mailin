        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई सार्वजनिक कुंजी आयात नहीं की गई। हस्ताक्षर किसी अज्ञात कुंजी द्वारा किए गए के रूप में दिखाए जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
