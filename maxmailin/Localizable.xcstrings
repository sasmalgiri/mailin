        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alertas inteligentes, detección de anomalías y hallazgos en segundo plano sobre todo el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alertes intelligentes, détection d’anomalies et constats en arrière-plan sur toute l’archive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे आर्काइव पर स्मार्ट अलर्ट, असामान्यता पहचान और बैकग्राउंड निष्कर्ष।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvisi intelligenti, rilevamento di anomalie e risultati in background sull’intero archivio."
