          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の判断 %lld 件を統合しました: コード %lld、タグ %lld、メモ %lld を適用、%lld 件は変更なし、競合 %lld 件、このアーカイブにないメール %lld 件。"
