    "Turn open questions into a collection plan — hypotheses, the requests that would test them, priority order, and who authorised the scope." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offene Fragen in einen Sammelplan verwandeln — Hypothesen, die Anfragen, die sie prüfen würden, Prioritätsreihenfolge und wer den Umfang genehmigt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertir preguntas abiertas en un plan de recopilación — hipótesis, las solicitudes que las pondrían a prueba, orden de prioridad y quién autorizó el alcance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformer des questions ouvertes en plan de collecte — hypothèses, demandes qui les testeraient, ordre de priorité et personne ayant autorisé le périmètre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खुले प्रश्नों को संग्रह योजना में बदलें — परिकल्पनाएँ, उनकी जाँच करने वाले अनुरोध, प्राथमिकता क्रम और दायरे को किसने अधिकृत किया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasformare le domande aperte in un piano di raccolta — ipotesi, le richieste che le metterebbero alla prova, ordine di priorità e chi ha autorizzato l'ambito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未解決の問いを収集計画に — 仮説、それを検証する請求、優先順位、範囲を承認した人。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열린 질문을 수집 계획으로 — 가설, 이를 검증할 요청, 우선순위, 범위를 승인한 사람."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformar perguntas em aberto em um plano de coleta — hipóteses, as solicitações que as testariam, ordem de prioridade e quem autorizou o escopo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将未解决的问题转为收集计划 — 假设、可检验它们的请求、优先顺序，以及谁批准了范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將未解決的問題轉為收集計畫 — 假設、可檢驗它們的請求、優先順序，以及誰核准了範圍。"
          }
        }
      }
    },
    "Turn tagged evidence into a court-ready package — select, redact, Bates-stamp, and export with a cover report." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markierte Beweise in ein gerichtsfertiges Paket verwandeln — auswählen, schwärzen, Bates-stempeln und mit einem Deckblattbericht exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertir las pruebas etiquetadas en un paquete listo para el tribunal — seleccionar, censurar, estampar Bates y exportar con un informe de portada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformer des preuves marquées en dossier prêt pour le tribunal — sélectionner, caviarder, estampiller Bates et exporter avec un rapport de couverture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टैग किए गए साक्ष्य को अदालत के लिए तैयार पैकेज में बदलें — चुनें, छिपाएँ, Bates-मुहर लगाएँ और कवर रिपोर्ट के साथ निर्यात करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasformare le prove contrassegnate in un pacchetto pronto per il tribunale — selezionare, oscurare, timbrare Bates ed esportare con un rapporto di copertina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タグ付けした証拠を法廷提出用パッケージに — 選択、墨消し、ベイツ番号付与を行い、表紙レポート付きで書き出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "태그된 증거를 법원 제출용 패키지로 — 선택, 가림, 베이츠 스탬프를 하고 표지 보고서와 함께 내보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformar evidências marcadas em um pacote pronto para o tribunal — selecionar, ocultar, carimbar Bates e exportar com um relatório de capa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
