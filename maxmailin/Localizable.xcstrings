    "Drag and drop .mbox, .eml, .msg, or .pst files to get started. All processing happens on-device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie .mbox-, .eml-, .msg- oder .pst-Dateien hierher, um zu beginnen. Die gesamte Verarbeitung erfolgt auf dem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra y suelta archivos .mbox, .eml, .msg o .pst para empezar. Todo el procesamiento ocurre en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez-déposez des fichiers .mbox, .eml, .msg ou .pst pour commencer. Tout le traitement se fait sur l'appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरू करने के लिए .mbox, .eml, .msg या .pst फ़ाइलें खींचकर छोड़ें। सारी प्रोसेसिंग डिवाइस पर होती है।"
          }
        },
        "it" : {
          "stringUnit" : {
