    },
    "Locked — %@. You can read and fill this now; it finalizes once the earlier step is done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesperrt — %@. Sie können dies jetzt lesen und ausfüllen; es wird abgeschlossen, sobald der frühere Schritt erledigt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueado — %@. Puedes leerlo y rellenarlo ahora; se finaliza cuando se complete el paso anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouillé — %@. Vous pouvez le lire et le remplir maintenant ; il sera finalisé une fois l'étape précédente terminée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉक — %@। इसे आप अभी पढ़ और भर सकते हैं; पिछला चरण पूरा होने पर यह अंतिम रूप लेता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloccato — %@. Puoi leggerlo e compilarlo ora; verrà finalizzato quando il passaggio precedente sarà completato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック中 — %@。今読んで入力できます。前のステップが完了すると確定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠김 — %@. 지금 읽고 입력할 수 있으며, 이전 단계가 완료되면 확정됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueado — %@. Você pode ler e preencher agora; será finalizado quando a etapa anterior for concluída."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已锁定——%@。您现在可以阅读并填写；前一步完成后将最终确定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已鎖定——%@。您現在可以閱讀並填寫；前一步完成後將最終確定。"
          }
        }
      }
