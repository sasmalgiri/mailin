    "Hashes of files inside attached messages: %@ rows checked, %@ repaired, %@ unverifiable, last on %@.%@" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hashes der Dateien in angehängten Nachrichten: %1$@ Zeilen geprüft, %2$@ repariert, %3$@ nicht überprüfbar, zuletzt am %4$@.%5$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hashes de los archivos dentro de mensajes adjuntos: %1$@ filas comprobadas, %2$@ reparadas, %3$@ no verificables, por última vez el %4$@.%5$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hachages des fichiers dans les messages joints : %1$@ lignes vérifiées, %2$@ réparées, %3$@ invérifiables, pour la dernière fois le %4$@.%5$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संलग्न संदेशों के अंदर की फ़ाइलों के हैश: %1$@ पंक्तियाँ जाँची गईं, %2$@ सुधारी गईं, %3$@ सत्यापन योग्य नहीं, अंतिम बार %4$@ को।%5$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hash dei file dentro i messaggi allegati: %1$@ righe controllate, %2$@ riparate, %3$@ non verificabili, l'ultima volta il %4$@.%5$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添付メッセージ内のファイルのハッシュ：%1$@ 行を確認、%2$@ 行を修復、%3$@ 行は検証不能、最終 %4$@。%5$@"
