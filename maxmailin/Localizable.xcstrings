    "No public keys imported. Signatures are listed as made by an unknown key." : {
      "comment" : "A message displayed when the user has not imported any OpenPGP public keys.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine öffentlichen Schlüssel importiert. Signaturen werden als von einem unbekannten Schlüssel stammend aufgeführt."
