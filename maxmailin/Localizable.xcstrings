    "New reported emails won't auto-import until you resume watching." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu gemeldete E-Mails werden erst wieder automatisch importiert, wenn Sie die Überwachung fortsetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nuevos correos reportados no se importarán automáticamente hasta que reanudes la vigilancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux e-mails signalés ne seront pas importés automatiquement tant que vous ne reprenez pas la surveillance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब तक आप निगरानी फिर शुरू नहीं करते, नए रिपोर्ट किए गए ईमेल स्वतः आयात नहीं होंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
