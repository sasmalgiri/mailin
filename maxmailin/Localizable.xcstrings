    "Put a legal hold in place and prove it: identify custodians, issue the notice, track acknowledgements, preserve the data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Aufbewahrungspflicht (Legal Hold) einrichten und nachweisen: Verwahrer identifizieren, die Mitteilung versenden, Bestätigungen verfolgen, die Daten sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establecer una retención legal y demostrarla: identificar custodios, emitir el aviso, seguir los acuses de recibo, preservar los datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre en place une conservation légale et le prouver : identifier les dépositaires, émettre l'avis, suivre les accusés de réception, préserver les données."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लीगल होल्ड लागू करें और सिद्ध करें: संरक्षकों की पहचान करें, सूचना जारी करें, स्वीकृतियाँ ट्रैक करें, डेटा सुरक्षित रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivare un legal hold e dimostrarlo: identificare i custodi, emettere l'avviso, tracciare le conferme, preservare i dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リーガルホールドを設定して証明: カストディアンを特定し、通知を出し、受領確認を追跡し、データを保全します。"
          }
        },
