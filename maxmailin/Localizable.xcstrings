    "Shrink the evidence set defensibly — drop exact and near-duplicates and out-of-range dates, then record the cull." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Beweisbestand belastbar verkleinern — exakte und Fast-Duplikate sowie Daten außerhalb des Zeitraums entfernen und die Aussonderung festhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reducir el conjunto de pruebas de forma defendible — eliminar duplicados exactos y cercanos y fechas fuera de rango, y registrar la depuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduire l'ensemble de preuves de façon défendable — écarter les doublons exacts et proches et les dates hors période, puis consigner l'élagage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साक्ष्य सेट को ठोस तरीके से छोटा करें — सटीक और निकट डुप्लिकेट तथा सीमा से बाहर की तिथियाँ हटाएँ, फिर छँटाई दर्ज करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ridurre l'insieme di prove in modo difendibile — eliminare duplicati esatti e simili e date fuori intervallo, poi registrare la scrematura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "証拠セットを説得力のある方法で縮小 — 完全重複・類似重複・範囲外の日付を除き、選別内容を記録します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
