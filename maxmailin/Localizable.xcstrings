    "Reads a sample of up to %lld differing messages per side — the counts above are whole-archive; the narrative is from the sample." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest eine Stichprobe von bis zu %lld abweichenden Nachrichten je Seite — die Zahlen oben gelten für das gesamte Archiv; die Erzählung stammt aus der Stichprobe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee una muestra de hasta %lld mensajes distintos por lado — los recuentos de arriba son de todo el archivo; la narrativa procede de la muestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit un échantillon d'au plus %lld messages différents par côté — les décomptes ci-dessus portent sur toute l'archive ; le récit provient de l'échantillon."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रति पक्ष अधिकतम %lld भिन्न संदेशों का नमूना पढ़ता है — ऊपर की गिनती पूरे संग्रह की है; विवरण नमूने से है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge un campione di massimo %lld messaggi diversi per lato — i conteggi sopra riguardano l'intero archivio; la narrazione proviene dal campione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片側あたり最大 %lld 件の相違メッセージのサンプルを読み取ります — 上の件数はアーカイブ全体、説明文はサンプルに基づきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "양쪽에서 최대 %lld개의 서로 다른 메시지 샘플을 읽습니다 — 위의 개수는 전체 보관함 기준이며, 설명은 샘플에서 나옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê uma amostra de até %lld mensagens divergentes por lado — as contagens acima são de todo o arquivo; a narrativa vem da amostra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每侧读取最多 %lld 封不同邮件的样本——上方数量为全归档统计；叙述来自样本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每側讀取最多 %lld 封不同郵件的樣本——上方數量為全封存統計；敘述來自樣本。"
          }
        }
      }
    },
    "Reads an attachment or an export straight from its byte range in the stored source, instead of re-parsing the whole message." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest einen Anhang oder einen Export direkt aus seinem Byte-Bereich in der gespeicherten Quelle, statt die ganze Nachricht erneut zu parsen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee un adjunto o una exportación directamente desde su rango de bytes en la fuente almacenada, en lugar de reanalizar todo el mensaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit une pièce jointe ou un export directement depuis sa plage d'octets dans la source stockée, au lieu de ré-analyser tout le message."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे संदेश को फिर पार्स करने के बजाय संग्रहीत स्रोत में उसकी बाइट रेंज से सीधे अटैचमेंट या निर्यात पढ़ता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge un allegato o un'esportazione direttamente dal suo intervallo di byte nella sorgente archiviata, invece di rianalizzare l'intero messaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージ全体を再解析する代わりに、保存済みソース内のバイト範囲から添付ファイルや書き出しを直接読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지 전체를 다시 파싱하는 대신 저장된 소스의 바이트 범위에서 첨부 파일이나 내보내기를 직접 읽습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê um anexo ou uma exportação diretamente do seu intervalo de bytes na fonte armazenada, em vez de reanalisar a mensagem inteira."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接从存储源的字节范围读取附件或导出内容，而不是重新解析整封邮件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接從儲存來源的位元組範圍讀取附件或匯出內容，而不是重新解析整封訊息。"
          }
        }
      }
    },
    "Ready to Scan" : {
      "localizations" : {
        "de" : {
