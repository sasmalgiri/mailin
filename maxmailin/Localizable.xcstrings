    "Re-read your original .mbox files and restore full detail (attachments, raw source) to already-imported emails — nothing is duplicated" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Original-.mbox-Dateien erneut lesen und bereits importierte E-Mails um volle Details (Anhänge, Rohquelle) ergänzen — nichts wird dupliziert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a leer tus archivos .mbox originales y restaura todo el detalle (adjuntos, fuente sin procesar) de los correos ya importados — nada se duplica"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relire vos fichiers .mbox d'origine et restaurer tous les détails (pièces jointes, source brute) des e-mails déjà importés — rien n'est dupliqué"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी मूल .mbox फ़ाइलें फिर पढ़ें और पहले से आयातित ईमेल में पूरा विवरण (अनुलग्नक, कच्चा स्रोत) पुनर्स्थापित करें — कुछ भी डुप्लिकेट नहीं होता"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rileggi i tuoi file .mbox originali e ripristina il dettaglio completo (allegati, sorgente grezza) delle email già importate — nulla viene duplicato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元の .mbox ファイルを読み直し、読み込み済みメールの完全な詳細（添付、生ソース）を復元 — 重複は作られません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 .mbox 파일을 다시 읽어 이미 가져온 이메일에 전체 세부 정보(첨부 파일, 원본 소스)를 복원 — 아무것도 중복되지 않습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reler seus arquivos .mbox originais e restaurar todos os detalhes (anexos, fonte bruta) dos e-mails já importados — nada é duplicado"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新读取您的原始 .mbox 文件，为已导入的邮件恢复完整细节（附件、原始源）——不会产生重复"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新讀取您的原始 .mbox 檔案，為已匯入的郵件回復完整細節（附件、原始來源）——不會產生重複"
          }
        }
      }
