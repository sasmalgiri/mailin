          }
        }
      }
    },
    "Microsoft's limit for one send request. A message that is larger once encoded is not sent; the outbox says why." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Limit von Microsoft für eine Sendeanfrage. Eine Nachricht, die nach der Codierung größer ist, wird nicht gesendet; der Postausgang nennt den Grund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El límite de Microsoft para una solicitud de envío. Un mensaje que una vez codificado es mayor no se envía; la bandeja de salida indica el motivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite de Microsoft pour une requête d'envoi. Un message plus grand une fois encodé n'est pas envoyé ; la boîte d'envoi en indique la raison."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक भेजने के अनुरोध के लिए Microsoft की सीमा। जो संदेश एन्कोड होने के बाद इससे बड़ा हो, वह नहीं भेजा जाता; आउटबॉक्स कारण बताता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il limite di Microsoft per una richiesta di invio. Un messaggio più grande una volta codificato non viene inviato; la posta in uscita ne indica il motivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 回の送信リクエストに対する Microsoft の上限です。エンコード後にこれより大きくなるメッセージは送信されず、送信トレイに理由が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전송 요청 하나에 대한 Microsoft의 한도입니다. 인코딩 후 더 커지는 메시지는 전송되지 않으며 보낼 편지함에 그 이유가 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O limite da Microsoft para uma solicitação de envio. Uma mensagem que fica maior depois de codificada não é enviada; a caixa de saída informa o motivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft 对单个发送请求的限制。编码后更大的邮件不会被发送；发件箱会说明原因。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft 對單一傳送要求的限制。編碼後更大的郵件不會被傳送；寄件匣會說明原因。"
          }
        }
      }
    },
