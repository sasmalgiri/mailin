    "^[%lld copy](inflect: true) kept — under legal hold. The rest were moved to the Trash." : {
      "comment" : "A warning that some copies were kept because they're under legal hold. The argument is the number of copies kept.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%lld Kopie](inflect: true) behalten – unter Legal Hold. Die übrigen wurden in den Papierkorb verschoben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%lld copia conservada](inflect: true) por retención legal. El resto se movió a la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%lld copie conservée](inflect: true) — sous conservation légale. Les autres ont été déplacées vers la Corbeille."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld प्रतियाँ रखी गईं — कानूनी होल्ड के अधीन। बाकी ट्रैश में ले जाई गईं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%lld copia conservata](inflect: true): sotto conservazione legale. Le altre sono state spostate nel Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件のコピーを保持しました（リーガルホールド中）。残りはゴミ箱へ移動しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사본 %lld개 유지 — 법적 보존 중. 나머지는 휴지통으로 이동했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%lld cópia mantida](inflect: true) — sob retenção legal. As demais foram movidas para o Lixo."
