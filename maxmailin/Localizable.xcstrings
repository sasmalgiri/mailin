        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "format d'archive non ouvert — les fichiers dans les pièces jointes ZIP sont lus, les autres formats d'archive sont conservés tels quels"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संग्रह प्रारूप नहीं खोला गया — ZIP अनुलग्नकों के अंदर की फ़ाइलें पढ़ी जाती हैं, अन्य संग्रह प्रारूप फ़ाइलों के रूप में रखे जाते हैं"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "formato di archivio non aperto: i file dentro gli allegati ZIP vengono letti, gli altri formati di archivio restano come file"
