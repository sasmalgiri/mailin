    "%@ was issued but its contents couldn't be read back. Open it in Documents to check." : {
      "comment" : "A message that appears when the report's contents couldn't be read back from the database. The argument is the report number.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde vergeben, aber der Inhalt konnte nicht zurückgelesen werden. Prüfen Sie ihn unter „Dokumente“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se emitió %@, pero su contenido no se pudo volver a leer. Ábralo en Documentos para comprobarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été émis, mais son contenu n’a pas pu être relu. Ouvrez-le dans Documents pour vérifier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ जारी किया गया, लेकिन उसकी सामग्री दोबारा पढ़ी नहीं जा सकी। जाँचने के लिए इसे दस्तावेज़ में खोलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato emesso, ma non è stato possibile rileggerne il contenuto. Aprilo in Documenti per verificare."
