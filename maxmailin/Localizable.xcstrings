            "value" : "Tagga %lld email selezionate con il nome del tag inserito"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した %lld 件のメールに入力したタグ名を付けます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 이메일 %lld개에 입력한 태그 이름을 지정합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiqueta %lld e-mails selecionados com o nome de etiqueta inserido"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用输入的标签名称标记 %lld 封所选邮件"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
