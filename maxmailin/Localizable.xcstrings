    "Predict response urgency, thread outcomes, and security risks across your %lld emails." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antwortdringlichkeit, Thread-Ergebnisse und Sicherheitsrisiken über Ihre %lld E-Mails vorhersagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predice la urgencia de respuesta, el desenlace de los hilos y los riesgos de seguridad en tus %lld correos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prédisez l'urgence des réponses, l'issue des fils et les risques de sécurité sur vos %lld e-mails."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने %lld ईमेल में उत्तर की तात्कालिकता, थ्रेड परिणाम और सुरक्षा जोखिमों का पूर्वानुमान लगाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevedi l'urgenza di risposta, l'esito delle conversazioni e i rischi di sicurezza sulle tue %lld email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件のメールについて、返信の緊急度、スレッドの結果、セキュリティリスクを予測します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일 %lld개에 걸쳐 응답 긴급도, 스레드 결과, 보안 위험을 예측하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preveja a urgência de resposta, os desfechos de conversas e os riscos de segurança em seus %lld e-mails."
