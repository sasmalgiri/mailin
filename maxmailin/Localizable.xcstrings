    "Replying to an old archive never sends as its former owner: choose one of your connected addresses." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Antwort auf ein altes Archiv wird nie im Namen des früheren Besitzers gesendet: Wählen Sie eine Ihrer verbundenen Adressen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responder a un archivo antiguo nunca envía como su antiguo propietario: elija una de sus direcciones conectadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondre à une ancienne archive n'envoie jamais au nom de son ancien propriétaire : choisissez l'une de vos adresses connectées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी पुराने संग्रह का जवाब कभी उसके पूर्व स्वामी के नाम से नहीं भेजा जाता: अपने जुड़े हुए पतों में से एक चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondere a un vecchio archivio non invia mai a nome del suo precedente proprietario: scegli uno dei tuoi indirizzi collegati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いアーカイブへの返信が以前の所有者として送信されることはありません。接続済みのアドレスから選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오래된 보관함에 답장해도 이전 소유자 이름으로 보내지지 않습니다. 연결된 주소 중 하나를 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responder a um arquivo antigo nunca envia como o antigo proprietário: escolha um dos seus endereços conectados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回复旧归档时绝不会以其原所有者身份发送：请选择你已连接的一个地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回覆舊封存時絕不會以其原擁有者身分傳送：請選擇你已連接的一個地址。"
          }
        }
      }
    },
