    "%@" : {
      "shouldTranslate" : false
    },
    "%@\n\nA separate window opens for this. Do the work there, then come back and fill this step's fields — it saves automatically%@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nDafür öffnet sich ein eigenes Fenster. Erledigen Sie die Arbeit dort, kommen Sie dann zurück und füllen Sie die Felder dieses Schritts aus – er wird automatisch gesichert%2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@\n\nA separate window opens for this. Do the work there, then come back and fill this step's fields — it saves automatically%2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nPara esto se abre una ventana aparte. Haz el trabajo allí, vuelve y completa los campos de este paso; se guarda automáticamente%2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nUne fenêtre séparée s'ouvre pour cela. Faites le travail là-bas, puis revenez remplir les champs de cette étape — elle s'enregistre automatiquement%2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nइसके लिए एक अलग विंडो खुलती है। वहाँ काम करें, फिर वापस आकर इस चरण के फ़ील्ड भरें — यह अपने आप सहेजा जाता है%2$@।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nPer questo si apre una finestra separata. Fai il lavoro lì, poi torna e compila i campi di questo passaggio: viene salvato automaticamente%2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nこの作業用に別ウインドウが開きます。そこで作業してから戻り、このステップの項目を入力してください。自動的に保存されます%2$@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\n이 작업을 위해 별도의 윈도우가 열립니다. 거기서 작업한 뒤 돌아와 이 단계의 항목을 채우세요. 자동으로 저장됩니다%2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nUma janela separada será aberta para isso. Faça o trabalho lá, depois volte e preencha os campos desta etapa — ela é salva automaticamente%2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\n此操作将打开单独的窗口。请在那里完成工作，然后回来填写此步骤的字段——它会自动保存%2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\n此操作會另外開啟一個視窗。請在那裡完成工作，然後回來填寫此步驟的欄位——它會自動儲存%2$@。"
          }
        }
      }
    },
