    "Merged %@'s %lld decisions: %lld codes, %lld tags and %lld notes applied; %lld unchanged; %lld conflicts; %lld emails not in this archive." : {
      "comment" : "A message indicating the number of decisions, codes, tags, and notes applied, as well as the number of unchanged emails, conflicts, and emails not in the archive. The first argument is the name of the reviewer who performed the merge. The second argument is the number of decisions merged. The third argument is the number of codes applied. The fourth argument is the number of tags added. The fifth argument is the number of notes added. The sixth argument is the number of unchanged emails. The seventh argument is the number of conflicts found. The eighth argument is the number of emails not found in the archive.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld Entscheidungen von %1$@ zusammengeführt: %3$lld Codes, %4$lld Tags und %5$lld Notizen übernommen; %6$lld unverändert; %7$lld Konflikte; %8$lld E-Mails nicht in diesem Archiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Merged %1$@'s %2$lld decisions: %3$lld codes, %4$lld tags and %5$lld notes applied; %6$lld unchanged; %7$lld conflicts; %8$lld emails not in this archive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se combinaron las %2$lld decisiones de %1$@: %3$lld códigos, %4$lld etiquetas y %5$lld notas aplicados; %6$lld sin cambios; %7$lld conflictos; %8$lld correos que no están en este archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld décisions de %1$@ fusionnées : %3$lld codes, %4$lld tags et %5$lld notes appliqués ; %6$lld inchangés ; %7$lld conflits ; %8$lld e-mails absents de cette archive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के %lld निर्णय मर्ज किए: %lld कोड, %lld टैग और %lld नोट लागू; %lld अपरिवर्तित; %lld टकराव; %lld ईमेल इस आर्काइव में नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
