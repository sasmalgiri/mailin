    "Run a background scan to detect anomalies, phishing, PII exposure, and sentiment shifts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Hintergrundscan ausführen, um Anomalien, Phishing, Offenlegung personenbezogener Daten und Stimmungswechsel zu erkennen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta un escaneo en segundo plano para detectar anomalías, phishing, exposición de PII y cambios de sentimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez une analyse en arrière-plan pour détecter anomalies, hameçonnage, exposition de données personnelles et variations de sentiment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विसंगतियों, फ़िशिंग, PII उजागर होने और भावना बदलाव का पता लगाने के लिए पृष्ठभूमि स्कैन चलाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui una scansione in background per rilevare anomalie, phishing, esposizione di PII e variazioni del sentiment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドスキャンを実行して、異常、フィッシング、個人情報の露出、感情の変化を検出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 스캔을 실행하여 이상 징후, 피싱, 개인정보 노출, 감정 변화를 감지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Execute uma varredura em segundo plano para detectar anomalias, phishing, exposição de PII e mudanças de sentimento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行后台扫描以检测异常、钓鱼、个人信息泄露和情绪变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行背景掃描以偵測異常、網路釣魚、個人資料外洩和情緒變化。"
          }
        }
      }
    },
    "Run a document production the defensible way — review, privilege-log, Bates, produce — with the privilege gate enforced before you release." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Dokumentenproduktion belastbar durchführen — prüfen, Privilegienprotokoll, Bates, produzieren — mit erzwungener Privilegiensperre vor der Freigabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecutar una producción de documentos de forma defendible — revisar, registro de privilegio, Bates, producir — con la barrera de privilegio aplicada antes de entregar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mener une production de documents de façon défendable — revoir, journal de privilège, Bates, produire — avec le filtre de privilège appliqué avant toute remise."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
