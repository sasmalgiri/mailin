          }
        }
      }
    },
    "Similar, not identical: ^[%lld group](inflect: true) to review below. Similar copies are never removed in bulk; tick one only after comparing." : {
      "comment" : "Plural-correct text through Foundation's automatic grammar agreement (`^[1 group](inflect: true)` → \"1 group\", `^[2 group](inflect: true)` → \"",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ähnlich, nicht identisch: ^[%lld Gruppe](inflect: true) unten zum Prüfen. Ähnliche Kopien werden nie massenhaft entfernt; haken Sie eine erst nach dem Vergleichen an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Similares, no idénticos: ^[%lld grupo](inflect: true) para revisar abajo. Las copias similares nunca se eliminan en bloque; marca una solo después de compararla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Similaires, non identiques : ^[%lld groupe](inflect: true) à examiner ci-dessous. Les copies similaires ne sont jamais supprimées en bloc ; cochez-en une seulement après comparaison."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिलते-जुलते, पर समान नहीं: नीचे देखने के लिए %lld समूह। मिलती-जुलती प्रतियाँ कभी थोक में नहीं हटाई जातीं; तुलना करने के बाद ही किसी पर निशान लगाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simili, non identici: ^[%lld gruppo](inflect: true) da esaminare qui sotto. Le copie simili non vengono mai rimosse in blocco; spuntane una solo dopo il confronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "類似しているが同一ではない：下で確認する %lld グループ。類似コピーが一括で削除されることはありません。比較してからチェックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유사하지만 동일하지 않음: 아래에서 검토할 그룹 %lld개. 유사 사본은 일괄 제거되지 않습니다. 비교한 후에만 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semelhantes, não idênticos: ^[%lld grupo](inflect: true) para revisar abaixo. Cópias semelhantes nunca são removidas em massa; marque uma só depois de comparar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相似但不相同：下方有 %lld 组待查看。相似副本永远不会被批量删除；请比较后再勾选。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相似但不相同：下方有 %lld 組待查看。相似副本永遠不會被批次移除；請比較後再勾選。"
          }
        }
      }
    },
    "Similarity detection" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ähnlichkeitserkennung"
          }
