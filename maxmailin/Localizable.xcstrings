    "Similar messages were not looked for. Turn on “Include near-duplicates” to check for them." : {
      "comment" : "Text displayed in the detail label of the Duplicate Summary screen when no identical copies were found, and when the near-duplicate search was not checked.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach ähnlichen Nachrichten wurde nicht gesucht. Schalten Sie „Beinahe-Duplikate einschließen“ ein, um sie zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se buscaron mensajes similares. Activa «Incluir casi duplicados» para comprobarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages similaires n’ont pas été recherchés. Activez « Inclure les quasi-doublons » pour les vérifier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिलते-जुलते संदेश नहीं खोजे गए। उन्हें जाँचने के लिए “निकट-डुप्लिकेट शामिल करें” चालू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi simili non sono stati cercati. Attiva “Includi quasi-duplicati” per controllarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "類似メッセージは検索していません。確認するには「類似重複を含める」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유사한 메시지는 찾지 않았습니다. 확인하려면 ‘유사 중복 포함’을 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensagens semelhantes não foram procuradas. Ative “Incluir quase duplicatas” para verificá-las."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未查找相似邮件。要检查，请打开“包括近似重复项”。"
