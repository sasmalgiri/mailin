    "A single message over 100 MB will be reported as damaged and skipped. Switching on “Offset parser” in Settings ▸ Features archives those messages instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine einzelne Nachricht über 100 MB wird als beschädigt gemeldet und übersprungen. Wenn Sie den „Offset-Parser“ unter Einstellungen ▸ Funktionen einschalten, werden diese Nachrichten stattdessen archiviert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mensaje de más de 100 MB se marcará como dañado y se omitirá. Si activas «Analizador por desplazamiento» en Ajustes ▸ Funciones, esos mensajes se archivan en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un message de plus de 100 Mo sera signalé comme endommagé et ignoré. Activer « Analyseur par décalage » dans Réglages ▸ Fonctionnalités archive ces messages à la place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 MB से बड़ा कोई एक संदेश क्षतिग्रस्त बताकर छोड़ दिया जाएगा। सेटिंग्स ▸ सुविधाएँ में “ऑफ़सेट पार्सर” चालू करने पर ऐसे संदेश संग्रहीत हो जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un singolo messaggio oltre 100 MB verrà segnalato come danneggiato e ignorato. Attivando «Parser a offset» in Impostazioni ▸ Funzioni, quei messaggi vengono invece archiviati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 MB を超える単一のメッセージは破損として報告され、スキップされます。設定 ▸ 機能 で「オフセットパーサ」をオンにすると、代わりにそれらのメッセージがアーカイブされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100MB를 초과하는 단일 메시지는 손상된 것으로 보고되고 건너뜁니다. 설정 ▸ 기능에서 “오프셋 파서”를 켜면 해당 메시지가 대신 보관됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma única mensagem acima de 100 MB será reportada como danificada e ignorada. Ativar “Analisador por deslocamento” em Ajustes ▸ Recursos arquiva essas mensagens em vez disso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过 100 MB 的单封邮件将被报告为已损坏并跳过。在“设置 ▸ 功能”中开启“偏移解析器”可改为归档这些邮件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過 100 MB 的單封郵件會被回報為已損毀並略過。在「設定 ▸ 功能」中開啟「偏移解析器」可改為封存這些郵件。"
          }
        }
