          }
        }
      }
    },
    "Round %lld kept everything already read of %@; %lld files inside need the password again. Use Unlock… to read them." : {
      "comment" : "The resume button is not shown.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runde %1$lld hat alles bereits Gelesene von %2$@ behalten; %3$lld enthaltene Dateien brauchen das Passwort erneut. Verwenden Sie „Entsperren …“, um sie zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Round %1$lld kept everything already read of %2$@; %3$lld files inside need the password again. Use Unlock… to read them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ronda %1$lld conservó todo lo ya leído de %2$@; %3$lld archivos internos necesitan de nuevo la contraseña. Usa «Desbloquear…» para leerlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cycle %1$lld a conservé tout ce qui avait déjà été lu de %2$@ ; %3$lld fichiers internes demandent à nouveau le mot de passe. Utilisez « Déverrouiller… » pour les lire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "राउंड %1$lld ने %2$@ का पहले से पढ़ा सब कुछ रखा; अंदर की %3$lld फ़ाइलों को फिर से पासवर्ड चाहिए। उन्हें पढ़ने के लिए “अनलॉक करें…” का उपयोग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ciclo %1$lld ha conservato tutto ciò che era già stato letto di %2$@; %3$lld file interni richiedono di nuovo la password. Usa “Sblocca…” per leggerli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ラウンド %1$lld では %2$@ の読み取り済みの内容をすべて保持しました。内部の %3$lld 個のファイルで再びパスワードが必要です。読み取るには「ロック解除…」を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld회차에서 %2$@의 이미 읽은 내용을 모두 유지했습니다. 내부 파일 %3$lld개에 암호가 다시 필요합니다. 읽으려면 ‘잠금 해제…’를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rodada %1$lld manteve tudo o que já foi lido de %2$@; %3$lld arquivos internos precisam da senha novamente. Use “Desbloquear…” para lê-los."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 %1$lld 轮保留了 %2$@ 中已读取的全部内容；其中 %3$lld 个文件需要再次输入密码。请使用“解锁…”读取它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 %1$lld 輪保留了 %2$@ 中已讀取的全部內容；其中 %3$lld 個檔案需要再次輸入密碼。請使用「解鎖…」讀取它們。"
          }
        }
      }
    },
    "Round up receipts and records — search, select, collect attachments, and export them in one go." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belege und Unterlagen zusammentragen — suchen, auswählen, Anhänge sammeln und in einem Zug exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reunir recibos y registros — buscar, seleccionar, recopilar adjuntos y exportarlos de una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rassembler reçus et justificatifs — rechercher, sélectionner, collecter les pièces jointes et tout exporter d'un coup."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रसीदें और रिकॉर्ड एकत्र करें — खोजें, चुनें, अटैचमेंट एकत्र करें और एक बार में निर्यात करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccogliere ricevute e documenti — cercare, selezionare, raccogliere gli allegati ed esportarli in un colpo solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "領収書や記録をまとめて収集 — 検索、選択、添付ファイルの収集を行い、一度に書き出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영수증과 기록 모으기 — 검색하고, 선택하고, 첨부 파일을 모아 한 번에 내보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reunir recibos e registros — buscar, selecionar, coletar anexos e exportá-los de uma vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汇集收据和记录 — 搜索、选择、收集附件并一次性导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彙集收據與紀錄 — 搜尋、選取、收集附件並一次匯出。"
          }
        }
      }
    },
    "Round up your key contacts — analyze who you talk to, spot the patterns, pick the keepers, and export them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre wichtigsten Kontakte zusammentragen — analysieren, mit wem Sie sprechen, Muster erkennen, die Wichtigen auswählen und exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reunir tus contactos clave — analizar con quién hablas, detectar patrones, elegir los importantes y exportarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rassembler vos contacts clés — analyser avec qui vous échangez, repérer les schémas, choisir ceux à garder et les exporter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने प्रमुख संपर्क एकत्र करें — विश्लेषण करें कि आप किससे बात करते हैं, पैटर्न पहचानें, रखने लायक चुनें और निर्यात करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccogliere i tuoi contatti chiave — analizzare con chi parli, individuare gli schemi, scegliere quelli da tenere ed esportarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主要な連絡先をまとめる — やり取りの相手を分析し、傾向を見つけ、残す相手を選んで書き出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주요 연락처 모으기 — 대화 상대를 분석하고, 패턴을 찾고, 남길 사람을 골라 내보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reunir seus contatos principais — analisar com quem você fala, identificar padrões, escolher os importantes e exportá-los."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汇总你的主要联系人 — 分析与你沟通的人、发现模式、挑选要保留的人并导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彙整你的主要聯絡人 — 分析與你往來的人、找出模式、挑選要保留的人並匯出。"
          }
        }
      }
    },
