    "mailin stopped before this export finished (it quit, crashed or the device restarted)." : {
      "comment" : "Error message when a recoverable export is interrupted.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin wurde vor dem Ende dieses Exports beendet (beendet, abgestürzt oder das Gerät wurde neu gestartet)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin se detuvo antes de terminar esta exportación (se cerró, falló o el dispositivo se reinició)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin s’est arrêté avant la fin de cet export (fermeture, plantage ou redémarrage de l’appareil)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह निर्यात पूरा होने से पहले mailin रुक गया (बंद हुआ, क्रैश हुआ या डिवाइस पुनः आरंभ हुआ)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin si è fermato prima della fine di questa esportazione (è stato chiuso, si è arrestato o il dispositivo si è riavviato)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この書き出しが終わる前に mailin が停止しました（終了、クラッシュ、またはデバイスの再起動）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 내보내기가 끝나기 전에 mailin이 멈췄습니다(종료, 충돌 또는 기기 재시동)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mailin parou antes de terminar esta exportação (foi encerrado, travou ou o dispositivo reiniciou)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin 在此导出完成前停止了（已退出、崩溃或设备重新启动）。"
