    "Stop the run. Every file keeps its checkpoint, so importing it again resumes where it stopped" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Lauf stoppen. Jede Datei behält ihren Checkpoint, ein erneuter Import setzt dort fort, wo er gestoppt wurde"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detener la ejecución. Cada archivo conserva su punto de control, así que volver a importarlo continúa donde se detuvo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêter l'exécution. Chaque fichier conserve son point de contrôle ; le réimporter reprend là où il s'est arrêté"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रन रोकें। हर फ़ाइल अपना चेकपॉइंट रखती है, इसलिए उसे फिर आयात करने पर वहीं से जारी रहता है जहाँ रुका था"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompi l'esecuzione. Ogni file mantiene il proprio checkpoint, quindi importandolo di nuovo si riprende da dove si era interrotto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行を停止します。各ファイルはチェックポイントを保持するため、再度読み込むと停止した場所から再開します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행을 중지합니다. 모든 파일은 체크포인트를 유지하므로 다시 가져오면 중지한 지점부터 재개됩니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parar a execução. Cada arquivo mantém seu ponto de verificação, então importá-lo novamente retoma de onde parou"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止运行。每个文件都保留检查点，因此再次导入会从停止处继续"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止執行。每個檔案都保留檢查點，因此再次匯入會從停止處繼續"
          }
        }
      }
    },
    "Stop this file after the current batch and continue with the next; its checkpoint is kept" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei nach dem aktuellen Stapel stoppen und mit der nächsten fortfahren; ihr Checkpoint bleibt erhalten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detener este archivo tras el lote actual y continuar con el siguiente; se conserva su punto de control"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêter ce fichier après le lot en cours et passer au suivant ; son point de contrôle est conservé"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्तमान बैच के बाद इस फ़ाइल को रोकें और अगली पर जारी रखें; इसका चेकपॉइंट रखा जाता है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompi questo file dopo il lotto corrente e continua con il successivo; il suo checkpoint viene conservato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のバッチの後でこのファイルを停止し、次のファイルに進みます。チェックポイントは保持されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 배치 후 이 파일을 중지하고 다음 파일로 계속합니다. 체크포인트는 유지됩니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parar este arquivo após o lote atual e continuar com o próximo; seu ponto de verificação é mantido"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在当前批次后停止此文件并继续下一个；其检查点将保留"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在目前批次後停止此檔案並繼續下一個；其檢查點會保留"
          }
        }
      }
    },
    "STOP WHEN EVIDENCE RUNS OUT — NEVER FORCE FIVE LEVELS" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STOPPEN, WENN DIE BEWEISE AUSGEHEN — NIE FÜNF EBENEN ERZWINGEN"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DETENTE CUANDO SE ACABE LA EVIDENCIA — NUNCA FUERCES CINCO NIVELES"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ARRÊTEZ QUAND LES PREUVES S'ÉPUISENT — NE FORCEZ JAMAIS CINQ NIVEAUX"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साक्ष्य समाप्त होने पर रुकें — कभी पाँच स्तर ज़बरदस्ती न भरें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FERMATI QUANDO LE PROVE FINISCONO — NON FORZARE MAI CINQUE LIVELLI"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "証拠が尽きたら止める — 5 段階を強制しない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "증거가 떨어지면 멈추세요 — 다섯 단계를 억지로 채우지 마세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PARE QUANDO AS EVIDÊNCIAS ACABAREM — NUNCA FORCE CINCO NÍVEIS"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "证据用尽即停止 — 绝不强凑五层"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "證據用盡即停止 — 絕不強湊五層"
          }
        }
      }
    },
    "Stopped by you after %lld messages — import this file again to resume from there" : {
