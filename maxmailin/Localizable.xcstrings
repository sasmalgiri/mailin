          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每封郵件只保留一份副本。多餘的副本會移到垃圾桶，並可從那裡回復。"
          }
        }
      }
    },
    "Each imported email is placed on legal hold and sealed the moment it is stored." : {
      "comment" : "A description of the effect of the collect-to-preserve setting.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede importierte E-Mail wird in dem Moment, in dem sie gespeichert wird, rechtlich gesperrt und versiegelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada correo importado se retiene legalmente y se sella en el momento en que se guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque e-mail importé est placé sous conservation légale et scellé dès qu’il est enregistré."
