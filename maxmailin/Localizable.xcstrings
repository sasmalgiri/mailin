    "Keeps a verified copy of the archive database before every upgrade and on a schedule, so a damaged database can be restored." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält vor jedem Upgrade und regelmäßig eine geprüfte Kopie der Archivdatenbank, damit eine beschädigte Datenbank wiederhergestellt werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva una copia verificada de la base de datos del archivo antes de cada actualización y de forma programada, para poder restaurar una base de datos dañada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde une copie vérifiée de la base de l’archive avant chaque mise à niveau et selon un calendrier, pour pouvoir restaurer une base endommagée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर अपग्रेड से पहले और समय-समय पर आर्काइव डेटाबेस की सत्यापित प्रति रखता है, ताकि क्षतिग्रस्त डेटाबेस पुनर्स्थापित किया जा सके।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva una copia verificata del database dell’archivio prima di ogni aggiornamento e a intervalli regolari, così un database danneggiato può essere ripristinato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップグレードのたびと定期的に、アーカイブのデータベースの検証済みコピーを保持し、破損したデータベースを復元できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업그레이드할 때마다, 그리고 정기적으로 보관함 데이터베이스의 검증된 사본을 보관해 손상된 데이터베이스를 복원할 수 있게 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém uma cópia verificada do banco de dados do arquivo antes de cada atualização e de forma programada, para que um banco danificado possa ser restaurado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每次升级前和按计划保留经过验证的归档数据库副本，以便恢复损坏的数据库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每次升級前和依排程保留經過驗證的封存資料庫副本，以便還原損毀的資料庫。"
          }
        }
      }
    },
