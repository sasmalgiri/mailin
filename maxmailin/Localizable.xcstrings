    "Applying a legal hold logs the action in the forensic audit trail and locks source integrity hashes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Anwenden eines Legal Hold protokolliert die Aktion im forensischen Prüfprotokoll und sperrt die Quellintegritäts-Hashes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar una retención legal registra la acción en el registro de auditoría forense y bloquea los hashes de integridad de la fuente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquer une conservation légale consigne l'action dans le journal d'audit forensique et verrouille les hachages d'intégrité des sources."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कानूनी रोक लागू करने से यह क्रिया फ़ोरेंसिक ऑडिट ट्रेल में दर्ज होती है और स्रोत अखंडता हैश लॉक हो जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applicare una conservazione legale registra l'azione nel registro di audit forense e blocca gli hash di integrità delle sorgenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リーガルホールドを適用すると、その操作がフォレンジック監査証跡に記録され、ソースの整合性ハッシュがロックされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "법적 보존을 적용하면 포렌식 감사 추적에 기록되고 소스 무결성 해시가 잠깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar uma retenção legal registra a ação na trilha de auditoria forense e bloqueia os hashes de integridade da fonte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用法律保留会将该操作记录到取证审计记录中，并锁定来源完整性哈希。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用法律保留會將該動作記錄到鑑識稽核記錄中，並鎖定來源完整性雜湊。"
          }
        }
      }
    },
