    "Write every file into one folder, or into a subfolder per message year" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Datei in einen Ordner schreiben oder in einen Unterordner pro Nachrichtenjahr"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribir todos los archivos en una carpeta, o en una subcarpeta por año del mensaje"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrire chaque fichier dans un seul dossier, ou dans un sous-dossier par année de message"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर फ़ाइल एक फ़ोल्डर में लिखें, या प्रति संदेश वर्ष एक उप-फ़ोल्डर में"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi ogni file in una sola cartella, oppure in una sottocartella per anno del messaggio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのファイルを 1 つのフォルダに書き込むか、メッセージの年ごとのサブフォルダに書き込みます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 파일을 한 폴더에 기록하거나, 메시지 연도별 하위 폴더에 기록합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gravar todos os arquivos em uma pasta, ou em uma subpasta por ano da mensagem"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将每个文件写入一个文件夹，或按邮件年份写入子文件夹"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將每個檔案寫入一個檔案夾，或依訊息年份寫入子檔案夾"
          }
        }
      }
    },
    "Writes archive-0001.mbox, archive-0002.mbox … so the export survives a 4 GB-per-file drive; Apple Mail imports the folder. A split export cannot be resumed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt archive-0001.mbox, archive-0002.mbox … damit der Export ein Laufwerk mit 4 GB pro Datei übersteht; Apple Mail importiert den Ordner. Ein geteilter Export kann nicht fortgesetzt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe archive-0001.mbox, archive-0002.mbox… para que la exportación sobreviva a una unidad con límite de 4 GB por archivo; Apple Mail importa la carpeta. Una exportación dividida no se puede reanudar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrit archive-0001.mbox, archive-0002.mbox… afin que l'export survive à un disque limité à 4 Go par fichier ; Apple Mail importe le dossier. Un export fractionné ne peut pas être repris."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "archive-0001.mbox, archive-0002.mbox … लिखता है ताकि निर्यात 4 GB-प्रति-फ़ाइल ड्राइव पर टिक सके; Apple Mail फ़ोल्डर आयात करता है। विभाजित निर्यात फिर से शुरू नहीं किया जा सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrive archive-0001.mbox, archive-0002.mbox … così l'esportazione sopravvive a un'unità con limite di 4 GB per file; Apple Mail importa la cartella. Un'esportazione suddivisa non può essere ripresa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "archive-0001.mbox、archive-0002.mbox … と書き込み、1 ファイル 4 GB 制限のドライブでも書き出しが成立するようにします。Apple Mail はフォルダを読み込めます。分割書き出しは再開できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "archive-0001.mbox, archive-0002.mbox … 로 기록하여 파일당 4GB 제한 드라이브에서도 내보내기가 유지되도록 합니다. Apple Mail은 폴더를 가져옵니다. 분할 내보내기는 재개할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava archive-0001.mbox, archive-0002.mbox … para que a exportação sobreviva a uma unidade com limite de 4 GB por arquivo; o Apple Mail importa a pasta. Uma exportação dividida não pode ser retomada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写入 archive-0001.mbox、archive-0002.mbox … 以便导出能在单文件 4 GB 限制的驱动器上保存；Apple 邮件可导入该文件夹。拆分导出无法恢复继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫入 archive-0001.mbox、archive-0002.mbox ⋯ 以便匯出能在單檔 4 GB 限制的磁碟機上保存；Apple 郵件可匯入該檔案夾。分割匯出無法繼續。"
          }
        }
      }
    },
    "Written %lld messages but read back %lld (%lld damaged) — do not import this until the difference is understood." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Nachrichten geschrieben, aber %2$lld zurückgelesen (%3$lld beschädigt) — importieren Sie dies nicht, bevor die Differenz verstanden ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Written %1$lld messages but read back %2$lld (%3$lld damaged) — do not import this until the difference is understood."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se escribieron %1$lld mensajes pero se releyeron %2$lld (%3$lld dañados) — no importes esto hasta entender la diferencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld messages écrits mais %2$lld relus (%3$lld endommagés) — n'importez pas ceci avant d'avoir compris la différence."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld संदेश लिखे गए पर %2$lld वापस पढ़े गए (%3$lld क्षतिग्रस्त) — अंतर समझे बिना इसे आयात न करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scritti %1$lld messaggi ma riletti %2$lld (%3$lld danneggiati) — non importarlo finché la differenza non è chiara."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld 件のメッセージを書き込みましたが、読み戻せたのは %2$lld 件 (%3$lld 件が破損) — 差異の原因が判明するまで読み込まないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지 %1$lld개를 기록했지만 %2$lld개만 다시 읽음(%3$lld개 손상) — 차이의 원인을 파악할 때까지 가져오지 마세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foram gravadas %1$lld mensagens, mas %2$lld foram relidas (%3$lld danificadas) — não importe isto até entender a diferença."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已写入 %1$lld 封邮件，但回读 %2$lld 封（%3$lld 封损坏）— 在弄清差异之前请勿导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已寫入 %1$lld 封訊息，但讀回 %2$lld 封（%3$lld 封損壞）— 在弄清差異之前請勿匯入。"
          }
        }
      }
    },
