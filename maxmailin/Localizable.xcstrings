    "Send emails to a reviewer as a Review Pack and merge the answers, or run a team case with signed logs and second-level review. Reviewers need no purchase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende E-Mails als Prüfpaket an eine Prüferin oder einen Prüfer und führe die Antworten zusammen, oder führe einen Teamfall mit signierten Protokollen und Zweitprüfung. Prüfende brauchen keinen Kauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía correos a un revisor como un Paquete de revisión y combina sus respuestas, o gestiona un caso en equipo con registros firmados y revisión de segundo nivel. Los revisores no necesitan comprar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez des e-mails à un réviseur sous forme de Pack de révision et fusionnez ses réponses, ou menez un dossier d'équipe avec journaux signés et révision de second niveau. Les réviseurs n'ont rien à acheter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ईमेल को रिव्यू पैक के रूप में समीक्षक को भेजें और उनके उत्तर मिलाएँ, या हस्ताक्षरित लॉग और दूसरे स्तर की समीक्षा वाला टीम केस चलाएँ। समीक्षकों को कुछ खरीदने की ज़रूरत नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia le email a un revisore come Pacchetto di revisione e unisci le risposte, oppure gestisci un caso di team con registri firmati e revisione di secondo livello. I revisori non devono acquistare nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールをレビューパックとしてレビュー担当者に送って回答を統合するか、署名付きログと二次レビューのあるチームケースを運用できます。レビュー担当者は購入不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일을 검토 팩으로 검토자에게 보내고 답변을 병합하거나, 서명된 로그와 2차 검토가 있는 팀 사건을 운영할 수 있습니다. 검토자는 구매할 필요가 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie e-mails a um revisor como um Pacote de revisão e junte as respostas, ou conduza um caso em equipe com registros assinados e revisão em segundo nível. Revisores não precisam comprar nada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将邮件作为审阅包发送给审阅人并合并其答复，或运行带签名日志和二级审阅的团队案例。审阅人无需购买。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將郵件作為審閱包傳送給審閱者並合併其回覆，或執行具簽署記錄和二級審閱的團隊案件。審閱者無需購買。"
          }
        }
      }
    },
