    "%lld of %lld emails are under legal hold — evidence seals active. Held emails are protected from modification or deletion." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$lld E-Mails unterliegen einem Legal Hold — Beweissiegel aktiv. Gehaltene E-Mails sind vor Änderung und Löschung geschützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld of %2$lld emails are under legal hold — evidence seals active. Held emails are protected from modification or deletion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de %2$lld correos están bajo retención legal — sellos de evidencia activos. Los correos retenidos están protegidos contra modificación o eliminación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld e-mails sur %2$lld sont sous conservation légale — scellés de preuve actifs. Les e-mails conservés sont protégés contre toute modification ou suppression."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld में से %1$lld ईमेल कानूनी रोक के अधीन हैं — साक्ष्य सील सक्रिय। रोके गए ईमेल संशोधन या विलोपन से सुरक्षित हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld email su %2$lld sono in conservazione legale — sigilli di prova attivi. Le email trattenute sono protette da modifiche ed eliminazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld 件中 %1$lld 件のメールがリーガルホールド中 — 証拠封印が有効です。保留中のメールは変更・削除から保護されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일 %2$lld개 중 %1$lld개가 법적 보존 중 — 증거 봉인 활성. 보존된 이메일은 수정 또는 삭제로부터 보호됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de %2$lld e-mails estão sob retenção legal — selos de evidência ativos. E-mails retidos são protegidos contra modificação ou exclusão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld 封邮件中有 %1$lld 封处于法律保留状态——证据封存已启用。被保留的邮件受保护，不能修改或删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld 封郵件中有 %1$lld 封處於法律保留狀態——證據封存已啟用。被保留的郵件受到保護，無法修改或刪除。"
          }
        }
      }
