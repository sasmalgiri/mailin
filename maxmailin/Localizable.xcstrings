    "Header fields beyond it are not read; the message, its body and its bytes are kept whole." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopfzeilen darüber hinaus werden nicht gelesen; die Nachricht, ihr Text und ihre Bytes bleiben vollständig erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los campos de cabecera que lo superan no se leen; el mensaje, su cuerpo y sus bytes se conservan completos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les champs d’en-tête au-delà ne sont pas lus ; le message, son corps et ses octets sont conservés en entier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे आगे के हेडर फ़ील्ड नहीं पढ़े जाते; संदेश, उसका मुख्य भाग और उसके बाइट पूरे रखे जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I campi di intestazione oltre questo limite non vengono letti; il messaggio, il corpo e i suoi byte sono conservati per intero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それを超えるヘッダフィールドは読まれません。メッセージ、本文、バイトはすべてそのまま保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 이후의 헤더 필드는 읽지 않습니다. 메시지와 본문, 바이트는 모두 그대로 보관됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Campos de cabeçalho além disso não são lidos; a mensagem, seu corpo e seus bytes são mantidos inteiros."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超出部分的邮件头字段不会被读取；邮件、正文及其字节完整保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超出部分的標頭欄位不會被讀取；郵件、內文及其位元組完整保留。"
          }
        }
      }
    },
