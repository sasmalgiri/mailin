    "Tag as %@ for the review — tags persist, feed the evidence filters, and are logged in the audit trail%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Prüfung als %1$@ taggen — Tags bleiben erhalten, speisen die Beweisfilter und werden im Prüfprotokoll festgehalten%2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tag as %1$@ for the review — tags persist, feed the evidence filters, and are logged in the audit trail%2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquetar como %1$@ para la revisión — las etiquetas persisten, alimentan los filtros de evidencia y quedan registradas en el registro de auditoría%2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étiqueter comme %1$@ pour la révision — les étiquettes persistent, alimentent les filtres de preuve et sont consignées dans le journal d'audit%2$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समीक्षा के लिए %1$@ के रूप में टैग करें — टैग बने रहते हैं, साक्ष्य फ़िल्टर में जाते हैं, और ऑडिट ट्रेल में दर्ज होते हैं%2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagga come %1$@ per la revisione — i tag persistono, alimentano i filtri delle prove e vengono registrati nel registro di audit%2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レビュー用に %1$@ としてタグ付け — タグは保持され、証拠フィルタに反映され、監査ログに記録されます%2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검토를 위해 %1$@(으)로 태그 — 태그는 유지되고, 증거 필터에 반영되며, 감사 추적에 기록됩니다%2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquetar como %1$@ para a revisão — as etiquetas persistem, alimentam os filtros de evidência e são registradas na trilha de auditoria%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为审阅标记为 %1$@ — 标签会保留、用于证据筛选，并记录在审计轨迹中%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為審閱標記為 %1$@ — 標籤會保留、用於證據篩選，並記錄在稽核軌跡中%2$@"
          }
        }
      }
    },
