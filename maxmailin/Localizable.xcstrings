    "%lld of %lld messages can be deleted; %lld are on hold and stay. Files other accounts or imports also use stay. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$lld Nachrichten können gelöscht werden; %3$lld haben eine Aufbewahrungssperre und bleiben. Dateien, die andere Accounts oder Importe ebenfalls nutzen, bleiben. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld of %2$lld messages can be deleted; %3$lld are on hold and stay. Files other accounts or imports also use stay. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pueden eliminar %1$lld de %2$lld mensajes; %3$lld están retenidos y se quedan. Los archivos que también usan otras cuentas o importaciones se quedan. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld messages sur %2$lld peuvent être supprimés ; %3$lld sont en conservation légale et restent. Les fichiers utilisés aussi par d’autres comptes ou importations restent. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld में से %1$lld संदेश हटाए जा सकते हैं; %3$lld रोक पर हैं और बने रहेंगे। जिन फ़ाइलों का उपयोग अन्य खाते या आयात भी करते हैं, वे बनी रहेंगी। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld di %2$lld messaggi possono essere eliminati; %3$lld sono in conservazione e restano. I file usati anche da altri account o importazioni restano. L’operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld 件中 %1$lld 件のメッセージを削除できます。%3$lld 件は保留中のため残ります。他のアカウントや読み込みでも使われているファイルは残ります。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지 %2$lld개 중 %1$lld개를 삭제할 수 있습니다. %3$lld개는 보존 중이므로 남습니다. 다른 계정이나 가져오기에서도 사용하는 파일은 남습니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de %2$lld mensagens podem ser excluídas; %3$lld estão em retenção e permanecem. Arquivos também usados por outras contas ou importações permanecem. Isso não pode ser desfeito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可删除 %2$lld 封邮件中的 %1$lld 封；%3$lld 封处于保留状态，将保留。其他账户或导入也在使用的文件将保留。此操作无法撤销。"
