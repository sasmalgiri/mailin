    "Skips this question until mailin is quit. Nothing is remembered across launches." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringt diese Frage, bis mailin beendet wird. Über Starts hinweg wird nichts gemerkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omite esta pregunta hasta que se cierre mailin. No se recuerda nada entre inicios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignore cette question jusqu'à la fermeture de mailin. Rien n'est mémorisé entre les lancements."
          }
