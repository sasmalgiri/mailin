    "This clears %@ and returns to the welcome screen. You can re-import anytime." : {
      "comment" : "Text in a confirmation that clears emails and returns to the welcome screen. The argument is the string “1 email” or the string “%arg emails”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies löscht %@ und kehrt zum Begrüßungsbildschirm zurück. Sie können jederzeit erneut importieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto borra %@ y vuelve a la pantalla de bienvenida. Puedes volver a importar cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela efface %@ et revient à l’écran d’accueil. Vous pouvez réimporter à tout moment."
