          }
        }
      }
    },
    "The backup is verified file by file, restored into a separate empty profile and its counts compared with the inventory. Your archive is not changed." : {
      "comment" : "A description of the backup process.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sicherung wird Datei für Datei geprüft, in ein separates leeres Profil wiederhergestellt und ihre Anzahlen werden mit dem Inventar verglichen. Ihr Archiv wird nicht verändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia se verifica archivo por archivo, se restaura en un perfil vacío aparte y sus recuentos se comparan con el inventario. Tu archivo no se modifica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauvegarde est vérifiée fichier par fichier, restaurée dans un profil vide distinct et ses décomptes sont comparés à l’inventaire. Votre archive n’est pas modifiée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैकअप को फ़ाइल-दर-फ़ाइल सत्यापित किया जाता है, एक अलग खाली प्रोफ़ाइल में पुनर्स्थापित किया जाता है और उसकी गिनतियों की तुलना सूची से की जाती है। आपका संग्रह नहीं बदला जाता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il backup viene verificato file per file, ripristinato in un profilo vuoto separato e i suoi conteggi vengono confrontati con l’inventario. Il tuo archivio non viene modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップはファイルごとに検証され、別の空のプロファイルに復元されて、その件数が目録と比較されます。アーカイブは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업은 파일별로 확인되고 별도의 빈 프로파일로 복원된 뒤 개수를 목록과 비교합니다. 보관함은 변경되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O backup é verificado arquivo por arquivo, restaurado em um perfil vazio separado e suas contagens são comparadas com o inventário. Seu arquivo não é alterado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份会逐个文件进行验证，恢复到一个单独的空配置文件中，并将其计数与清单进行比较。你的归档不会被更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份會逐一檔案進行驗證，回復到一個獨立的空描述檔中，並將其計數與清單進行比較。你的封存不會被更改。"
          }
        }
      }
    },
