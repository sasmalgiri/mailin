    "Stores raw MIME over 8 MB beside the database instead of inside a row, so a multi-gigabyte message can be archived at all." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert rohes MIME über 8 MB neben der Datenbank statt in einer Zeile, damit eine mehrere Gigabyte große Nachricht überhaupt archiviert werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almacena el MIME sin procesar de más de 8 MB junto a la base de datos en lugar de dentro de una fila, para que un mensaje de varios gigabytes pueda archivarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocke le MIME brut de plus de 8 Mo à côté de la base de données plutôt que dans une ligne, afin qu'un message de plusieurs gigaoctets puisse être archivé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8 MB से बड़े कच्चे MIME को पंक्ति के भीतर नहीं बल्कि डेटाबेस के बगल में संग्रहीत करता है, ताकि कई गीगाबाइट का संदेश भी संग्रहीत किया जा सके।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivia il MIME grezzo oltre 8 MB accanto al database invece che in una riga, così un messaggio di più gigabyte può essere archiviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8 MB を超える生の MIME を行の中ではなくデータベースの横に保存することで、数ギガバイトのメッセージもアーカイブできるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8MB를 넘는 원시 MIME을 행 안이 아니라 데이터베이스 옆에 저장하여, 수 기가바이트 메시지도 보관할 수 있게 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armazena o MIME bruto acima de 8 MB ao lado do banco de dados em vez de dentro de uma linha, para que uma mensagem de vários gigabytes possa ser arquivada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将超过 8 MB 的原始 MIME 存储在数据库旁边而非行内，使数 GB 的邮件也能归档。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將超過 8 MB 的原始 MIME 儲存在資料庫旁邊而非列內，使數 GB 的訊息也能封存。"
          }
        }
      }
    },
