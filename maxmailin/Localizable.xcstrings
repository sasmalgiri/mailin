    "Takes a snapshot first. The previous files stay as a second copy for the whole of 3.0, so switching this off loses nothing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt zuerst einen Snapshot. Die bisherigen Dateien bleiben in ganz 3.0 als zweite Kopie erhalten, sodass beim Ausschalten nichts verloren geht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero crea una instantánea. Los archivos anteriores se mantienen como segunda copia durante toda la versión 3.0, así que al desactivarlo no se pierde nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
