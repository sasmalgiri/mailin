        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conta, sem servidores de e-mail, sem coleta de dados. Seu arquivo nunca sai do seu dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
