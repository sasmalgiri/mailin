          }
        }
      }
    },
    "Also similar, not identical: ^[%lld group](inflect: true) to review one copy at a time." : {
      "comment" : "Plural-correct text through Foundation's automatic grammar agreement (`^[1 group](inflect: true)` → \"1 group\", `^[2 group](inflect: true)` → \"",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
