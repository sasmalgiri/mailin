            "state" : "translated",
            "value" : "Tippen Sie auf „Mit KI erweitern“ für Einblicke auf Führungsebene jenseits der KPI-Metriken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Mejorar con IA para obtener información a nivel ejecutivo más allá de las métricas KPI."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Enrichir avec l'IA pour des informations de niveau direction au-delà des indicateurs KPI."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KPI मेट्रिक्स से आगे कार्यकारी-स्तर की जानकारी के लिए AI से बेहतर बनाएँ टैप करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Potenzia con IA per approfondimenti di livello dirigenziale oltre le metriche KPI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「AI で強化」をタップすると、KPI 指標を超えた経営層向けのインサイトが得られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI로 강화를 탭하면 KPI 지표를 넘어선 경영진 수준의 인사이트를 볼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Aprimorar com IA para insights de nível executivo além das métricas de KPI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点“用 AI 增强”以获得超越 KPI 指标的高管级洞察。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下「以 AI 強化」以取得超越 KPI 指標的高階主管級洞察。"
          }
        }
      }
    },
