    "No verified boundary could be found in the partial file; nothing was cut. Export again writes a new file." : {
      "comment" : "Text displayed in a notification when a partial file's boundary could not be verified.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Teildatei wurde keine bestätigte Grenze gefunden; nichts wurde abgeschnitten. „Erneut exportieren“ schreibt eine neue Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró ningún límite verificado en el archivo parcial; no se recortó nada. Exportar de nuevo escribe un archivo nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune limite vérifiée n’a été trouvée dans le fichier partiel ; rien n’a été retiré. Exporter à nouveau écrit un nouveau fichier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आंशिक फ़ाइल में कोई सत्यापित सीमा नहीं मिली; कुछ नहीं काटा गया। फिर से निर्यात करें नई फ़ाइल लिखता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun limite verificato trovato nel file parziale; non è stato eliminato nulla. Esporta di nuovo scrive un nuovo file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分ファイルに検証済みの境界が見つからなかったため、何も切り取っていません。「もう一度書き出す」で新しいファイルを書き出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부분 파일에서 검증된 경계를 찾지 못해 아무것도 잘라 내지 않았습니다. ‘다시 내보내기’는 새 파일을 만듭니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum limite verificado foi encontrado no arquivo parcial; nada foi cortado. Exportar novamente grava um arquivo novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在部分文件中找不到已验证的边界；未截去任何内容。“重新导出”会写入一个新文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在部分檔案中找不到已驗證的邊界；未截去任何內容。「重新匯出」會寫入一個新檔案。"
          }
        }
      }
    },
