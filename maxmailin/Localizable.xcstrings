            "value" : "Un paquete BagIt con cada mensaje original y metadatos PREMIS — el estándar de archivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paquet BagIt avec chaque message original et des métadonnées PREMIS — la norme d’archivage"
