    "No account is saving mail. Add an account and allow Preserve mail first." : {
      "comment" : "A message displayed when no account is configured for connected mail.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Account sichert Mails. Fügen Sie zuerst einen Account hinzu und erlauben Sie „Mails aufbewahren“."
