      }
    },
    "A relevance ranking algorithm used by search engines. Scores emails by how strongly they match your search terms, not just whether they contain them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Relevanz-Ranking-Algorithmus, wie ihn Suchmaschinen verwenden. Bewertet E-Mails danach, wie stark sie Ihren Suchbegriffen entsprechen, nicht nur ob sie sie enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un algoritmo de clasificación por relevancia usado por los motores de búsqueda. Puntúa los correos según cuánto coinciden con tus términos de búsqueda, no solo si los contienen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un algorithme de classement par pertinence utilisé par les moteurs de recherche. Note les e-mails selon la force de leur correspondance avec vos termes, pas seulement leur présence."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोज इंजनों द्वारा उपयोग किया जाने वाला प्रासंगिकता रैंकिंग एल्गोरिदम। ईमेल को इस आधार पर स्कोर करता है कि वे आपके खोज शब्दों से कितनी मज़बूती से मेल खाते हैं, न कि केवल उन्हें शामिल करते हैं या नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un algoritmo di classificazione per rilevanza usato dai motori di ricerca. Assegna un punteggio alle email in base a quanto corrispondono ai termini di ricerca, non solo se li contengono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索エンジンで使われる関連度ランキングアルゴリズム。検索語を含むかどうかだけでなく、どれだけ強く一致するかでメールをスコア化します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색 엔진이 사용하는 관련성 순위 알고리즘입니다. 검색어 포함 여부뿐 아니라 얼마나 강하게 일치하는지로 이메일에 점수를 매깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um algoritmo de classificação por relevância usado por mecanismos de busca. Pontua e-mails pela força da correspondência com seus termos de busca, não apenas se os contêm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索引擎使用的相关性排序算法。根据邮件与搜索词的匹配强度评分，而不仅仅是是否包含。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜尋引擎使用的相關性排名演算法。依郵件與搜尋詞的相符強度評分，而不只是是否包含。"
          }
        }
      }
    },
    "A report, not a mail archive: this output cannot be re-imported as email. Keep an mbox or .eml export for a restorable copy." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bericht, kein E-Mail-Archiv: Diese Ausgabe kann nicht als E-Mail wieder importiert werden. Bewahren Sie für eine wiederherstellbare Kopie einen mbox- oder .eml-Export auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un informe, no un archivo de correo: esta salida no se puede volver a importar como correo. Conserve una exportación mbox o .eml como copia restaurable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rapport, pas une archive de courrier : cette sortie ne peut pas être réimportée comme courrier. Conservez un export mbox ou .eml pour une copie restaurable."
