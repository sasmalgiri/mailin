    },
    "Pull quotable statements, read the surrounding threads for context, and attribute each quote to who said it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zitierfähige Aussagen herausziehen, die umgebenden Threads für den Kontext lesen und jedes Zitat der Person zuordnen, die es gesagt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extraer declaraciones citables, leer los hilos circundantes para el contexto y atribuir cada cita a quien la dijo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extraire des déclarations citables, lire les fils environnants pour le contexte et attribuer chaque citation à son auteur."
