    "Searches subjects, senders and full text across the whole archive. Power operators: from: to: subject: tag: type:sent has:attachment in:attachments before:2024-01-01 — quotes for exact phrases" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsucht Betreffzeilen, Absender und Volltext im gesamten Archiv. Power-Operatoren: from: to: subject: tag: type:sent has:attachment in:attachments before:2024-01-01 — Anführungszeichen für genaue Phrasen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca asuntos, remitentes y texto completo en todo el archivo. Operadores avanzados: from: to: subject: tag: type:sent has:attachment in:attachments before:2024-01-01 — comillas para frases exactas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche dans les sujets, les expéditeurs et le texte intégral de toute l'archive. Opérateurs avancés : from: to: subject: tag: type:sent has:attachment in:attachments before:2024-01-01 — guillemets pour les expressions exactes"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे संग्रह में विषय, प्रेषक और पूर्ण टेक्स्ट खोजता है। उन्नत ऑपरेटर: from: to: subject: tag: type:sent has:attachment in:attachments before:2024-01-01 — सटीक वाक्यांशों के लिए उद्धरण चिह्न"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca oggetti, mittenti e testo completo in tutto l'archivio. Operatori avanzati: from: to: subject: tag: type:sent has:attachment in:attachments before:2024-01-01 — virgolette per le frasi esatte"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブ全体の件名、送信者、全文を検索します。高度な演算子: from: to: subject: tag: type:sent has:attachment in:attachments before:2024-01-01 — 完全一致フレーズは引用符で囲みます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 아카이브에서 제목, 발신자, 전문을 검색합니다. 고급 연산자: from: to: subject: tag: type:sent has:attachment in:attachments before:2024-01-01 — 정확한 문구는 따옴표로 묶으세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquisa assuntos, remetentes e texto completo em todo o arquivo. Operadores avançados: from: to: subject: tag: type:sent has:attachment in:attachments before:2024-01-01 — aspas para frases exatas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在整个归档中搜索主题、发件人和全文。高级运算符：from: to: subject: tag: type:sent has:attachment in:attachments before:2024-01-01 — 精确短语请加引号"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在整個封存中搜尋主旨、寄件者和全文。進階運算子：from: to: subject: tag: type:sent has:attachment in:attachments before:2024-01-01 — 精確片語請加引號"
          }
        }
      }
    },
