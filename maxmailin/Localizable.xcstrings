        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자가 신고한 의심스러운 이메일로, 사전 점수가 매겨져 사용자의 판정을 기다립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
