    "These files are read whole into memory; a larger one is refused with that reason." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Dateien werden vollständig in den Speicher gelesen; eine größere wird mit diesem Grund abgelehnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos archivos se leen completos en memoria; uno mayor se rechaza con ese motivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces fichiers sont lus entièrement en mémoire ; un fichier plus grand est refusé avec ce motif."
