            "value" : "La ricerca può escludere oltre che includere: metti - o NOT davanti a qualsiasi filtro (from:, to:, subject:, domain:, tag:, source:, type:, evidence:, filename:, before:, after:, has:attachment, is:pinned)."
          }
        },
        "ja" : {
          "stringUnit" : {
