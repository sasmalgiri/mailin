    "Alternatively, “Detect on this Mac” looks in ~/Library/Mail for mailboxes Mail already stores locally." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ sucht „Auf diesem Mac erkennen“ in ~/Library/Mail nach Postfächern, die Mail bereits lokal speichert."
          }
        },
        "es" : {
          "stringUnit" : {
