    "Account removed. %lld archived messages kept; %lld unsent messages kept; %lld awaiting their outcome." : {
      "comment" : "Text displayed in a notification when an account is removed. The first argument is the number of archived messages kept. The second argument is the number of unsent messages kept. The third argument is the number of messages that are awaiting their outcome.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account entfernt. %1$lld archivierte Nachrichten behalten; %2$lld nicht gesendete Nachrichten behalten; %3$lld warten auf ihr Ergebnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Account removed. %1$lld archived messages kept; %2$lld unsent messages kept; %3$lld awaiting their outcome."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta eliminada. Se conservan %1$lld mensajes archivados; se conservan %2$lld mensajes sin enviar; %3$lld esperan su resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte supprimé. %1$lld messages archivés conservés ; %2$lld messages non envoyés conservés ; %3$lld en attente de leur résultat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाता हटाया गया। %1$lld संग्रहीत संदेश रखे गए; %2$lld न भेजे गए संदेश रखे गए; %3$lld अपने परिणाम की प्रतीक्षा में।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account rimosso. %1$lld messaggi archiviati conservati; %2$lld messaggi non inviati conservati; %3$lld in attesa dell’esito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除しました。アーカイブ済みメッセージ %1$lld 件を保持、未送信メッセージ %2$lld 件を保持、%3$lld 件は結果待ちです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정이 제거되었습니다. 보관된 메시지 %1$lld개 유지, 보내지 않은 메시지 %2$lld개 유지, %3$lld개는 결과 대기 중입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta removida. %1$lld mensagens arquivadas mantidas; %2$lld mensagens não enviadas mantidas; %3$lld aguardando o resultado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已移除账户。保留了 %1$lld 封已归档邮件；保留了 %2$lld 封未发送邮件；%3$lld 封正在等待结果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已移除帳號。保留了 %1$lld 封已封存郵件；保留了 %2$lld 封未傳送郵件；%3$lld 封正在等待結果。"
          }
        }
      }
    },
