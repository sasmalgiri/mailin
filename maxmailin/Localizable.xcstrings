    "%@: not every message has been saved yet (%lld saved) — messages not saved are not searched and may still match" : {
      "comment" : "A sentence that explains that a user's account has not saved all of their messages yet. The argument is the user's display name.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: Noch nicht jede Nachricht ist gesichert (%2$lld gesichert) – nicht gesicherte Nachrichten werden nicht durchsucht und könnten trotzdem passen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: not every message has been saved yet (%2$lld saved) — messages not saved are not searched and may still match"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: aún no se han guardado todos los mensajes (%2$lld guardados); los mensajes no guardados no se buscan y podrían coincidir"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : tous les messages ne sont pas encore enregistrés (%2$lld enregistrés) — les messages non enregistrés ne sont pas recherchés et pourraient correspondre"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: अभी हर संदेश सहेजा नहीं गया है (%2$lld सहेजे गए) — जो संदेश सहेजे नहीं गए उनमें खोज नहीं होती और वे फिर भी मेल खा सकते हैं"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: non tutti i messaggi sono stati ancora salvati (%2$lld salvati); i messaggi non salvati non vengono cercati e potrebbero corrispondere"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：まだすべてのメッセージが保存されていません（保存済み %2$lld 件）。保存されていないメッセージは検索されず、一致する可能性があります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: 아직 모든 메시지가 저장되지 않았습니다(저장됨 %2$lld개). 저장되지 않은 메시지는 검색되지 않으며 일치할 수도 있습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: nem todas as mensagens foram salvas ainda (%2$lld salvas) — mensagens não salvas não são pesquisadas e podem corresponder"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：尚未保存所有邮件（已保存 %2$lld 封）— 未保存的邮件不会被搜索，可能仍有匹配"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
