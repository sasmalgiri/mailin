    "This posts a permanent reversal document referencing %@ and records it in the audit trail. The original stays on record; the reversal cannot be undone." : {
      "comment" : "A confirmation dialog that appears when the user wants to reverse a document. The argument is the number of the document to be reversed.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird ein dauerhaftes Stornodokument mit Bezug auf %@ gebucht und im Prüfprotokoll vermerkt. Das Original bleibt erhalten; das Storno kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto registra un documento de anulación permanente que hace referencia a %@ y lo anota en el registro de auditoría. El original se conserva; la anulación no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci enregistre un document d’extourne permanent faisant référence à %@ et le consigne dans le journal d’audit. L’original reste enregistré ; l’extourne est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह %@ के संदर्भ में एक स्थायी रिवर्सल दस्तावेज़ दर्ज करता है और उसे ऑडिट ट्रेल में रिकॉर्ड करता है। मूल रिकॉर्ड बना रहता है; रिवर्सल पूर्ववत नहीं किया जा सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra un documento di storno permanente che fa riferimento a %@ e lo annota nel registro di audit. L’originale resta agli atti; lo storno non può essere annullato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を参照する恒久的な取消書類を記帳し、監査証跡に記録します。元の記録は残ります。取消は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 참조하는 영구 취소 문서를 전기하고 감사 추적에 기록합니다. 원본은 그대로 남으며, 취소는 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso registra um documento de estorno permanente que faz referência a %@ e o anota na trilha de auditoria. O original continua registrado; o estorno não pode ser desfeito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将过账一份引用 %@ 的永久冲销文档，并记入审计记录。原始记录保留；冲销无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會過帳一份參照 %@ 的永久沖銷文件，並記入稽核軌跡。原始紀錄保留；沖銷無法復原。"
          }
        }
      }
    },
