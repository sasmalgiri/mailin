          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afectados %1$lld · recuperados %2$lld · ya intactos %3$lld · ambiguos %4$lld · sin fuente %5$lld · fallidos %6$lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concernés %1$lld · récupérés %2$lld · déjà intacts %3$lld · ambigus %4$lld · source manquante %5$lld · échoués %6$lld."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रभावित %1$lld · पुनर्प्राप्त %2$lld · पहले से ठीक %3$lld · अस्पष्ट %4$lld · स्रोत गायब %5$lld · विफल %6$lld।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interessati %1$lld · recuperati %2$lld · già integri %3$lld · ambigui %4$lld · origine mancante %5$lld · non riusciti %6$lld."
          }
        },
        "ja" : {
          "stringUnit" : {
