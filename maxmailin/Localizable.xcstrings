          }
        }
      }
    },
    "No account, no mail servers, no data collection. Your archive stays on your device by default — optional Cloud AI is opt-in." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Konto, keine Mailserver, keine Datenerfassung. Ihr Archiv bleibt standardmäßig auf Ihrem Gerät — optionale Cloud-KI ist Opt-in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta, sin servidores de correo, sin recopilación de datos. Tu archivo permanece en tu dispositivo de forma predeterminada — la IA en la nube opcional requiere activación."
          }
        },
        "fr" : {
          "stringUnit" : {
