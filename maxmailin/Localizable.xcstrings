    "No documents posted yet — every completed import, verdict, export, report, story version and cleanup posts one automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Dokumente abgelegt — jeder abgeschlossene Import, jedes Urteil, jeder Export, Bericht, jede Story-Version und Bereinigung legt automatisch eines ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay documentos publicados — cada importación completada, veredicto, exportación, informe, versión de historia y limpieza publica uno automáticamente."
