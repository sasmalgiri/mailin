          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleciona cada cópia extra nos %lld grupos verificados, mantendo uma de cada — depois pressione Remover selecionados. Candidatos e quase duplicados nunca são selecionados em massa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 %lld 个已验证组中的每个多余副本，每组保留一个，然后按“删除所选”。候选和近似重复永远不会被批量选择。"
