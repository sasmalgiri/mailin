          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas assez de données de réponse pour calculer les temps de réponse. Cette analyse nécessite des e-mails avec en-têtes In-Reply-To."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रतिक्रिया समय की गणना के लिए पर्याप्त उत्तर डेटा नहीं। इस विश्लेषण के लिए In-Reply-To हेडर वाले ईमेल चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
