    "Your relevant / irrelevant tags are kept. Only the ranking stops being computed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Tags „relevant“ / „irrelevant“ bleiben erhalten. Nur die Rangfolge wird nicht mehr berechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus etiquetas relevante / irrelevante se conservan. Solo deja de calcularse la clasificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos étiquettes pertinent / non pertinent sont conservées. Seul le classement cesse d'être calculé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके प्रासंगिक / अप्रासंगिक टैग रखे जाते हैं। केवल रैंकिंग की गणना रुकती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi tag pertinente / non pertinente vengono conservati. Solo la classificazione smette di essere calcolata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関連あり / 無関係のタグは保持されます。ランキングの計算だけが停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관련 / 무관 태그는 유지됩니다. 순위 계산만 중단됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas etiquetas relevante / irrelevante são mantidas. Apenas a classificação deixa de ser calculada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的相关 / 不相关标签会保留。只是不再计算排序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的相關 / 不相關標籤會保留。只是不再計算排名。"
          }
        }
      }
    },
    "Your review progress — assign privilege designations to documents to mark them as reviewed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
