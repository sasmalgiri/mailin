    "Answer a data-subject/GDPR request on the clock — locate the data, redact everyone else's, and produce a clean response pack." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Betroffenen-/DSGVO-Anfrage fristgerecht beantworten — die Daten finden, alle anderen schwärzen und ein sauberes Antwortpaket erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responder a una solicitud de interesado/RGPD dentro del plazo — localizar los datos, censurar a todos los demás y producir un paquete de respuesta limpio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondre à une demande de personne concernée/RGPD dans les délais — localiser les données, caviarder tous les autres et produire un dossier de réponse propre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेटा-विषय/GDPR अनुरोध का समय पर उत्तर दें — डेटा खोजें, बाकी सबकी जानकारी छिपाएँ और एक साफ़ उत्तर पैक बनाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondere a una richiesta dell'interessato/GDPR nei tempi previsti — individuare i dati, oscurare tutti gli altri e produrre un pacchetto di risposta pulito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本人/GDPR の請求に期限内に対応 — データを特定し、他者の情報を墨消しし、整った回答パックを作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정보주체/GDPR 요청에 기한 내 응답 — 데이터를 찾고, 다른 사람의 정보는 가리고, 깔끔한 응답 패키지를 만듭니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responder a uma solicitação de titular de dados/LGPD dentro do prazo — localizar os dados, ocultar todos os demais e produzir um pacote de resposta limpo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按期答复数据主体/GDPR 请求 — 找到数据，遮盖其他所有人的信息，生成一份干净的答复包。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如期回覆資料當事人/GDPR 請求 — 找出資料、遮蓋其他所有人的資訊，產生一份乾淨的回覆包。"
          }
        }
      }
    },
    "Answer any of these — leave blank to skip. Every field searches the whole archive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantworten Sie beliebige davon — leer lassen zum Überspringen. Jedes Feld durchsucht das gesamte Archiv."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde a cualquiera de estas — deja en blanco para omitir. Cada campo busca en todo el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondez à l'une de ces questions — laissez vide pour passer. Chaque champ interroge toute l'archive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनमें से किसी का भी उत्तर दें — छोड़ने के लिए खाली रखें। हर फ़ील्ड पूरे संग्रह में खोजती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondi a una qualsiasi di queste — lascia vuoto per saltare. Ogni campo cerca nell'intero archivio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いずれかに答えてください — 空欄のままならスキップします。各フィールドはアーカイブ全体を検索します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 중 아무거나 답하세요 — 비워 두면 건너뜁니다. 각 필드는 전체 보관함을 검색합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responda a qualquer uma delas — deixe em branco para pular. Cada campo pesquisa o arquivo inteiro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答其中任意一项——留空即跳过。每个字段都搜索整个归档。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答其中任何一項——留白即略過。每個欄位都會搜尋整個封存。"
          }
        }
      }
    },
