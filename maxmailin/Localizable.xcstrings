        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld e-mail%2$@ scellé(s) pour la première fois — hachages SHA-256 calculés et enregistrés comme référence. Relancez la vérification pour confirmer l'intégrité par rapport à ces références."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld ईमेल%2$@ पहली बार सील किए गए — SHA-256 हैश गणना कर आधार के रूप में संग्रहीत। इन आधारों के विरुद्ध अखंडता की पुष्टि के लिए सत्यापन फिर चलाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld email%2$@ sigillate per la prima volta — hash SHA-256 calcolati e salvati come riferimento. Esegui di nuovo la verifica per confermare l'integrità rispetto a questi riferimenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メール %1$lld 件%2$@ を初めて封印 — SHA-256 ハッシュを計算し、基準として保存しました。これらの基準に対する整合性を確認するには、検証をもう一度実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일 %1$lld개%2$@ 최초 봉인 — SHA-256 해시를 계산해 기준으로 저장했습니다. 이 기준에 대한 무결성을 확인하려면 검증을 다시 실행하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld e-mail%2$@ selado(s) pela primeira vez — hashes SHA-256 calculados e guardados como referência. Execute a verificação novamente para confirmar a integridade em relação a essas referências."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld 封邮件%2$@ 首次封存——已计算 SHA-256 哈希并作为基准存储。请再次运行校验，以根据这些基准确认完整性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld 封郵件%2$@ 首次封存——已計算 SHA-256 雜湊並作為基準儲存。請再次執行驗證，以根據這些基準確認完整性。"
          }
        }
      }
