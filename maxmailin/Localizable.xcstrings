    "Search can exclude as well as include: -from:, -to:, -tag:, -label:, -domain:, -subject:, -has:attachment and NOT before any of them." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Suche kann ausschließen wie einschließen: -from:, -to:, -tag:, -label:, -domain:, -subject:, -has:attachment und NOT vor jedem davon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda puede excluir además de incluir: -from:, -to:, -tag:, -label:, -domain:, -subject:, -has:attachment y NOT delante de cualquiera de ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche peut exclure autant qu’inclure : -from:, -to:, -tag:, -label:, -domain:, -subject:, -has:attachment et NOT devant chacun d’eux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोज शामिल करने के साथ बाहर भी कर सकती है: -from:, -to:, -tag:, -label:, -domain:, -subject:, -has:attachment और इनमें से किसी से पहले NOT।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricerca può escludere oltre che includere: -from:, -to:, -tag:, -label:, -domain:, -subject:, -has:attachment e NOT davanti a ciascuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索では含めるだけでなく除外もできます: -from:、-to:、-tag:、-label:、-domain:、-subject:、-has:attachment、またはそれぞれの前に NOT。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색은 포함뿐 아니라 제외도 할 수 있습니다: -from:, -to:, -tag:, -label:, -domain:, -subject:, -has:attachment, 그리고 각각의 앞에 NOT."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A busca pode excluir além de incluir: -from:, -to:, -tag:, -label:, -domain:, -subject:, -has:attachment e NOT antes de qualquer um deles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索既可包含也可排除：-from:、-to:、-tag:、-label:、-domain:、-subject:、-has:attachment，以及在任一项前加 NOT。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜尋既可包含也可排除：-from:、-to:、-tag:、-label:、-domain:、-subject:、-has:attachment，以及在任一項前加 NOT。"
          }
        }
      }
    },
    "Search can exclude as well as include: put - or NOT before any filter (from:, to:, subject:, domain:, tag:, source:, type:, evidence:, filename:, before:, after:, has:attachment, is:pinned)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Suche kann ausschließen wie einschließen: Setzen Sie - oder NOT vor einen beliebigen Filter (from:, to:, subject:, domain:, tag:, source:, type:, evidence:, filename:, before:, after:, has:attachment, is:pinned)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda puede excluir además de incluir: pon - o NOT delante de cualquier filtro (from:, to:, subject:, domain:, tag:, source:, type:, evidence:, filename:, before:, after:, has:attachment, is:pinned)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche peut exclure aussi bien qu’inclure : placez - ou NOT devant n’importe quel filtre (from:, to:, subject:, domain:, tag:, source:, type:, evidence:, filename:, before:, after:, has:attachment, is:pinned)."
          }
        },
        "hi" : {
