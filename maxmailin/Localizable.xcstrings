    "Audit mailboxes for hostile auto-forward and hidden inbox rules that signal a compromise, and report them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postfächer auf feindliche automatische Weiterleitungen und versteckte Posteingangsregeln prüfen, die auf eine Kompromittierung hindeuten, und sie melden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditar los buzones en busca de reenvíos automáticos hostiles y reglas de bandeja ocultas que indiquen un compromiso, e informar de ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditer les boîtes aux lettres à la recherche de transferts automatiques hostiles et de règles cachées signalant une compromission, et les signaler."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेलबॉक्स में ऐसे शत्रुतापूर्ण ऑटो-फ़ॉरवर्ड और छिपे इनबॉक्स नियमों का ऑडिट करें जो समझौते का संकेत देते हैं, और उनकी रिपोर्ट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificare le caselle alla ricerca di inoltri automatici ostili e regole nascoste che segnalano una compromissione, e segnalarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "侵害の兆候となる不審な自動転送や隠れた受信ルールがないかメールボックスを監査し、報告します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "침해를 나타내는 악의적인 자동 전달과 숨겨진 받은편지함 규칙이 있는지 사서함을 감사하고 보고합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditar caixas de correio em busca de encaminhamentos automáticos hostis e regras ocultas que indiquem comprometimento, e relatá-los."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "审计邮箱中可能表明遭入侵的恶意自动转发和隐藏收件规则，并报告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稽核郵件信箱中可能表示遭入侵的惡意自動轉寄與隱藏收件規則，並回報。"
          }
        }
      }
    },
    "Audit the set for personal data — scan, classify sensitivity, remediate, and report compliance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Bestand auf personenbezogene Daten prüfen — scannen, Sensibilität einstufen, bereinigen und die Compliance berichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditar el conjunto en busca de datos personales — escanear, clasificar la sensibilidad, remediar e informar del cumplimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditer l'ensemble à la recherche de données personnelles — analyser, classer la sensibilité, remédier et rendre compte de la conformité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेट में व्यक्तिगत डेटा का ऑडिट करें — स्कैन करें, संवेदनशीलता वर्गीकृत करें, सुधार करें और अनुपालन की रिपोर्ट दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificare l'insieme alla ricerca di dati personali — scansionare, classificare la sensibilità, porre rimedio e riferire sulla conformità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人データがないかセットを監査 — スキャン、機密度の分類、是正、コンプライアンスの報告を行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인정보가 있는지 세트를 감사 — 스캔, 민감도 분류, 조치, 준수 보고를 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditar o conjunto em busca de dados pessoais — varrer, classificar a sensibilidade, remediar e relatar a conformidade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "审计数据集中的个人数据 — 扫描、划分敏感度、整改并报告合规情况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稽核資料集中的個人資料 — 掃描、劃分敏感度、改善並回報法規遵循情況。"
          }
        }
      }
    },
