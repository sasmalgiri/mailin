    "Round %lld (%@) read more of %@; what is still not read is listed in its record." : {
      "comment" : "A message that indicates that the user has resumed reading the attachment again, and that the new round and limits are different from the previous one.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runde %1$lld (%2$@) hat mehr von %3$@ gelesen; was noch ungelesen ist, steht in seinem Eintrag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Round %1$lld (%2$@) read more of %3$@; what is still not read is listed in its record."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ronda %1$lld (%2$@) leyó más de %3$@; lo que aún no se leyó figura en su registro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tour %1$lld (%2$@) a lu davantage de %3$@ ; ce qui n'est pas encore lu figure dans son enregistrement."
