        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A App Store não conseguiu verificar esta compra. Nada foi desbloqueado; tente novamente ou use Restaurar compras se você já pagou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
