        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu endereço de e-mail é detectado automaticamente a partir do arquivo — pastas Enviados/Recebidos, estatísticas de resposta e análise de e-mails enviados funcionam sem nenhuma configuração."
          }
