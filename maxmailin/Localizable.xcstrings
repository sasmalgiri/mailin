    "Written %lld messages but read back %lld (%lld damaged) — do not import this until the difference is understood." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Nachrichten geschrieben, aber %2$lld zurückgelesen (%3$lld beschädigt) — importieren Sie dies nicht, bevor die Differenz verstanden ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Written %1$lld messages but read back %2$lld (%3$lld damaged) — do not import this until the difference is understood."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se escribieron %1$lld mensajes pero se releyeron %2$lld (%3$lld dañados) — no importes esto hasta entender la diferencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld messages écrits mais %2$lld relus (%3$lld endommagés) — n'importez pas ceci avant d'avoir compris la différence."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld संदेश लिखे गए पर %2$lld वापस पढ़े गए (%3$lld क्षतिग्रस्त) — अंतर समझे बिना इसे आयात न करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scritti %1$lld messaggi ma riletti %2$lld (%3$lld danneggiati) — non importarlo finché la differenza non è chiara."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld 件のメッセージを書き込みましたが、読み戻せたのは %2$lld 件 (%3$lld 件が破損) — 差異の原因が判明するまで読み込まないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지 %1$lld개를 기록했지만 %2$lld개만 다시 읽음(%3$lld개 손상) — 차이의 원인을 파악할 때까지 가져오지 마세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foram gravadas %1$lld mensagens, mas %2$lld foram relidas (%3$lld danificadas) — não importe isto até entender a diferença."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已写入 %1$lld 封邮件，但回读 %2$lld 封（%3$lld 封损坏）— 在弄清差异之前请勿导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已寫入 %1$lld 封訊息，但讀回 %2$lld 封（%3$lld 封損壞）— 在弄清差異之前請勿匯入。"
          }
        }
      }
