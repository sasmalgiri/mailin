          "stringUnit" : {
            "state" : "translated",
            "value" : "audio o vídeo: active «Voz en adjuntos» (Ajustes ▸ Módulos) para leerlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "audio ou vidéo — activez « Parole dans les pièces jointes » (Réglages ▸ Modules) pour le lire"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑडियो या वीडियो — इसे पढ़ने के लिए “अनुलग्नकों में बोली” (सेटिंग्स ▸ मॉड्यूल) चालू करें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "audio o video: attiva \"Parlato negli allegati\" (Impostazioni ▸ Moduli) per leggerlo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声または動画 — 読み取るには「添付ファイル内の発話」（設定 ▸ モジュール）をオンにしてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오 또는 비디오 — 읽으려면 '첨부 파일의 음성'(설정 ▸ 모듈)을 켜세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "áudio ou vídeo — ative \"Fala em anexos\" (Ajustes ▸ Módulos) para lê-lo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频或视频——请在“设置 ▸ 模块”中开启“附件中的语音”以读取"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音訊或影片——請在「設定 ▸ 模組」中開啟「附件中的語音」以讀取"
          }
        }
      }
    },
