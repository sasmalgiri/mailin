        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin이 만든 모든 임시 파일을 삭제합니다. 안전하지만 실행 취소할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
