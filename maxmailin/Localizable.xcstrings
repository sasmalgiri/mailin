        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过此大小的邮件按字节范围保存并逐字节导出，但其正文不可搜索；导入回执会统计此类邮件。"
          }
        },
        "zh-Hant" : {
