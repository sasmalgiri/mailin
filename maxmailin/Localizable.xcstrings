    "Dashboards, statistics, attachments, subjects and IT security figures computed for the whole archive from the analysis index." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dashboards, Statistiken, Anhänge, Betreffs und IT-Sicherheitswerte, berechnet für das gesamte Archiv aus dem Analyseindex."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paneles, estadísticas, adjuntos, asuntos y cifras de seguridad informática calculados para todo el archivo desde el índice de análisis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tableaux de bord, statistiques, pièces jointes, objets et chiffres de sécurité informatique calculés pour toute l’archive depuis l’index d’analyse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डैशबोर्ड, आँकड़े, अटैचमेंट, विषय और आईटी सुरक्षा आँकड़े विश्लेषण इंडेक्स से पूरे आर्काइव के लिए गणना किए गए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pannelli, statistiche, allegati, oggetti e dati di sicurezza informatica calcolati per l’intero archivio dall’indice di analisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダッシュボード、統計、添付ファイル、件名、IT セキュリティの数値を、分析インデックスからアーカイブ全体について計算します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대시보드, 통계, 첨부 파일, 제목, IT 보안 수치를 분석 색인에서 전체 보관함에 대해 계산합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
