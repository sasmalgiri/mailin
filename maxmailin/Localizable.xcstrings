    "Enabling the page connects to nothing. Each account is added and allowed separately by you." : {
      "comment" : "Text describing the consequences of enabling the mail page in a connected build.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Aktivieren der Seite stellt keine Verbindung her. Jeden Account fügen Sie selbst hinzu und erlauben ihn einzeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
