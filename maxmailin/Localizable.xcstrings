    },
    "The file is described from its OpenPGP packet headers; mailin keeps public keys only, so a password cannot open it here" : {
      "comment" : "A description of why the OpenPGP file cannot be opened.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei wird anhand ihrer OpenPGP-Paketköpfe beschrieben; mailin speichert nur öffentliche Schlüssel, daher kann ein Passwort sie hier nicht öffnen"
          }
        },
        "es" : {
          "stringUnit" : {
