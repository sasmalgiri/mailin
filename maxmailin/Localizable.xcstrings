        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साक्ष्य टैग करें, अखंडता हैश सत्यापित करें और अपना ऑडिट ट्रेल बनाएँ"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagga le prove, verifica gli hash di integrità e costruisci il tuo registro di audit"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "証拠にタグ付けし、完全性ハッシュを検証し、監査証跡を構築する"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "증거에 태그하고, 무결성 해시를 검증하고, 감사 추적을 구축하세요"
