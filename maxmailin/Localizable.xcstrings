    "Trends and patterns are based on %@ emails spread evenly across all %@ in the archive." : {
      "comment" : "A description of how a sample of emails is spread across the total number of emails. The first argument is the number of emails in the sample. The second argument is the total number of emails. The third argument is optional, and is a description of the sample, e.g. \"including the first 10%\".",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trends und Muster beruhen auf %@ E-Mails, gleichmäßig verteilt über alle %@ im Archiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trends and patterns are based on %1$@ emails spread evenly across all %2$@ in the archive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tendencias y patrones se basan en %@ correos repartidos uniformemente entre los %@ del archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendances et schémas reposent sur %@ e-mails répartis uniformément parmi les %@ de l’archive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रुझान और पैटर्न आर्काइव के सभी %2$@ में समान रूप से फैले %1$@ ईमेल पर आधारित हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendenze e schemi si basano su %@ email distribuite in modo uniforme tra tutte le %@ dell’archivio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傾向とパターンは、アーカイブ内の %2$@ 件全体に均等に分散した %1$@ 件のメールに基づきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추세와 패턴은 보관함의 %2$@개 전체에 고르게 분산된 이메일 %1$@개를 기준으로 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendências e padrões se baseiam em %@ e-mails distribuídos uniformemente entre todos os %@ do arquivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "趋势和模式基于在归档全部 %2$@ 封中均匀分布的 %1$@ 封邮件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "趨勢和模式依據在封存全部 %2$@ 封中平均分佈的 %1$@ 封郵件。"
          }
        }
      }
    },
    "Triage a pile of tips into real leads — ingest, cluster by theme, prioritize, and start the story." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Stapel Hinweise zu echten Spuren sichten — aufnehmen, nach Thema bündeln, priorisieren und die Geschichte beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clasificar un montón de pistas en indicios reales — ingerir, agrupar por tema, priorizar y empezar la historia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trier une pile de tuyaux en vraies pistes — ingérer, regrouper par thème, prioriser et lancer le récit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सूचनाओं के ढेर को असली सुरागों में छाँटें — लें, विषय के अनुसार समूहित करें, प्राथमिकता दें और कहानी शुरू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smistare una pila di segnalazioni in piste reali — acquisire, raggruppare per tema, dare priorità e iniziare la storia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山積みの情報提供を本当の手がかりに選別 — 取り込み、テーマ別にまとめ、優先順位を付けてストーリーを始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쌓인 제보를 실제 단서로 분류 — 수집하고, 주제별로 묶고, 우선순위를 정하고, 기사를 시작합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triar uma pilha de dicas em pistas reais — ingerir, agrupar por tema, priorizar e começar a história."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将一堆线索分拣为真正的线索 — 收录、按主题聚类、排定优先级，然后开始报道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將一堆爆料分揀為真正的線索 — 收錄、依主題歸群、排定優先順序，然後開始報導。"
          }
        }
      }
    },
    "Triage Verdict" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
