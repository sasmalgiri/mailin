    },
    "No account, no mail servers, no data collection. Your archive never leaves your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Konto, keine Mailserver, keine Datenerfassung. Dein Archiv verlässt dein Gerät nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta, sin servidores de correo, sin recopilación de datos. Tu archivo nunca sale de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun compte, aucun serveur de messagerie, aucune collecte de données. Votre archive ne quitte jamais votre appareil."
          }
