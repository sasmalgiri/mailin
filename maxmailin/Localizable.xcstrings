    "Answers cite the exact messages they came from, and every citation reopens the original" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworten zitieren genau die Nachrichten, aus denen sie stammen, und jedes Zitat öffnet das Original erneut"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas citan los mensajes exactos de los que proceden, y cada cita reabre el original"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses citent les messages exacts dont elles proviennent, et chaque citation rouvre l'original"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उत्तर ठीक उन्हीं संदेशों को उद्धृत करते हैं जिनसे वे आए, और हर उद्धरण मूल को फिर खोलता है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risposte citano i messaggi esatti da cui provengono e ogni citazione riapre l'originale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答は出典となる正確なメッセージを引用し、各引用から元のメッセージを再び開けます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답변은 출처가 된 정확한 메시지를 인용하며, 모든 인용은 원본을 다시 엽니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As respostas citam as mensagens exatas de onde vieram, e cada citação reabre o original"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答会引用其来源的确切邮件，每条引用都可重新打开原文"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答會引用其來源的確切訊息，每條引用都可重新開啟原文"
          }
        }
      }
    },
    "Answers that need writing or summarizing use the on-device model." : {
      "comment" : "A description of the Apple Intelligence feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworten, die geschrieben oder zusammengefasst werden müssen, nutzen das Modell auf dem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas que requieren redactar o resumir usan el modelo del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
