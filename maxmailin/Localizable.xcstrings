    "Actions like importing files, tagging evidence, issuing triage verdicts and verifying hashes are recorded here automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktionen wie das Importieren von Dateien, das Taggen von Beweisen, Triage-Urteile und das Prüfen von Hashes werden hier automatisch aufgezeichnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acciones como importar archivos, etiquetar evidencia, emitir veredictos de triaje y verificar hashes se registran aquí automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les actions telles que l'import de fichiers, le marquage de preuves, les verdicts de triage et la vérification des hachages sont consignées ici automatiquement."
          }
