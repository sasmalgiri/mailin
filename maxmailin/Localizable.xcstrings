    "Lifetime purchase: it never expires and never renews. No subscription is needed to keep this access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebenslanger Kauf: läuft nie ab und verlängert sich nie. Kein Abonnement nötig, um diesen Zugang zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra de por vida: nunca caduca ni se renueva. No se necesita suscripción para conservar este acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achat à vie : il n'expire jamais et ne se renouvelle jamais. Aucun abonnement n'est nécessaire pour conserver cet accès."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आजीवन खरीद: कभी समाप्त नहीं होती और कभी नवीनीकृत नहीं होती। इस पहुँच को बनाए रखने के लिए किसी सदस्यता की ज़रूरत नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acquisto a vita: non scade e non si rinnova mai. Non serve alcun abbonamento per mantenere questo accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライフタイム購入: 期限切れも更新もありません。このアクセスを維持するためにサブスクリプションは不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평생 구입: 만료되거나 갱신되지 않습니다. 이 접근 권한을 유지하는 데 구독이 필요하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra vitalícia: nunca expira e nunca renova. Nenhuma assinatura é necessária para manter este acesso."
          }
