    "Live integrity check: every entry's hash is recomputed and compared against the chain. Green means the log is exactly as written." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Integritätsprüfung: Der Hash jedes Eintrags wird neu berechnet und mit der Kette verglichen. Grün bedeutet, das Protokoll ist exakt so wie geschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprobación de integridad en vivo: se recalcula el hash de cada entrada y se compara con la cadena. Verde significa que el registro está exactamente como se escribió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôle d'intégrité en direct : le hachage de chaque entrée est recalculé et comparé à la chaîne. Vert signifie que le journal est exactement tel qu'écrit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइव अखंडता जाँच: हर प्रविष्टि का हैश फिर से गणना कर श्रृंखला से मिलाया जाता है। हरा मतलब लॉग बिल्कुल वैसा है जैसा लिखा गया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controllo di integrità in tempo reale: l'hash di ogni voce viene ricalcolato e confrontato con la catena. Verde significa che il registro è esattamente come scritto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイム整合性チェック: 各エントリのハッシュを再計算し、チェーンと照合します。緑はログが書き込まれたままであることを示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 무결성 검사: 모든 항목의 해시를 다시 계산하여 체인과 비교합니다. 녹색은 로그가 기록된 그대로임을 의미합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificação de integridade ao vivo: o hash de cada entrada é recalculado e comparado com a cadeia. Verde significa que o registro está exatamente como foi gravado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时完整性检查：重新计算每条记录的哈希并与链比对。绿色表示日志与写入时完全一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時完整性檢查：重新計算每筆記錄的雜湊並與鏈比對。綠色表示記錄與寫入時完全一致。"
          }
        }
      }
    },
