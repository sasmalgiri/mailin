    "volume %lld of a split archive whose entry volume %@ is not attached to this message; nothing inside could be read" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teil %1$lld eines geteilten Archivs, dessen Eingangsteil %2$@ dieser Nachricht nicht angehängt ist; nichts darin konnte gelesen werden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "volumen %1$lld de un archivo dividido cuyo volumen de entrada %2$@ no está adjunto a este mensaje; no se pudo leer nada de su interior"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "volume %1$lld d'une archive fractionnée dont le volume d'entrée %2$@ n'est pas joint à ce message ; rien n'a pu être lu à l'intérieur"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसे विभाजित संग्रह का खंड %1$lld जिसका प्रवेश खंड %2$@ इस संदेश से संलग्न नहीं है; अंदर कुछ भी पढ़ा नहीं जा सका"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "volume %1$lld di un archivio suddiviso il cui volume d'ingresso %2$@ non è allegato a questo messaggio; nulla all'interno ha potuto essere letto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割アーカイブのボリューム %1$lld。入口となるボリューム %2$@ がこのメッセージに添付されていないため、中身は何も読み取れませんでした"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분할 아카이브의 볼륨 %1$lld. 진입 볼륨 %2$@이(가) 이 메시지에 첨부되지 않아 안의 내용을 읽을 수 없었습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "volume %1$lld de um arquivo dividido cujo volume de entrada %2$@ não está anexado a esta mensagem; nada dentro pôde ser lido"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分卷压缩包的第 %1$lld 卷，其入口卷 %2$@ 未附加到此邮件；其中内容均无法读取"
