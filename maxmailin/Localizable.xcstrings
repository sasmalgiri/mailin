          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répare la dérive magasin/FTS après un plantage entre deux commits et fusionne les lignes FTS en double ; borné, redémarrable."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कमिट के बीच क्रैश के बाद स्टोर/FTS विचलन सुधारता है और डुप्लिकेट FTS पंक्तियों को समेटता है; सीमित, पुनरारंभ योग्य।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
