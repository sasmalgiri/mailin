    "Work the quarantine queue — analyze the held mail, verdict each one, and release the clean or hold the rest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Quarantäne-Warteschlange abarbeiten — zurückgehaltene E-Mails analysieren, jede beurteilen und die sauberen freigeben oder den Rest zurückhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabajar la cola de cuarentena — analizar el correo retenido, dictaminar cada uno y liberar los limpios o retener el resto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traiter la file de quarantaine — analyser le courrier retenu, statuer sur chacun et libérer les sains ou retenir le reste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्वारंटीन कतार पर काम करें — रोके गए मेल का विश्लेषण करें, हर एक पर निर्णय दें और साफ़ मेल जारी करें या बाकी रोके रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavorare la coda di quarantena — analizzare la posta trattenuta, decidere su ciascuna e rilasciare quelle pulite o trattenere il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隔離キューを処理 — 保留中のメールを分析し、1 通ずつ判定し、問題のないものは解放し、残りは保留します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "격리 대기열 처리 — 보류된 메일을 분석하고, 하나씩 판정하고, 깨끗한 것은 해제하고 나머지는 보류합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalhar a fila de quarentena — analisar o e-mail retido, decidir sobre cada um e liberar os limpos ou reter o restante."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "处理隔离队列 — 分析被扣留的邮件，逐一判定，放行干净的邮件，其余继续扣留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "處理隔離佇列 — 分析被扣留的郵件，逐一判定，放行乾淨的郵件，其餘繼續扣留。"
          }
        }
      }
    },
    "Work through each batch systematically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Stapel systematisch abarbeiten."
