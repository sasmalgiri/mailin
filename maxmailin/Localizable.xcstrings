          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在進行匯入。請等其完成或取消後再搬移封存。"
          }
        }
      }
    },
    "An indicator of compromise — a suspicious artifact (IP address, URL, file hash, domain) that suggests phishing, malware, or a breach attempt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kompromittierungsindikator — ein verdächtiges Artefakt (IP-Adresse, URL, Datei-Hash, Domain), das auf Phishing, Malware oder einen Einbruchsversuch hindeutet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un indicador de compromiso — un artefacto sospechoso (dirección IP, URL, hash de archivo, dominio) que sugiere phishing, malware o un intento de intrusión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un indicateur de compromission — un artefact suspect (adresse IP, URL, hachage de fichier, domaine) qui suggère un hameçonnage, un logiciel malveillant ou une tentative d'intrusion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समझौते का संकेतक — एक संदिग्ध कलाकृति (IP पता, URL, फ़ाइल हैश, डोमेन) जो फ़िशिंग, मैलवेयर या सेंध के प्रयास का संकेत देती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un indicatore di compromissione — un artefatto sospetto (indirizzo IP, URL, hash di file, dominio) che suggerisce phishing, malware o un tentativo di violazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "侵害の痕跡 — フィッシング、マルウェア、侵入の試みを示唆する疑わしいアーティファクト (IP アドレス、URL、ファイルハッシュ、ドメイン)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "침해 지표 — 피싱, 악성코드 또는 침입 시도를 시사하는 의심스러운 아티팩트(IP 주소, URL, 파일 해시, 도메인)입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um indicador de comprometimento — um artefato suspeito (endereço IP, URL, hash de arquivo, domínio) que sugere phishing, malware ou tentativa de invasão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入侵指标 — 暗示钓鱼、恶意软件或入侵企图的可疑痕迹（IP 地址、URL、文件哈希值、域名）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入侵指標 — 暗示網路釣魚、惡意軟體或入侵企圖的可疑痕跡（IP 位址、URL、檔案雜湊值、網域）。"
          }
        }
      }
    },
