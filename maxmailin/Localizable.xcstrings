    "Archive quality score: considers diversity of senders, threading rate, attachment presence, and content length balance" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivqualitätswert: berücksichtigt Vielfalt der Absender, Verknüpfungsrate, Vorhandensein von Anhängen und Ausgewogenheit der Inhaltslänge"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puntuación de calidad del archivo: considera la diversidad de remitentes, la tasa de conversaciones, la presencia de adjuntos y el equilibrio en la longitud del contenido"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Score de qualité de l'archive : prend en compte la diversité des expéditeurs, le taux de fils, la présence de pièces jointes et l'équilibre des longueurs de contenu"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संग्रह गुणवत्ता स्कोर: प्रेषकों की विविधता, थ्रेडिंग दर, अनुलग्नकों की उपस्थिति और सामग्री की लंबाई के संतुलन पर विचार करता है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punteggio di qualità dell'archivio: considera la varietà dei mittenti, il tasso di conversazioni, la presenza di allegati e l'equilibrio della lunghezza dei contenuti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブ品質スコア: 送信者の多様性、スレッド化率、添付ファイルの有無、内容の長さのバランスを考慮します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함 품질 점수: 발신자 다양성, 스레드 비율, 첨부 파일 유무, 내용 길이 균형을 고려합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pontuação de qualidade do arquivo: considera a diversidade de remetentes, a taxa de conversas, a presença de anexos e o equilíbrio no tamanho do conteúdo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
