    "Gmail sign-in is not set up in this build: it has no registered Google client ID. Add the account as IMAP instead, or use a build that has one." : {
      "comment" : "Text displayed in a warning banner at the top of the screen when the Gmail sign-in is not set up in this build.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gmail-Anmeldung ist in diesem Build nicht eingerichtet: Es ist keine Google-Client-ID registriert. Fügen Sie den Account stattdessen als IMAP hinzu oder verwenden Sie einen Build mit Client-ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión de Gmail no está configurado en esta compilación: no tiene un ID de cliente de Google registrado. Añade la cuenta como IMAP o usa una compilación que lo tenga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion Gmail n’est pas configurée dans cette version : aucun identifiant client Google n’est enregistré. Ajoutez plutôt le compte en IMAP, ou utilisez une version qui en possède un."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस बिल्ड में Gmail साइन-इन सेट नहीं है: इसमें कोई पंजीकृत Google क्लाइंट ID नहीं है। इसके बजाय खाता IMAP के रूप में जोड़ें, या ऐसा बिल्ड उपयोग करें जिसमें यह हो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso a Gmail non è configurato in questa build: non ha un ID client Google registrato. Aggiungi l’account come IMAP oppure usa una build che lo abbia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビルドでは Gmail のサインインが設定されていません。登録済みの Google クライアント ID がありません。代わりに IMAP としてアカウントを追加するか、クライアント ID のあるビルドを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 빌드에는 Gmail 로그인이 설정되어 있지 않습니다. 등록된 Google 클라이언트 ID가 없습니다. 대신 IMAP으로 계정을 추가하거나 클라이언트 ID가 있는 빌드를 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O login do Gmail não está configurado nesta versão: ela não tem um ID de cliente do Google registrado. Adicione a conta como IMAP ou use uma versão que tenha um."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本未设置 Gmail 登录：没有已注册的 Google 客户端 ID。请改为以 IMAP 添加账户，或使用具有客户端 ID 的版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本未設定 Gmail 登入：沒有已註冊的 Google 用戶端 ID。請改以 IMAP 加入帳號，或使用具有用戶端 ID 的版本。"
          }
        }
      }
    },
