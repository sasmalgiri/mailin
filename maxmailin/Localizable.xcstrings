    "No account, no mail servers, no data collection. Your archive stays on your device by default — optional Cloud AI is opt-in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Konto, keine Mailserver, keine Datenerfassung. Ihr Archiv bleibt standardmäßig auf Ihrem Gerät — optionale Cloud-KI ist Opt-in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta, sin servidores de correo, sin recopilación de datos. Tu archivo permanece en tu dispositivo de forma predeterminada — la IA en la nube opcional requiere activación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun compte, aucun serveur de messagerie, aucune collecte de données. Votre archive reste sur votre appareil par défaut — l'IA cloud facultative est sur adhésion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई खाता नहीं, कोई मेल सर्वर नहीं, कोई डेटा संग्रह नहीं। आपका संग्रह डिफ़ॉल्ट रूप से आपके डिवाइस पर रहता है — वैकल्पिक क्लाउड AI ऑप्ट-इन है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun account, nessun server di posta, nessuna raccolta dati. Il tuo archivio resta sul tuo dispositivo per impostazione predefinita — l'IA cloud opzionale richiede adesione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントなし、メールサーバなし、データ収集なし。アーカイブはデフォルトでデバイス上に留まります — オプションのクラウド AI はオプトインです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 없음, 메일 서버 없음, 데이터 수집 없음. 아카이브는 기본적으로 기기에 머뭅니다 — 선택적 클라우드 AI는 옵트인입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conta, sem servidores de e-mail, sem coleta de dados. Seu arquivo permanece no seu dispositivo por padrão — a IA na nuvem opcional é por adesão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无账户、无邮件服务器、无数据收集。您的归档默认留在设备上 — 可选的云端 AI 需要选择启用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無帳號、無郵件伺服器、無資料收集。您的封存預設留在裝置上 — 選用的雲端 AI 需要選擇啟用。"
          }
        }
      }
    },
