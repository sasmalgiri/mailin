    "Import MBOX, EML, EMLX, MSG, PST, OST, and NSF email archives. Drag-and-drop or use File > Open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MBOX-, EML-, EMLX-, MSG-, PST-, OST- und NSF-E-Mail-Archive importieren. Per Drag-and-drop oder über Ablage > Öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
