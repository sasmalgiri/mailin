        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドでインデックス作成中 — 添付ファイルの内容は順次検索できるようになります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드에서 인덱싱 중 — 첨부 파일 내용은 진행되는 대로 검색할 수 있게 됩니다"
          }
        },
