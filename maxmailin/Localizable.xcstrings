    "One local notification per week with new-match counts for your saved searches. Computed entirely on-device; nothing leaves your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine lokale Mitteilung pro Woche mit der Zahl neuer Treffer für Ihre gesicherten Suchen. Vollständig auf dem Gerät berechnet; nichts verlässt Ihr Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notificación local por semana con el número de nuevas coincidencias de tus búsquedas guardadas. Calculada por completo en el dispositivo; nada sale de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une notification locale par semaine avec le nombre de nouvelles correspondances pour vos recherches enregistrées. Calculée entièrement sur l'appareil ; rien ne quitte votre appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सहेजी खोजों के नए मिलानों की संख्या के साथ प्रति सप्ताह एक स्थानीय सूचना। पूरी तरह डिवाइस पर गणना; कुछ भी आपके डिवाइस से बाहर नहीं जाता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notifica locale a settimana con il numero di nuove corrispondenze per le tue ricerche salvate. Calcolata interamente sul dispositivo; nulla lascia il tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済み検索の新着一致数を週 1 回ローカル通知でお知らせします。完全にデバイス上で計算され、デバイスの外には何も出ません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 검색의 새 일치 수를 담은 로컬 알림을 일주일에 한 번 보냅니다. 전적으로 기기에서 계산되며 기기 밖으로 아무것도 나가지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma notificação local por semana com a contagem de novas correspondências das suas buscas salvas. Calculada inteiramente no dispositivo; nada sai do seu dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周一条本地通知，包含您已存搜索的新匹配数量。完全在设备上计算；不会有任何内容离开您的设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每週一則本機通知，包含您已儲存搜尋的新相符數量。完全在裝置上計算；不會有任何內容離開您的裝置。"
          }
        }
      }
    },
