    "Answers cite the exact messages they came from, and every citation reopens the original" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworten zitieren genau die Nachrichten, aus denen sie stammen, und jedes Zitat öffnet das Original erneut"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas citan los mensajes exactos de los que proceden, y cada cita reabre el original"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses citent les messages exacts dont elles proviennent, et chaque citation rouvre l'original"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उत्तर ठीक उन्हीं संदेशों को उद्धृत करते हैं जिनसे वे आए, और हर उद्धरण मूल को फिर खोलता है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risposte citano i messaggi esatti da cui provengono e ogni citazione riapre l'originale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答は出典となる正確なメッセージを引用し、各引用から元のメッセージを再び開けます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답변은 출처가 된 정확한 메시지를 인용하며, 모든 인용은 원본을 다시 엽니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As respostas citam as mensagens exatas de onde vieram, e cada citação reabre o original"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答会引用其来源的确切邮件，每条引用都可重新打开原文"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答會引用其來源的確切訊息，每條引用都可重新開啟原文"
          }
        }
      }
    },
    "Answers that need writing or summarizing use the on-device model." : {
      "comment" : "A description of the Apple Intelligence feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworten, die geschrieben oder zusammengefasst werden müssen, nutzen das Modell auf dem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas que requieren redactar o resumir usan el modelo del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses à rédiger ou à résumer utilisent le modèle de l’appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन जवाबों को लिखना या सारांश बनाना होता है, वे डिवाइस पर मौजूद मॉडल का इस्तेमाल करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risposte che vanno scritte o riassunte usano il modello sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文章の作成や要約が必要な回答には、デバイス上のモデルを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작성하거나 요약해야 하는 답변은 기기 내 모델을 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respostas que precisam ser escritas ou resumidas usam o modelo do dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要撰写或总结的回答会使用设备端模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要撰寫或摘要的回答會使用裝置上的模型。"
          }
        }
      }
    },
    "Answers use on-device analysis only — counts, search and lists still work." : {
      "comment" : "A description of the Apple Intelligence feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworten nutzen nur die Analyse auf dem Gerät – Zählungen, Suche und Listen funktionieren weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas solo usan el análisis en el dispositivo: los recuentos, la búsqueda y las listas siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses n’utilisent que l’analyse sur l’appareil – les décomptes, la recherche et les listes fonctionnent toujours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जवाब केवल डिवाइस पर विश्लेषण का इस्तेमाल करते हैं — गिनती, खोज और सूचियाँ फिर भी काम करती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risposte usano solo l’analisi sul dispositivo: conteggi, ricerca ed elenchi funzionano comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答はデバイス上の分析のみを使います。件数、検索、一覧は引き続き使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답변은 기기 내 분석만 사용합니다. 개수 세기, 검색, 목록은 계속 작동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As respostas usam apenas a análise no dispositivo — contagens, busca e listas continuam funcionando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答仅使用设备端分析——计数、搜索和列表仍然可用。"
