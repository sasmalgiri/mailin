    "The surface is hidden. Work already saved is kept and returns unchanged when this is switched back on." : {
      "comment" : "What happens to existing work when a feature is switched back on.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Oberfläche ist ausgeblendet. Bereits gesicherte Arbeit bleibt erhalten und kehrt unverändert zurück, wenn dies wieder eingeschaltet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La superficie está oculta. El trabajo ya guardado se conserva y vuelve sin cambios cuando esto se vuelve a activar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La surface est masquée. Le travail déjà enregistré est conservé et revient inchangé lorsque ceci est réactivé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सतह छिपी है। पहले से सहेजा काम रखा जाता है और इसे फिर चालू करने पर अपरिवर्तित लौटता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La superficie è nascosta. Il lavoro già salvato viene conservato e torna invariato quando questo viene riattivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この画面は非表示です。保存済みの作業は保持され、再度オンにすると変更なしで戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면이 숨겨져 있습니다. 이미 저장된 작업은 유지되며 다시 켜면 변경 없이 돌아옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A superfície está oculta. O trabalho já salvo é mantido e retorna inalterado quando isto for religado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
