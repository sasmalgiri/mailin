        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर %@ दस्तावेज़ को एक स्प्रेडशीट में लाएँ — प्रति दस्तावेज़ एक पंक्ति, हर फ़ील्ड के लिए एक कॉलम। Excel/Numbers में निर्यात करें।"
