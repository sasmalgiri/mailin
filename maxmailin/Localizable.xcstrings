    "Communication frequency weight — higher values indicate more frequent correspondence" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewichtung der Kommunikationshäufigkeit — höhere Werte bedeuten häufigeren Schriftverkehr"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peso de la frecuencia de comunicación — valores más altos indican correspondencia más frecuente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pondération de la fréquence de communication — des valeurs plus élevées indiquent des échanges plus fréquents"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संचार आवृत्ति भार — उच्च मान अधिक बार पत्राचार दर्शाते हैं"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peso della frequenza di comunicazione — valori più alti indicano corrispondenza più frequente"
