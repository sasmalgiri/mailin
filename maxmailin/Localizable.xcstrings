        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये हैश पुनर्निर्मित स्रोत के हैं, कैप्चर किए गए मूल बाइट के नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
