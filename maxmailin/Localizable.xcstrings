    "Subscribe monthly or yearly, or buy once for lifetime access. Prices are shown by the App Store in your currency." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monatlich oder jährlich abonnieren oder einmal für lebenslangen Zugang kaufen. Preise zeigt der App Store in Ihrer Währung an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suscríbete mensual o anualmente, o compra una vez para acceso de por vida. El App Store muestra los precios en tu moneda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnez-vous mensuellement ou annuellement, ou achetez une fois pour un accès à vie. Les prix sont affichés par l'App Store dans votre devise."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मासिक या वार्षिक सदस्यता लें, या लाइफ़टाइम पहुँच के लिए एक बार खरीदें। कीमतें App Store द्वारा आपकी मुद्रा में दिखाई जाती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbonati mensilmente o annualmente, oppure acquista una volta per l'accesso a vita. I prezzi sono mostrati dall'App Store nella tua valuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月額または年額で購読するか、1 回の購入でライフタイムアクセスを取得できます。価格は App Store がお住まいの通貨で表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "월간 또는 연간으로 구독하거나 한 번 구매하여 평생 이용하세요. 가격은 App Store에서 사용자의 통화로 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assine mensal ou anualmente, ou compre uma vez para acesso vitalício. Os preços são exibidos pela App Store na sua moeda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按月或按年订阅，或一次性购买获得终身访问。价格由 App Store 以您的货币显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按月或按年訂閱，或一次性購買取得終身存取。價格由 App Store 以您的貨幣顯示。"
          }
        }
      }
    },
