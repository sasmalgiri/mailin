    "Build a story from a leak the honest way — verify provenance, annotate cited findings, compile and fact-check a sourced draft." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus einem Leak auf ehrliche Weise eine Geschichte machen — Herkunft prüfen, zitierte Befunde annotieren, einen belegten Entwurf zusammenstellen und gegenprüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construir una historia a partir de una filtración de forma honesta — verificar la procedencia, anotar hallazgos citados, compilar y verificar un borrador con fuentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construire un récit à partir d'une fuite de façon honnête — vérifier la provenance, annoter les constats cités, compiler et vérifier un brouillon sourcé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लीक से ईमानदारी से कहानी बनाएँ — स्रोत सत्यापित करें, उद्धृत निष्कर्षों पर टिप्पणी करें, स्रोतयुक्त मसौदा तैयार करें और तथ्य-जाँच करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costruire una storia da una fuga di notizie in modo onesto — verificare la provenienza, annotare i riscontri citati, compilare e verificare una bozza con fonti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リークから誠実にストーリーを構築 — 出所を確認し、引用した所見に注釈を付け、出典付きの草稿をまとめて事実確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유출 자료로 정직하게 기사 작성 — 출처를 확인하고, 인용한 발견에 주석을 달고, 출처가 있는 초안을 정리해 사실 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construir uma história a partir de um vazamento de forma honesta — verificar a procedência, anotar achados citados, compilar e checar um rascunho com fontes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以诚实的方式从泄露材料中构建报道 — 核实来源、标注引用的发现、汇编并核查有出处的草稿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以誠實的方式從洩漏資料建構報導 — 查核來源、標注引用的發現、彙整並查核有出處的草稿。"
          }
        }
      }
    },
