            "value" : "ईमेल को वैसे टैग करें जैसे आप उनके बारे में सोचते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagga le email nel modo in cui TU le pensi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなた自身の考え方でメールにタグ付けします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신이 생각하는 방식대로 이메일에 태그하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquete os e-mails do jeito que VOCÊ pensa neles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按照您自己的思路为邮件添加标签。"
