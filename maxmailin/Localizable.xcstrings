            "value" : "Clave eliminada. Las firmas de %lld mensajes se comprobarán de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clé supprimée. Les signatures de %lld messages seront revérifiées."
