    "Opt-in, resumable on-device sentence vectors for Ask; runs only with the switch on and Page 2 enabled." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opt-in, fortsetzbare Satzvektoren auf dem Gerät für „Fragen“; läuft nur mit eingeschaltetem Schalter und aktivierter Seite 2."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vectores de oración en el dispositivo, opcionales y reanudables, para Preguntar; solo se ejecuta con el interruptor activado y la Página 2 habilitada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vecteurs de phrases sur l'appareil, sur adhésion et reprenables, pour Demander ; ne s'exécute qu'avec l'interrupteur activé et la page 2 activée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूछें के लिए ऑप्ट-इन, पुनरारंभ योग्य ऑन-डिवाइस वाक्य वेक्टर; केवल स्विच चालू और पेज 2 सक्षम होने पर चलता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vettori di frase sul dispositivo, opzionali e riprendibili, per Chiedi; in esecuzione solo con l'interruttore attivo e la Pagina 2 abilitata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「質問」用のオプトインで再開可能なオンデバイス文ベクトル。スイッチがオンでページ 2 が有効な場合のみ実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "질문하기를 위한 옵트인, 재개 가능한 기기 내 문장 벡터. 스위치가 켜져 있고 2페이지가 활성화된 경우에만 실행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vetores de sentença no dispositivo, por adesão e retomáveis, para Perguntar; executa apenas com o interruptor ligado e a Página 2 ativada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于“提问”的可选、可恢复的设备端句向量；仅在开关打开且第 2 页启用时运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於「提問」的選用、可繼續的裝置端句向量；僅在開關開啟且第 2 頁啟用時執行。"
          }
        }
      }
    },
