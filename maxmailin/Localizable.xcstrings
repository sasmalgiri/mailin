          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將重置所有階段、檢查清單和備註。此操作無法還原。"
          }
        }
      }
    },
    "This will restore all settings to their defaults. Your email data will not be affected." : {
      "localizations" : {
