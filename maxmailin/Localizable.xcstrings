    "SHA-256 hash verification, evidence tagging, Bates numbering, audit logs, and chain of custody tracking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256-Hash-Verifizierung, Beweis-Tagging, Bates-Nummerierung, Prüfprotokolle und Beweiskettenverfolgung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificación de hash SHA-256, etiquetado de evidencia, numeración Bates, registros de auditoría y seguimiento de la cadena de custodia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérification des hachages SHA-256, étiquetage des preuves, numérotation Bates, journaux d'audit et suivi de la chaîne de conservation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256 हैश सत्यापन, साक्ष्य टैगिंग, Bates क्रमांकन, ऑडिट लॉग और अभिरक्षा श्रृंखला ट्रैकिंग।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica hash SHA-256, tagging delle prove, numerazione Bates, registri di audit e tracciamento della catena di custodia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256 ハッシュ検証、証拠タグ付け、Bates 番号付け、監査ログ、証拠の連鎖の追跡。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256 해시 검증, 증거 태깅, Bates 번호 매기기, 감사 로그 및 보관 연속성 추적."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificação de hash SHA-256, etiquetagem de evidências, numeração Bates, registros de auditoria e rastreamento da cadeia de custódia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256 哈希验证、证据标记、Bates 编号、审计日志和证据链跟踪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256 雜湊驗證、證據標記、Bates 編號、稽核記錄和監管鏈追蹤。"
          }
        }
      }
    },
    "SHA-256 hashes computed and sealed for %lld email(s). %lld previously sealed email(s) verified intact. Run again to confirm all baselines." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256-Hashes für %1$lld E-Mail(s) berechnet und versiegelt. %2$lld zuvor versiegelte E-Mail(s) als intakt verifiziert. Erneut ausführen, um alle Basiswerte zu bestätigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SHA-256 hashes computed and sealed for %1$lld email(s). %2$lld previously sealed email(s) verified intact. Run again to confirm all baselines."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hashes SHA-256 calculados y sellados para %1$lld correo(s). %2$lld correo(s) sellado(s) anteriormente verificado(s) intacto(s). Ejecuta de nuevo para confirmar todas las líneas base."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hachages SHA-256 calculés et scellés pour %1$lld e-mail(s). %2$lld e-mail(s) précédemment scellé(s) vérifié(s) intact(s). Relancez pour confirmer toutes les références."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld ईमेल के लिए SHA-256 हैश की गणना और सील की गई। पहले सील किए गए %2$lld ईमेल अक्षुण्ण सत्यापित। सभी आधार रेखाओं की पुष्टि के लिए फिर चलाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hash SHA-256 calcolati e sigillati per %1$lld email. %2$lld email sigillate in precedenza verificate intatte. Esegui di nuovo per confermare tutte le baseline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld 件のメールの SHA-256 ハッシュを計算して封印しました。以前に封印された %2$lld 件のメールが無傷であることを検証しました。すべてのベースラインを確認するには再度実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일 %1$lld개의 SHA-256 해시를 계산하고 봉인했습니다. 이전에 봉인된 이메일 %2$lld개가 온전한 것으로 확인되었습니다. 모든 기준선을 확인하려면 다시 실행하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hashes SHA-256 calculados e selados para %1$lld e-mail(s). %2$lld e-mail(s) selado(s) anteriormente verificado(s) intacto(s). Execute novamente para confirmar todas as linhas de base."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已为 %1$lld 封邮件计算并封印 SHA-256 哈希值。已验证先前封印的 %2$lld 封邮件完好无损。再次运行以确认所有基线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已為 %1$lld 封郵件計算並封印 SHA-256 雜湊值。已驗證先前封印的 %2$lld 封郵件完好無損。再次執行以確認所有基準。"
          }
        }
      }
    },
