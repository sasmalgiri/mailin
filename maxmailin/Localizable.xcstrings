    "Turn a period's triage activity into an executive security briefing — metrics, trends, report." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Triage-Aktivität eines Zeitraums in ein Sicherheits-Briefing für die Leitung verwandeln — Kennzahlen, Trends, Bericht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertir la actividad de clasificación de un período en un informe ejecutivo de seguridad — métricas, tendencias, informe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformer l'activité de tri d'une période en briefing sécurité pour la direction — indicateurs, tendances, rapport."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी अवधि की ट्राइएज गतिविधि को कार्यकारी सुरक्षा ब्रीफ़िंग में बदलें — मेट्रिक्स, रुझान, रिपोर्ट।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasformare l'attività di triage di un periodo in un briefing di sicurezza per la direzione — metriche, tendenze, report."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期間中のトリアージ活動を経営向けセキュリティブリーフィングに — 指標、傾向、レポート。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기간 중 분류 활동을 경영진 보안 브리핑으로 — 지표, 추세, 보고서."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformar a atividade de triagem de um período em um briefing executivo de segurança — métricas, tendências, relatório."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将一段时期的分诊活动整理成面向管理层的安全简报 — 指标、趋势、报告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將一段期間的分流活動整理成給管理層的安全簡報 — 指標、趨勢、報告。"
          }
        }
      }
    },
