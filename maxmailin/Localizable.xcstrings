    "mailin is remembering %lld deleted email%@ so re-importing the same file won't bring them back. Forget them to allow re-importing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin merkt sich %1$lld gelöschte E-Mail%2$@, damit ein erneuter Import derselben Datei sie nicht zurückbringt. Vergessen Sie sie, um den erneuten Import zu erlauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "mailin is remembering %1$lld deleted email%2$@ so re-importing the same file won't bring them back. Forget them to allow re-importing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin recuerda %1$lld correo%2$@ eliminado(s) para que volver a importar el mismo archivo no los recupere. Olvídalos para permitir la reimportación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin mémorise %1$lld e-mail%2$@ supprimé(s) pour qu'une réimportation du même fichier ne les ramène pas. Oubliez-les pour autoriser la réimportation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin %1$lld हटाए गए ईमेल%2$@ याद रख रहा है ताकि वही फ़ाइल फिर आयात करने पर वे वापस न आएँ। पुनः आयात की अनुमति के लिए उन्हें भूल जाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin ricorda %1$lld email%2$@ eliminate così reimportare lo stesso file non le riporterà indietro. Dimenticale per consentire la reimportazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin は削除した %1$lld 件のメール%2$@を記憶しており、同じファイルを再読み込みしても戻りません。再読み込みを許可するには忘れさせてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin은 삭제된 이메일 %1$lld개%2$@를 기억하여 같은 파일을 다시 가져와도 되돌아오지 않게 합니다. 다시 가져오려면 잊기를 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mailin está lembrando %1$lld e-mail%2$@ apagado(s) para que reimportar o mesmo arquivo não os traga de volta. Esqueça-os para permitir a reimportação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin 正在记住 %1$lld 封已删除邮件%2$@，以便重新导入同一文件时不会将其带回。忘记它们即可允许重新导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin 正在記住 %1$lld 封已刪除郵件%2$@，以便重新匯入同一檔案時不會將其帶回。忘記它們即可允許重新匯入。"
          }
        }
      }
    },
