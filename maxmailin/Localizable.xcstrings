    "Microsoft sign-in is not set up in this build: it has no registered Microsoft app ID and redirect address." : {
      "comment" : "Text displayed in a notification when a Microsoft account is not configured.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Microsoft-Anmeldung ist in diesem Build nicht eingerichtet: Es sind keine registrierte Microsoft-App-ID und keine Weiterleitungsadresse vorhanden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión de Microsoft no está configurado en esta compilación: no tiene un ID de aplicación de Microsoft registrado ni una dirección de redirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion Microsoft n’est pas configurée dans cette version : aucun identifiant d’app Microsoft ni adresse de redirection n’est enregistré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस बिल्ड में Microsoft साइन-इन सेट नहीं है: इसमें कोई पंजीकृत Microsoft ऐप ID और रीडायरेक्ट पता नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso Microsoft non è configurato in questa build: non ha un ID app Microsoft registrato né un indirizzo di reindirizzamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビルドでは Microsoft のサインインが設定されていません。登録済みの Microsoft アプリ ID とリダイレクトアドレスがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 빌드에는 Microsoft 로그인이 설정되어 있지 않습니다. 등록된 Microsoft 앱 ID와 리디렉션 주소가 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O login da Microsoft não está configurado nesta versão: ela não tem um ID de app da Microsoft registrado nem um endereço de redirecionamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
