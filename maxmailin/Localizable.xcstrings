            "value" : "La récupération approfondie analyse aussi l’espace inutilisé de %@ de données PST/OST — environ %lld à %lld s de plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डीप रिकवरी %@ PST/OST डेटा की खाली जगह भी स्कैन करती है — लगभग %lld–%lld से. और।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il recupero approfondito analizza anche lo spazio inutilizzato di %@ di dati PST/OST — circa %lld–%lld s in più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細復元では %@ の PST/OST データの未使用領域も調べます（約 %lld～%lld 秒追加）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정밀 복구는 %@ PST/OST 데이터의 미사용 공간도 검사합니다 — 약 %lld~%lld초 더 걸립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A recuperação profunda também examina o espaço não usado de %@ de dados PST/OST — cerca de %lld–%lld s a mais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深度恢复还会扫描 %@ PST/OST 数据中的未用空间——约多 %lld–%lld 秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深度復原還會掃描 %@ PST/OST 資料中的未用空間——約多 %lld–%lld 秒。"
          }
        }
      }
    },
