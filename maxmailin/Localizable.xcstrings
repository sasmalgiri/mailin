          }
        }
      }
    },
    "The Free plan imports up to %@ of input in total. This archive already holds %@; these files would add %@, %@ remain. Personal and Professional have no input limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Free-Plan importiert insgesamt bis zu %1$@ an Eingabedaten. Dieses Archiv enthält bereits %2$@; diese Dateien würden %3$@ hinzufügen, %4$@ verbleiben. Personal und Professional haben kein Eingabelimit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan Free importa hasta %1$@ de entrada en total. Este archivo ya contiene %2$@; estos archivos añadirían %3$@, quedan %4$@. Personal y Professional no tienen límite de entrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le forfait Free importe jusqu'à %1$@ de données au total. Cette archive contient déjà %2$@ ; ces fichiers ajouteraient %3$@, il reste %4$@. Personal et Professional n'ont pas de limite d'import."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निःशुल्क प्लान कुल मिलाकर %1$@ तक इनपुट आयात करता है। इस आर्काइव में पहले से %2$@ है; ये फ़ाइलें %3$@ जोड़ेंगी, %4$@ शेष रहेगा। Personal और Professional की कोई इनपुट सीमा नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il piano Free importa fino a %1$@ di dati in totale. Questo archivio contiene già %2$@; questi file aggiungerebbero %3$@, restano %4$@. Personal e Professional non hanno limiti di importazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料プランで読み込める入力は合計 %1$@ までです。このアーカイブにはすでに %2$@ あり、これらのファイルで %3$@ 増えます。残りは %4$@ です。Personal と Professional には入力の上限はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 플랜은 입력을 총 %1$@까지 가져옵니다. 이 아카이브에는 이미 %2$@가 있으며, 이 파일들이 %3$@를 추가하고 %4$@가 남습니다. Personal과 Professional은 입력 한도가 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plano Free importa até %1$@ de entrada no total. Este arquivo já contém %2$@; estes arquivos adicionariam %3$@, restam %4$@. Personal e Professional não têm limite de entrada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费方案总共最多导入 %1$@ 的输入。此归档已包含 %2$@；这些文件将增加 %3$@，剩余 %4$@。Personal 和 Professional 没有输入限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免費方案總共最多匯入 %1$@ 的輸入。此封存已包含 %2$@；這些檔案將增加 %3$@，剩餘 %4$@。Personal 與 Professional 沒有輸入限制。"
          }
        }
      }
    },
