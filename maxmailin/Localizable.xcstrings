          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仪表板、统计、附件、主题和 IT 安全数据，均从分析索引针对整个归档计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
