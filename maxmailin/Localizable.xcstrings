    "Documents never leave your device. Privilege review stays confidential." : {
      "comment" : "Privacy note for the Legal persona.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumente verlassen dein Gerät nie. Die Prüfung auf Vertraulichkeitsprivilegien bleibt vertraulich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los documentos nunca salen de tu dispositivo. La revisión de privilegios sigue siendo confidencial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les documents ne quittent jamais votre appareil. L'examen du secret professionnel reste confidentiel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दस्तावेज़ कभी आपके डिवाइस से बाहर नहीं जाते। प्रिविलेज समीक्षा गोपनीय रहती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I documenti non lasciano mai il tuo dispositivo. La revisione del privilegio resta riservata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文書がデバイスの外に出ることはありません。秘匿特権のレビューは機密のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문서는 기기 밖으로 나가지 않습니다. 특권 검토는 기밀로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os documentos nunca saem do seu dispositivo. A revisão de privilégio continua confidencial."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文档绝不会离开你的设备。特权审查保持机密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件絕不會離開你的裝置。特權審查保持機密。"
          }
        }
      }
    },
    "Documents never leave your Mac. Privilege review stays confidential." : {
      "extractionState" : "stale",
