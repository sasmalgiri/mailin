    "Hide this group from the list. Nothing is deleted — Reset View shows it again." : {
      "comment" : "A button that hides a group of near-duplicate emails from the list.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Gruppe in der Liste ausblenden. Es wird nichts gelöscht – „Ansicht zurücksetzen“ zeigt sie wieder an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta este grupo de la lista. No se elimina nada: Restablecer vista lo vuelve a mostrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque ce groupe dans la liste. Rien n’est supprimé – Réinitialiser la vue l’affiche à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस समूह को सूची से छिपाएँ। कुछ भी हटाया नहीं जाता — दृश्य रीसेट करें इसे फिर से दिखाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde questo gruppo dall’elenco. Non viene eliminato nulla: Reimposta vista lo mostra di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このグループを一覧から隠します。何も削除されません — 「表示をリセット」で再び表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 그룹을 목록에서 숨깁니다. 아무것도 삭제되지 않습니다 — 보기 재설정으로 다시 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
