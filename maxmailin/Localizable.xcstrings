        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Pro pour accéder à l'analyse forensique, à l'étiquetage des preuves, à la conservation légale, à la numérotation Bates et aux outils d'e-discovery."
