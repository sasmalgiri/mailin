    "Give every named subject a right of reply before sign-off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder namentlich genannten Person vor der Abnahme ein Recht auf Gegendarstellung geben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da a cada persona nombrada derecho de réplica antes de la aprobación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
