    "Judge a subject across comms patterns, anomalies, and risky terms — and record the finding for HR/legal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Person anhand von Kommunikationsmustern, Anomalien und riskanten Begriffen beurteilen — und den Befund für HR/Recht festhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evaluar a un sujeto a partir de patrones de comunicación, anomalías y términos de riesgo — y registrar el hallazgo para RR. HH./legal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évaluer une personne à travers ses schémas de communication, ses anomalies et les termes à risque — et consigner le constat pour les RH/le juridique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संचार पैटर्न, विसंगतियों और जोखिम भरे शब्दों के आधार पर व्यक्ति का आकलन करें — और HR/कानूनी के लिए निष्कर्ष दर्ज करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valutare un soggetto attraverso schemi di comunicazione, anomalie e termini a rischio — e registrare il riscontro per HR/legale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通信パターン、異常、リスクのある語句から対象者を評価し、人事/法務のために所見を記録します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통신 패턴, 이상 징후, 위험 용어로 대상을 판단하고 인사/법무를 위해 발견 사항을 기록합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaliar uma pessoa pelos padrões de comunicação, anomalias e termos de risco — e registrar o achado para RH/jurídico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从沟通模式、异常和风险词语评估对象 — 并为人事/法务记录发现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從溝通模式、異常與風險詞語評估對象 — 並為人資/法務記錄發現。"
          }
        }
      }
    },
    "Jump straight to a month" : {
