          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode forensique actif. %1$@ %2$lld fichiers source vérifiés par hachage. %3$lld actions consignées dans le journal d'audit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोरेंसिक मोड सक्रिय। %1$@ %2$lld स्रोत फ़ाइलें हैश-सत्यापित। %3$lld ऑडिट ट्रेल क्रियाएँ दर्ज।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modalità forense attiva. %1$@ %2$lld file sorgente verificati tramite hash. %3$lld azioni registrate nel registro di audit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォレンジックモードが有効。%1$@ %2$lld 個のソースファイルをハッシュ検証済み。%3$lld 件の監査証跡アクションを記録。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포렌식 모드 활성. %1$@ 소스 파일 %2$lld개 해시 검증됨. 감사 추적 동작 %3$lld개 기록됨."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo forense ativo. %1$@ %2$lld arquivos de origem verificados por hash. %3$lld ações registradas na trilha de auditoria."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取证模式已启用。%1$@ %2$lld 个源文件已通过哈希校验。已记录 %3$lld 条审计记录操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鑑識模式已啟用。%1$@ %2$lld 個來源檔案已通過雜湊驗證。已記錄 %3$lld 筆稽核軌跡動作。"
          }
        }
      }
    },
    "Forensic mode enables hash verification of source files, a full audit log and evidence tagging, to maintain the chain of custody. All analysis runs on this device, as always." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Forensikmodus aktiviert die Hash-Prüfung der Quelldateien, ein vollständiges Prüfprotokoll und die Beweismarkierung, um die Beweiskette zu wahren. Alle Analysen laufen wie immer auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo forense activa la verificación de hash de los archivos de origen, un registro de auditoría completo y el etiquetado de pruebas, para mantener la cadena de custodia. Todo el análisis se ejecuta en este dispositivo, como siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode forensique active la vérification des empreintes des fichiers sources, un journal d'audit complet et l'étiquetage des preuves, pour préserver la chaîne de traçabilité. Toutes les analyses s'exécutent sur cet appareil, comme toujours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोरेंसिक मोड चेन ऑफ़ कस्टडी बनाए रखने के लिए स्रोत फ़ाइलों का हैश सत्यापन, पूरा ऑडिट लॉग और साक्ष्य टैगिंग चालू करता है। सारा विश्लेषण हमेशा की तरह इसी डिवाइस पर होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità forense attiva la verifica degli hash dei file di origine, un registro di audit completo e i tag delle prove, per mantenere la catena di custodia. Tutte le analisi vengono eseguite su questo dispositivo, come sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォレンジックモードでは、保管の連続性を保つため、元ファイルのハッシュ検証、完全な監査ログ、証拠タグが有効になります。分析はいつもどおりすべてこのデバイス上で行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포렌식 모드는 관리 연속성을 유지하기 위해 원본 파일의 해시 검증, 전체 감사 로그, 증거 태그를 켭니다. 모든 분석은 언제나처럼 이 기기에서 실행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo forense ativa a verificação de hash dos arquivos de origem, um registro de auditoria completo e a marcação de provas, para manter a cadeia de custódia. Toda a análise é feita neste dispositivo, como sempre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取证模式会启用源文件的哈希校验、完整的审计日志和证据标记，以保持监管链。所有分析一如既往地在此设备上运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鑑識模式會啟用來源檔案的雜湊驗證、完整的稽核記錄和證據標記，以維持保管鏈。所有分析一如往常在此裝置上執行。"
          }
        }
      }
    },
    "Forensic mode enables hash verification of source files, a full audit log, evidence tagging, and blocks cloud AI to maintain chain of custody." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Forensikmodus aktiviert die Hashprüfung von Quelldateien, ein vollständiges Prüfprotokoll und Beweis-Tagging und blockiert Cloud-KI, um die Beweismittelkette zu wahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo forense activa la verificación de hashes de los archivos de origen, un registro de auditoría completo y el etiquetado de evidencia, y bloquea la IA en la nube para mantener la cadena de custodia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode forensique active la vérification des hachages des fichiers source, un journal d'audit complet et le marquage des preuves, et bloque l'IA cloud pour préserver la chaîne de conservation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोरेंसिक मोड स्रोत फ़ाइलों का हैश सत्यापन, पूर्ण ऑडिट लॉग, साक्ष्य टैगिंग सक्षम करता है और अभिरक्षा श्रृंखला बनाए रखने के लिए क्लाउड AI रोकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità forense abilita la verifica hash dei file sorgente, un registro di audit completo, il tagging delle prove e blocca l'IA cloud per mantenere la catena di custodia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォレンジックモードは、ソースファイルのハッシュ検証、完全な監査ログ、証拠タグ付けを有効にし、証拠保全の連鎖を守るためにクラウド AI をブロックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포렌식 모드는 소스 파일의 해시 검증, 전체 감사 로그, 증거 태그 지정을 활성화하고 관리 연속성을 유지하기 위해 클라우드 AI를 차단합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo forense ativa a verificação de hash dos arquivos de origem, um registro de auditoria completo e a marcação de evidências, e bloqueia a IA na nuvem para manter a cadeia de custódia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取证模式启用源文件哈希校验、完整审计日志、证据标记，并阻止云端 AI 以维护监管链。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鑑識模式會啟用來源檔案雜湊驗證、完整稽核記錄、證據標記，並封鎖雲端 AI 以維護監管鏈。"
          }
        }
      }
    },
