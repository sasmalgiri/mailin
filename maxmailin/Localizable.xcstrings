    "Mine the mail for indicators of compromise, judge which are real, and export a reported set." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die E-Mails nach Kompromittierungsindikatoren durchsuchen, beurteilen, welche echt sind, und einen gemeldeten Bestand exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extraer del correo indicadores de compromiso, juzgar cuáles son reales y exportar un conjunto notificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extraire du courrier les indicateurs de compromission, juger lesquels sont réels et exporter un ensemble signalé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेल में समझौते के संकेतक खोजें, तय करें कि कौन-से वास्तविक हैं और रिपोर्ट किया गया सेट निर्यात करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrarre dalla posta gli indicatori di compromissione, giudicare quali sono reali ed esportare un insieme segnalato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "侵害指標をメールから掘り出し、本物を見極め、報告済みのセットを書き出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메일에서 침해 지표를 찾아내고, 진짜를 판별하고, 보고된 세트를 내보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minerar o e-mail em busca de indicadores de comprometimento, julgar quais são reais e exportar um conjunto relatado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从邮件中挖掘入侵指标，判断哪些属实，并导出已报告的数据集。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從郵件中挖掘入侵指標，判斷哪些屬實，並匯出已回報的資料集。"
          }
        }
      }
    },
