    "CONTRADICTIONS — BOTH SIDES PRESERVED, NEVER AVERAGED" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WIDERSPRÜCHE — BEIDE SEITEN BEWAHRT, NIE GEMITTELT"
          }
        },
        "es" : {
