    "Subscription · renews or ends %@. Manage it below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnement · verlängert sich oder endet am %@. Unten verwalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suscripción · se renueva o termina el %@. Gestiónala abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnement · se renouvelle ou prend fin le %@. Gérez-le ci-dessous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सदस्यता · %@ को नवीनीकृत या समाप्त होती है। इसे नीचे प्रबंधित करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbonamento · si rinnova o termina il %@. Gestiscilo qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプション · %@ に更新または終了します。下で管理できます。"
