        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 보관함을 대상으로 한 스마트 알림, 이상 징후 탐지, 백그라운드 발견 사항."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
