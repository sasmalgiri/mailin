    "Case work: intake, custodians, review, productions and a tamper-evident audit trail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallarbeit: Aufnahme, Verwahrer, Prüfung, Produktionen und ein manipulationssicheres Prüfprotokoll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabajo de casos: admisión, custodios, revisión, producciones y un registro de auditoría a prueba de manipulación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travail de dossier : ouverture, dépositaires, révision, productions et un journal d'audit inviolable."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केस कार्य: इनटेक, संरक्षक, समीक्षा, प्रोडक्शन और छेड़छाड़-रोधी ऑडिट ट्रेल।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavoro sui casi: apertura, custodi, revisione, produzioni e un registro di audit a prova di manomissione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "案件業務: 受付、保管者、レビュー、提出、そして改ざん防止の監査証跡。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사건 업무: 접수, 보관자, 검토, 제출 및 변조 방지 감사 추적."
