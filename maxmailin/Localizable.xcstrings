    "Pick what you came to do — mailin runs each step and keeps the numbered record for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie, was Sie tun möchten — mailin führt jeden Schritt aus und führt den nummerierten Datensatz für Sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige lo que viniste a hacer — mailin ejecuta cada paso y conserva el registro numerado por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez ce que vous êtes venu faire — mailin exécute chaque étape et tient l'enregistrement numéroté pour vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि आप क्या करने आए हैं — mailin हर चरण चलाता है और क्रमांकित रिकॉर्ड आपके लिए रखता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli cosa sei venuto a fare — mailin esegue ogni passaggio e conserva il record numerato per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やりたいことを選ぶだけ — mailin が各ステップを実行し、番号付き記録を管理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하려는 작업을 선택하세요 — mailin이 각 단계를 실행하고 번호 매겨진 기록을 관리합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
