        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "indexation en arrière-plan — le contenu des pièces jointes devient consultable au fur et à mesure"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पृष्ठभूमि में अनुक्रमण जारी — अनुलग्नकों की सामग्री क्रमशः खोजने योग्य होती जाती है"
          }
        },
        "it" : {
