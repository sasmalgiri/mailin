    "Every AI answer lists the emails it came from; counts, dates and amounts are read from your archive, not written by the model." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede KI-Antwort nennt die E-Mails, aus denen sie stammt; Anzahlen, Daten und Beträge werden aus deinem Archiv gelesen, nicht vom Modell geschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada respuesta de la IA indica los correos de los que procede; los recuentos, fechas e importes se leen de tu archivo, no los escribe el modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque réponse de l'IA indique les e-mails dont elle provient ; les nombres, dates et montants sont lus dans votre archive, pas écrits par le modèle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर AI उत्तर बताता है कि वह किन ईमेल से आया; गिनती, तारीखें और रकम आपके आर्काइव से पढ़ी जाती हैं, मॉडल उन्हें नहीं लिखता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni risposta dell'IA elenca le email da cui proviene; conteggi, date e importi vengono letti dal tuo archivio, non scritti dal modello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI の回答にはすべて出典のメールが示されます。件数、日付、金額はモデルが書くのではなく、アーカイブから読み取られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 AI 답변에 출처 이메일이 표시되며, 개수, 날짜, 금액은 모델이 쓰는 것이 아니라 보관함에서 읽어 옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada resposta da IA lista os e-mails de onde veio; contagens, datas e valores são lidos do seu arquivo, não escritos pelo modelo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个 AI 回答都会列出其来源邮件；数量、日期和金额均从你的归档读取，而非由模型撰写。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個 AI 回答都會列出其來源郵件；數量、日期和金額均從你的封存讀取，而非由模型撰寫。"
          }
        }
      }
    },
