    "Import progress shows in the toolbar only. Receipts are still written and still readable from the File menu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Importfortschritt wird nur in der Symbolleiste angezeigt. Quittungen werden weiterhin geschrieben und sind über das Menü „Ablage“ lesbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El progreso de la importación se muestra solo en la barra de herramientas. Los recibos se siguen escribiendo y pueden leerse desde el menú Archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La progression de l'import ne s'affiche que dans la barre d'outils. Les reçus sont toujours écrits et lisibles depuis le menu Fichier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आयात प्रगति केवल टूलबार में दिखती है। रसीदें फिर भी लिखी जाती हैं और फ़ाइल मेनू से पढ़ी जा सकती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'avanzamento dell'importazione è mostrato solo nella barra degli strumenti. Le ricevute vengono comunque scritte e sono leggibili dal menu File."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込みの進捗はツールバーにのみ表示されます。レシートは引き続き書き込まれ、「ファイル」メニューから読めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져오기 진행률은 도구 막대에만 표시됩니다. 영수증은 계속 기록되며 파일 메뉴에서 읽을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O progresso da importação aparece apenas na barra de ferramentas. Os recibos continuam sendo gravados e legíveis pelo menu Arquivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入进度仅显示在工具栏中。收据仍会写入，并仍可从“文件”菜单中读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匯入進度僅顯示在工具列中。收據仍會寫入，並仍可從「檔案」選單中讀取。"
          }
        }
      }
    },
