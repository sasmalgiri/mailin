    "Export any email as a Word document (.doc), alongside PDF, CSV, plain text, redacted, Bates-stamped and forensic formats." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede E-Mail als Word-Dokument (.doc) exportieren, neben PDF, CSV, Klartext, geschwärzten, Bates-gestempelten und forensischen Formaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta cualquier correo como documento de Word (.doc), además de PDF, CSV, texto sin formato, redactado, con sello Bates y formatos forenses."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez tout e-mail en document Word (.doc), en plus des formats PDF, CSV, texte brut, caviardé, estampillé Bates et forensique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी ईमेल को Word दस्तावेज़ (.doc) के रूप में निर्यात करें, साथ ही PDF, CSV, सादा टेक्स्ट, रिडैक्टेड, Bates-मुहरित और फ़ोरेंसिक प्रारूप।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta qualsiasi email come documento Word (.doc), oltre ai formati PDF, CSV, testo semplice, oscurato, con timbro Bates e forense."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意のメールを Word 書類 (.doc) として書き出せます。PDF、CSV、プレーンテキスト、墨消し、Bates スタンプ、フォレンジック形式にも対応。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 이메일을 Word 문서(.doc)로 내보낼 수 있으며 PDF, CSV, 일반 텍스트, 편집 삭제, Bates 스탬프 및 포렌식 형식도 지원합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
