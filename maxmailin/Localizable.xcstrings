        }
      }
    },
    "Hiding sensitive information (SSNs, medical info, trade secrets) in a document before sharing it. Different from deletion — the page structure is preserved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Verbergen sensibler Informationen (Sozialversicherungsnummern, medizinische Daten, Geschäftsgeheimnisse) in einem Dokument vor der Weitergabe. Anders als Löschen — die Seitenstruktur bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar información sensible (números de la seguridad social, datos médicos, secretos comerciales) en un documento antes de compartirlo. Distinto de eliminar — la estructura de la página se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer des informations sensibles (numéros de sécurité sociale, données médicales, secrets commerciaux) dans un document avant de le partager. Différent de la suppression — la structure de la page est préservée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साझा करने से पहले दस्तावेज़ में संवेदनशील जानकारी (SSN, चिकित्सा जानकारी, व्यापार रहस्य) छिपाना। हटाने से अलग — पेज संरचना संरक्षित रहती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondere informazioni sensibili (codici fiscali, dati medici, segreti commerciali) in un documento prima di condividerlo. Diverso dall'eliminazione — la struttura della pagina è preservata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
