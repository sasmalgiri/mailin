    "Turn it on in System Settings ▸ Apple Intelligence & Siri. Until then, answers use on-device analysis only." : {
      "comment" : "A description of the Apple Intelligence feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalten Sie es in den Systemeinstellungen ▸ Apple Intelligence & Siri ein. Bis dahin nutzen Antworten nur die Analyse auf dem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívela en Ajustes del Sistema ▸ Apple Intelligence y Siri. Hasta entonces, las respuestas solo usan el análisis en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez-la dans Réglages Système ▸ Apple Intelligence et Siri. D’ici là, les réponses n’utilisent que l’analyse sur l’appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे सिस्टम सेटिंग्स ▸ Apple Intelligence और Siri में चालू करें। तब तक जवाब केवल डिवाइस पर विश्लेषण का इस्तेमाल करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivala in Impostazioni di Sistema ▸ Apple Intelligence e Siri. Fino ad allora le risposte usano solo l’analisi sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定 ▸ Apple IntelligenceとSiriでオンにしてください。それまでは、回答はデバイス上の分析のみを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 ▸ Apple Intelligence 및 Siri에서 켜십시오. 그때까지 답변은 기기 내 분석만 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative-o em Ajustes do Sistema ▸ Apple Intelligence e Siri. Até lá, as respostas usam apenas a análise no dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置”▸“Apple 智能与 Siri”中打开。在此之前,回答仅使用设备端分析。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「系統設定」▸「Apple Intelligence 與 Siri」中開啟。在此之前,回答僅使用裝置上的分析。"
          }
        }
      }
    },
