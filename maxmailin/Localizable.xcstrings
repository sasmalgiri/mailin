            "value" : "%@에게 암호화됨. 이 기기 키체인에 일치하는 개인 키가 없습니다 — 설정 ▸ 상태에서 수신자의 S/MIME ID(.p12)를 가져오세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "criptografado para %@; nenhuma chave privada correspondente no chaveiro deste dispositivo — importe a identidade S/MIME (.p12) do destinatário em Ajustes ▸ Saúde"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
