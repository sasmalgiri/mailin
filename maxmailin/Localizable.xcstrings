    "Toggle the AI button to enable sentiment analysis, priority scoring, phishing detection, and topic classification — all processed on-device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI-Taste einschalten, um Stimmungsanalyse, Prioritätsbewertung, Phishing-Erkennung und Themenklassifizierung zu aktivieren — alles auf dem Gerät verarbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el botón de IA para habilitar el análisis de sentimiento, la puntuación de prioridad, la detección de phishing y la clasificación por temas — todo procesado en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez le bouton IA pour l'analyse de sentiment, le score de priorité, la détection d'hameçonnage et la classification par sujet — le tout traité sur l'appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भावना विश्लेषण, प्राथमिकता स्कोरिंग, फ़िशिंग पहचान और विषय वर्गीकरण सक्षम करने के लिए AI बटन टॉगल करें — सब कुछ डिवाइस पर संसाधित।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva il pulsante IA per abilitare analisi del sentiment, punteggio di priorità, rilevamento phishing e classificazione per argomento — tutto elaborato sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI ボタンをオンにすると、感情分析、優先度スコアリング、フィッシング検出、トピック分類が有効になります — すべてデバイス上で処理されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 버튼을 켜서 감정 분석, 우선순위 점수, 피싱 감지, 주제 분류를 활성화하세요 — 모두 기기에서 처리됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o botão de IA para habilitar análise de sentimento, pontuação de prioridade, detecção de phishing e classificação por tópico — tudo processado no dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 AI 按钮以启用情绪分析、优先级评分、钓鱼检测和主题分类 — 全部在设备端处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟 AI 按鈕以啟用情緒分析、優先順序評分、網路釣魚偵測和主題分類 — 全部在裝置端處理。"
          }
