    "Not enough reply data to compute response times. Response time analysis requires emails with In-Reply-To headers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genug Antwortdaten zur Berechnung der Antwortzeiten. Die Analyse erfordert E-Mails mit In-Reply-To-Headern."
          }
