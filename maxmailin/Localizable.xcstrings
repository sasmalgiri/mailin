    "Locate potentially responsive data by defining search criteria, custodians, and date ranges." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potenziell einschlägige Daten durch Festlegen von Suchkriterien, Verwahrern und Datumsbereichen lokalisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localiza datos potencialmente relevantes definiendo criterios de búsqueda, custodios y rangos de fechas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localisez les données potentiellement pertinentes en définissant les critères de recherche, les dépositaires et les plages de dates."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोज मानदंड, संरक्षक और तिथि सीमाएँ परिभाषित करके संभावित प्रासंगिक डेटा का पता लगाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Individua i dati potenzialmente pertinenti definendo criteri di ricerca, custodi e intervalli di date."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索条件、保管者、日付範囲を定義して、関連する可能性のあるデータを特定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색 기준, 보관자, 날짜 범위를 정의하여 잠재적으로 관련 있는 데이터를 찾습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localize dados potencialmente relevantes definindo critérios de busca, custodiantes e intervalos de datas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过定义搜索条件、保管人和日期范围来定位可能相关的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過定義搜尋條件、保管人和日期範圍來找出可能相關的資料。"
          }
        }
      }
    },
    "Lock evidence to prevent tampering." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweise sperren, um Manipulation zu verhindern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea la evidencia para evitar manipulaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouillez les preuves pour empêcher toute altération."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छेड़छाड़ रोकने के लिए साक्ष्य लॉक करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca le prove per prevenire manomissioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改ざんを防ぐために証拠をロックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변조를 방지하기 위해 증거를 잠급니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueie as evidências para evitar adulteração."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定证据以防篡改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鎖定證據以防竄改。"
          }
        }
