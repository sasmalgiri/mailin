    "Scans every email in scope for privilege indicators and stores the flags." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsucht jede E-Mail im Umfang nach Vertraulichkeitsmerkmalen und speichert die Markierungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza cada correo del alcance en busca de indicios de privilegio y guarda las marcas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyse chaque e-mail du périmètre à la recherche d’indices de confidentialité et enregistre les marques."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दायरे के हर ईमेल में विशेषाधिकार संकेत खोजता है और चिह्न सहेजता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizza ogni email nell’ambito alla ricerca di indicatori di riservatezza e salva i contrassegni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "範囲内のすべてのメールで秘匿特権の兆候をスキャンし、フラグを保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "범위의 모든 이메일에서 기밀 특권 징후를 검사하고 표시를 저장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica cada e-mail do escopo em busca de indícios de privilégio e salva as marcações."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描范围内的每封邮件是否有特权迹象，并保存标记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描範圍內的每封郵件是否有特權跡象，並儲存標記。"
          }
        }
      }
    },
    "Scans the unused space of PST files and any damaged file for messages that are no longer listed. Slow on large files; recovered messages are marked partial when incomplete." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsucht den freien Speicher von PST-Dateien und beschädigte Dateien nach nicht mehr verzeichneten Nachrichten. Langsam bei großen Dateien; unvollständige Funde werden als teilweise markiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza el espacio no usado de los PST y cualquier archivo dañado en busca de mensajes que ya no aparecen. Es lento con archivos grandes; los mensajes incompletos se marcan como parciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyse l’espace inutilisé des fichiers PST et tout fichier endommagé à la recherche de messages qui ne sont plus répertoriés. Lent sur les gros fichiers ; les messages incomplets sont marqués partiels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PST फ़ाइलों की खाली जगह और किसी भी खराब फ़ाइल में उन संदेशों को खोजता है जो अब सूची में नहीं हैं। बड़ी फ़ाइलों पर धीमा; अधूरे संदेश आंशिक चिह्नित होते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizza lo spazio inutilizzato dei file PST e qualsiasi file danneggiato alla ricerca di messaggi non più elencati. Lento sui file grandi; i messaggi incompleti sono contrassegnati come parziali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PST ファイルの未使用領域や破損したファイルから、一覧にないメッセージを探します。大きなファイルでは時間がかかり、不完全なものは「一部のみ」と表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PST 파일의 미사용 공간과 손상된 파일에서 더 이상 목록에 없는 메시지를 찾습니다. 큰 파일에서는 느리며, 불완전한 메시지는 일부로 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analisa o espaço não usado de arquivos PST e qualquer arquivo danificado em busca de mensagens que não estão mais listadas. Lento em arquivos grandes; mensagens incompletas são marcadas como parciais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描 PST 文件的未用空间和任何损坏的文件，查找已不在列表中的邮件。大文件较慢；不完整的邮件会标为部分恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描 PST 檔案的未使用空間與任何損毀的檔案，尋找已不在清單中的郵件。大檔案較慢；不完整的郵件會標為部分復原。"
          }
        }
      }
    },
