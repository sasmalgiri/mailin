    "Extracts text from attachments in the background so in:attachments finds words inside PDFs and documents; off saves time and disk" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrahiert im Hintergrund Text aus Anhängen, damit in:attachments Wörter in PDFs und Dokumenten findet; aus spart Zeit und Speicher"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrae texto de los adjuntos en segundo plano para que in:attachments encuentre palabras dentro de PDF y documentos; desactivado ahorra tiempo y disco"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrait le texte des pièces jointes en arrière-plan pour que in:attachments trouve les mots dans les PDF et documents ; désactivé économise du temps et de l'espace"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पृष्ठभूमि में अनुलग्नकों से पाठ निकालता है ताकि in:attachments PDF और दस्तावेज़ों के भीतर शब्द खोज सके; बंद रखने से समय और डिस्क बचती है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrae il testo dagli allegati in background così in:attachments trova parole dentro PDF e documenti; disattivato risparmia tempo e disco"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドで添付ファイルからテキストを抽出し、in:attachments で PDF や書類内の語を検索できるようにします。オフにすると時間とディスクを節約できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드에서 첨부 파일의 텍스트를 추출하여 in:attachments가 PDF와 문서 안의 단어를 찾을 수 있게 합니다. 끄면 시간과 디스크를 절약합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrai texto dos anexos em segundo plano para que in:attachments encontre palavras dentro de PDFs e documentos; desligado economiza tempo e disco"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台从附件中提取文本，以便 in:attachments 能找到 PDF 和文档内的词语；关闭可节省时间和磁盘"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在背景從附件中擷取文字，以便 in:attachments 能找到 PDF 和文件內的字詞；關閉可節省時間和磁碟"
          }
        }
      }
    },
