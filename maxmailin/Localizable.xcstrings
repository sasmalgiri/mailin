    "The account's sign-in could not be read from the Keychain on this device. Unlock the device and try again." : {
      "comment" : "The sign-in failed because the Keychain on the device does not contain the account's sign-in.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung des Accounts konnte auf diesem Gerät nicht aus dem Schlüsselbund gelesen werden. Entsperren Sie das Gerät und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el inicio de sesión de la cuenta desde el llavero de este dispositivo. Desbloquea el dispositivo y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion du compte n'a pas pu être lue dans le trousseau de cet appareil. Déverrouillez l'appareil et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर कीचेन से खाते का साइन-इन नहीं पढ़ा जा सका। डिवाइस अनलॉक करें और फिर से कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile leggere l'accesso dell'account dal portachiavi di questo dispositivo. Sblocca il dispositivo e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスのキーチェーンからアカウントのサインイン情報を読み取れませんでした。デバイスのロックを解除して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 키체인에서 계정 로그인 정보를 읽을 수 없었습니다. 기기 잠금을 해제하고 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o início de sessão da conta nas Chaves deste dispositivo. Desbloqueie o dispositivo e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法从此设备的钥匙串读取该账户的登录信息。请解锁设备后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法從此裝置的鑰匙圈讀取該帳號的登入資訊。請解鎖裝置後再試。"
          }
        }
      }
    },
    "The account's sign-in details are removed from the Keychain on this device." : {
