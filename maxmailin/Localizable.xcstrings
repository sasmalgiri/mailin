      }
    },
    "The numbered document records each action, its cause, owner, status, and any human verification decisions. Open items remain open — the app closes nothing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das nummerierte Dokument hält jede Maßnahme, ihre Ursache, den Verantwortlichen, den Status und alle menschlichen Verifizierungsentscheidungen fest. Offene Punkte bleiben offen — die App schließt nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El documento numerado registra cada acción, su causa, responsable, estado y cualquier decisión de verificación humana. Los elementos abiertos siguen abiertos — la app no cierra nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le document numéroté consigne chaque action, sa cause, son responsable, son statut et toute décision de vérification humaine. Les éléments ouverts restent ouverts — l'app ne clôt rien."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्रमांकित दस्तावेज़ हर कार्रवाई, उसका कारण, स्वामी, स्थिति और कोई भी मानवीय सत्यापन निर्णय दर्ज करता है। खुले मद खुले रहते हैं — ऐप कुछ बंद नहीं करता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il documento numerato registra ogni azione, la sua causa, il responsabile, lo stato e le eventuali decisioni di verifica umana. Gli elementi aperti restano aperti — l'app non chiude nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番号付きの書類には各アクション、その原因、担当者、状態、人による検証の判断が記録されます。未完了の項目は未完了のまま残ります — アプリは何も完了にしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번호가 매겨진 문서는 각 작업, 원인, 담당자, 상태, 사람의 검증 결정을 기록합니다. 미해결 항목은 미해결로 남습니다 — 앱은 아무것도 종결하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O documento numerado registra cada ação, sua causa, responsável, status e quaisquer decisões de verificação humana. Itens em aberto permanecem em aberto — o app não fecha nada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编号文稿记录每项行动、其原因、负责人、状态以及任何人工验证决定。未决项目保持未决 — App 不会关闭任何项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編號文件記錄每項行動、其原因、負責人、狀態以及任何人工驗證決定。未決項目保持未決 — App 不會關閉任何項目。"
          }
        }
      }
    },
