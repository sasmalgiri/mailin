          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulizia del server"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバのクリーンアップ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버 정리"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
