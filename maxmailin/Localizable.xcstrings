            "value" : "Aplica la retención legal con sellos de evidencia criptográficos y almacena hashes de integridad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place sous conservation légale avec des scellés de preuve cryptographiques et stocke les hachages d'intégrité"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्रिप्टोग्राफ़िक साक्ष्य सील के साथ कानूनी रोक लगाता है और अखंडता हैश संग्रहीत करता है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica la conservazione legale con sigilli di prova crittografici e archivia gli hash di integrità"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号学的な証拠封印とともにリーガルホールドを適用し、整合性ハッシュを保存します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화 증거 봉인과 함께 법적 보존을 설정하고 무결성 해시를 저장합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
