    "Generate a Load File (DAT), Export (CSV), or Privilege Log to produce deliverables." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Load-Datei (DAT), einen Export (CSV) oder ein Privilegienprotokoll erzeugen, um Liefergegenstände zu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generar un archivo de carga (DAT), una exportación (CSV) o un registro de privilegio para producir entregables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Générer un fichier de chargement (DAT), un export (CSV) ou un journal de privilège pour produire les livrables."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिलिवरेबल बनाने के लिए लोड फ़ाइल (DAT), निर्यात (CSV) या विशेषाधिकार लॉग बनाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generare un file di caricamento (DAT), un'esportazione (CSV) o un registro dei privilegi per produrre i deliverable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成果物を作成するには、ロードファイル (DAT)、書き出し (CSV)、または秘匿特権ログを生成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "산출물을 만들려면 로드 파일(DAT), 내보내기(CSV) 또는 특권 로그를 생성하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerar um arquivo de carga (DAT), uma exportação (CSV) ou um registro de privilégio para produzir entregáveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成加载文件（DAT）、导出（CSV）或特权日志以制作交付物。"
          }
        },
        "zh-Hant" : {
