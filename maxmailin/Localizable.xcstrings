          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据邮件用词计算出的情绪基调估计（负面 / 中性 / 正面）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
