    },
    "Run a background scan to detect anomalies, phishing, PII exposure, and sentiment shifts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Hintergrundscan ausführen, um Anomalien, Phishing, Offenlegung personenbezogener Daten und Stimmungswechsel zu erkennen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta un escaneo en segundo plano para detectar anomalías, phishing, exposición de PII y cambios de sentimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez une analyse en arrière-plan pour détecter anomalies, hameçonnage, exposition de données personnelles et variations de sentiment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विसंगतियों, फ़िशिंग, PII उजागर होने और भावना बदलाव का पता लगाने के लिए पृष्ठभूमि स्कैन चलाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui una scansione in background per rilevare anomalie, phishing, esposizione di PII e variazioni del sentiment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドスキャンを実行して、異常、フィッシング、個人情報の露出、感情の変化を検出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 스캔을 실행하여 이상 징후, 피싱, 개인정보 노출, 감정 변화를 감지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Execute uma varredura em segundo plano para detectar anomalias, phishing, exposição de PII e mudanças de sentimento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行后台扫描以检测异常、钓鱼、个人信息泄露和情绪变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行背景掃描以偵測異常、網路釣魚、個人資料外洩和情緒變化。"
          }
        }
      }
    },
    "Run a document production the defensible way — review, privilege-log, Bates, produce — with the privilege gate enforced before you release." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Dokumentenproduktion belastbar durchführen — prüfen, Privilegienprotokoll, Bates, produzieren — mit erzwungener Privilegiensperre vor der Freigabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecutar una producción de documentos de forma defendible — revisar, registro de privilegio, Bates, producir — con la barrera de privilegio aplicada antes de entregar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mener une production de documents de façon défendable — revoir, journal de privilège, Bates, produire — avec le filtre de privilège appliqué avant toute remise."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दस्तावेज़ प्रस्तुति को ठोस तरीके से करें — समीक्षा, विशेषाधिकार-लॉग, Bates, प्रस्तुति — जारी करने से पहले विशेषाधिकार जाँच लागू रहती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eseguire una produzione documentale in modo difendibile — revisionare, registro dei privilegi, Bates, produrre — con il filtro dei privilegi applicato prima del rilascio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "説得力のある方法で文書提出を実施 — レビュー、秘匿特権ログ、ベイツ番号、提出 — 公開前に秘匿特権チェックを必須にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방어 가능한 방식으로 문서 제출 — 검토, 특권 로그, 베이츠, 제출 — 공개 전 특권 검사를 강제합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executar uma produção de documentos de forma defensável — revisar, registro de privilégio, Bates, produzir — com a barreira de privilégio aplicada antes da entrega."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以经得起推敲的方式完成文件提交 — 审查、特权日志、Bates 编号、提交 — 发布前强制执行特权检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以經得起檢驗的方式完成文件提出 — 審查、特權日誌、Bates 編號、提出 — 發布前強制執行特權檢查。"
          }
        }
      }
    },
    "Run a public-records request end to end — draft it, track responses, review what's released, and log the outcome." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Anfrage nach öffentlichen Unterlagen von Anfang bis Ende durchführen — entwerfen, Antworten verfolgen, das Freigegebene prüfen und das Ergebnis protokollieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tramitar una solicitud de registros públicos de principio a fin — redactarla, seguir las respuestas, revisar lo entregado y registrar el resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mener une demande d'accès aux documents publics de bout en bout — la rédiger, suivre les réponses, examiner ce qui est communiqué et consigner le résultat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सार्वजनिक-रिकॉर्ड अनुरोध को शुरू से अंत तक चलाएँ — मसौदा बनाएँ, उत्तर ट्रैक करें, जारी सामग्री की समीक्षा करें और परिणाम लॉग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestire una richiesta di accesso agli atti pubblici dall'inizio alla fine — redigerla, seguire le risposte, esaminare ciò che viene rilasciato e registrare l'esito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公文書開示請求を最初から最後まで実施 — 起案し、回答を追跡し、開示内容を確認し、結果を記録します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공공 기록 청구를 처음부터 끝까지 진행 — 작성하고, 응답을 추적하고, 공개된 내용을 검토하고, 결과를 기록합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduzir um pedido de acesso a registros públicos de ponta a ponta — redigi-lo, acompanhar respostas, revisar o que foi liberado e registrar o resultado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从头到尾办理一次公共记录申请 — 起草、跟踪答复、审阅公开内容并记录结果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從頭到尾辦理一次政府資訊公開申請 — 草擬、追蹤回覆、審閱公開內容並記錄結果。"
          }
        }
      }
    },
    "Run a search-term list across the evidence, triage the hits, and turn them into cited findings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Suchbegriffsliste über die Beweise laufen lassen, die Treffer sichten und in zitierte Befunde verwandeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasar una lista de términos de búsqueda por las pruebas, clasificar los resultados y convertirlos en hallazgos citados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer une liste de termes de recherche sur les preuves, trier les résultats et les transformer en constats cités."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साक्ष्य पर खोज-शब्दों की सूची चलाएँ, परिणामों की छँटाई करें और उन्हें उद्धृत निष्कर्षों में बदलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applicare un elenco di termini di ricerca alle prove, smistare i risultati e trasformarli in riscontri citati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索語リストを証拠に適用し、ヒットを選別して、引用付きの所見にまとめます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색어 목록을 증거에 적용하고, 결과를 분류하고, 인용된 발견 사항으로 만듭니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar uma lista de termos de busca às evidências, triar os resultados e transformá-los em achados citados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在证据上运行一组搜索词，分拣命中结果，并整理成带引用的发现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在證據上執行一組搜尋詞，分揀命中結果，並整理成附引用的發現。"
          }
        }
      }
    },
    "Run a security scan on your email archive and get a summary" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Sicherheitsscan über Ihr E-Mail-Archiv ausführen und eine Zusammenfassung erhalten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta un escaneo de seguridad en tu archivo de correo y obtén un resumen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez une analyse de sécurité de votre archive e-mail et obtenez un résumé"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने ईमेल संग्रह पर सुरक्षा स्कैन चलाएँ और सारांश प्राप्त करें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui una scansione di sicurezza del tuo archivio email e ottieni un riepilogo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールアーカイブのセキュリティスキャンを実行して概要を取得します"
          }
        },
        "ko" : {
