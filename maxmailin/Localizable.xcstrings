    "Waiting for you: this message came back with a restored backup and may already have been sent. Check Sent, then send it or keep it as a draft." : {
      "comment" : "Text displayed in the outbox for a restored backup.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf Sie: Diese E-Mail kam mit einem wiederhergestellten Backup zurück und wurde möglicherweise schon gesendet. Prüfen Sie „Gesendet“ und senden Sie sie dann oder behalten Sie sie als Entwurf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando su decisión: este mensaje volvió con una copia de seguridad restaurada y puede que ya se haya enviado. Compruebe Enviados y luego envíelo o consérvelo como borrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de votre décision : ce message est revenu avec une sauvegarde restaurée et a peut-être déjà été envoyé. Vérifiez les Envoyés, puis envoyez-le ou conservez-le comme brouillon."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी प्रतीक्षा में: यह संदेश पुनर्स्थापित बैकअप के साथ वापस आया है और हो सकता है पहले ही भेजा जा चुका हो। भेजे गए की जाँच करें, फिर इसे भेजें या ड्राफ़्ट के रूप में रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa di te: questo messaggio è tornato con un backup ripristinato e potrebbe essere già stato inviato. Controlla Inviati, poi invialo o tienilo come bozza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認待ち：このメッセージは復元したバックアップとともに戻ってきたもので、すでに送信済みの可能性があります。送信済みを確認してから、送信するか下書きとして保持してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인 대기 중: 이 메시지는 복원된 백업과 함께 돌아왔으며 이미 전송되었을 수 있습니다. 보낸 편지함을 확인한 다음 보내거나 임시 저장으로 유지하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando você: esta mensagem voltou com um backup restaurado e pode já ter sido enviada. Verifique Enviados e depois envie-a ou mantenha-a como rascunho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待你处理：此邮件随恢复的备份返回，可能已经发送。请检查“已发送”，然后发送或保留为草稿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待你處理：此郵件隨回復的備份返回，可能已經傳送。請檢查「寄件備份」，然後傳送或保留為草稿。"
          }
        }
      }
    },
    "Waiting for you: this message was queued before sending was paused for %lld days. Send it now, or keep it as a draft." : {
      "comment" : "A message in the outbox that shows how many days ago the message was queued.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf Sie: Diese E-Mail wurde in die Warteschlange gestellt, bevor das Senden für %lld Tage pausiert wurde. Senden Sie sie jetzt oder behalten Sie sie als Entwurf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando su decisión: este mensaje se puso en cola antes de que el envío se pausara durante %lld días. Envíelo ahora o consérvelo como borrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de votre décision : ce message a été mis en file d'attente avant que l'envoi ne soit suspendu pendant %lld jours. Envoyez-le maintenant ou conservez-le comme brouillon."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी प्रतीक्षा में: यह संदेश भेजना %lld दिनों के लिए रोके जाने से पहले कतार में लगाया गया था। इसे अभी भेजें या ड्राफ़्ट के रूप में रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa di te: questo messaggio è stato messo in coda prima che l'invio fosse sospeso per %lld giorni. Invialo ora o tienilo come bozza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認待ち：このメッセージは、送信が %lld 日間一時停止される前にキューに入れられました。今すぐ送信するか、下書きとして保持してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인 대기 중: 이 메시지는 보내기가 %lld일 동안 일시 정지되기 전에 대기열에 추가되었습니다. 지금 보내거나 임시 저장으로 유지하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando você: esta mensagem foi colocada na fila antes de o envio ser pausado por %lld dias. Envie-a agora ou mantenha-a como rascunho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待你处理：此邮件在发送暂停 %lld 天之前已加入队列。请立即发送或保留为草稿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待你處理：此郵件在傳送暫停 %lld 天之前已加入佇列。請立即傳送或保留為草稿。"
          }
        }
      }
    },
