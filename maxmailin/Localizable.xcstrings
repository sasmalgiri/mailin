          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioritätswert basierend auf Dringlichkeitswörtern, Fragen, Handlungsaufforderungen, Antwortverlauf und Anhängen. Hoch: 5+, Mittel: 3–4, Niedrig: 0–2"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puntuación de prioridad basada en palabras de urgencia, preguntas, solicitudes de acción, historial de respuestas y adjuntos. Alta: 5+, Media: 3-4, Baja: 0-2"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Score de priorité fondé sur les mots d'urgence, les questions, les demandes d'action, l'historique des réponses et les pièces jointes. Élevée : 5+, Moyenne : 3-4, Faible : 0-2"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तात्कालिकता शब्दों, प्रश्नों, कार्रवाई अनुरोधों, उत्तर इतिहास और अनुलग्नकों पर आधारित प्राथमिकता स्कोर। उच्च: 5+, मध्यम: 3-4, निम्न: 0-2"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punteggio di priorità basato su parole di urgenza, domande, richieste di azione, cronologia delle risposte e allegati. Alta: 5+, Media: 3-4, Bassa: 0-2"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊急を示す語、質問、アクション要求、返信履歴、添付ファイルに基づく優先度スコア。高: 5 以上、中: 3〜4、低: 0〜2"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴급 단어, 질문, 조치 요청, 답장 기록, 첨부 파일에 기반한 우선순위 점수. 높음: 5 이상, 보통: 3-4, 낮음: 0-2"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pontuação de prioridade com base em palavras de urgência, perguntas, pedidos de ação, histórico de respostas e anexos. Alta: 5+, Média: 3-4, Baixa: 0-2"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于紧急词汇、问题、行动请求、回复历史和附件的优先级评分。高：5+，中：3-4，低：0-2"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據緊急詞彙、問題、行動要求、回覆歷史記錄和附件的優先順序評分。高：5+，中：3-4，低：0-2"
          }
        }
      }
    },
