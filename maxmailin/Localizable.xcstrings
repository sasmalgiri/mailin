    "Handle one phishing campaign that generated many reports as a single incident: cluster, verdict once, contain in bulk." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Phishing-Kampagne mit vielen Meldungen als einen einzigen Vorfall behandeln: bündeln, einmal beurteilen, gesammelt eindämmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tratar una campaña de phishing que generó muchos informes como un único incidente: agrupar, dictaminar una vez, contener en bloque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traiter une campagne d'hameçonnage ayant généré de nombreux signalements comme un seul incident : regrouper, statuer une fois, contenir en bloc."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कई रिपोर्ट उत्पन्न करने वाले एक फ़िशिंग अभियान को एक ही घटना के रूप में संभालें: समूहित करें, एक बार निर्णय दें, एक साथ रोकथाम करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestire una campagna di phishing che ha generato molte segnalazioni come un unico incidente: raggruppare, decidere una volta, contenere in blocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多数の報告を生んだフィッシングキャンペーンを 1 件のインシデントとして扱います: まとめて、一度判定し、一括で封じ込めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "많은 신고를 낳은 피싱 캠페인 하나를 단일 사고로 처리합니다: 묶고, 한 번 판정하고, 일괄 차단합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tratar uma campanha de phishing que gerou muitos relatos como um único incidente: agrupar, decidir uma vez, conter em lote."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将一次产生大量报告的网络钓鱼活动作为单一事件处理：聚类、一次判定、批量遏制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將一次產生大量回報的網路釣魚活動當作單一事件處理：歸群、一次判定、批次圍堵。"
          }
        }
      }
    },
