    "Imported mail is searchable now (headers and bodies). Attachment text: %lld emails still to index, %lld done — %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importierte E-Mails sind jetzt durchsuchbar (Kopfzeilen und Inhalte). Anhangstext: %1$lld E-Mails noch zu indizieren, %2$lld erledigt – %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El correo importado ya se puede buscar (encabezados y cuerpos). Texto de adjuntos: %1$lld correos pendientes de indexar, %2$lld listos; %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
