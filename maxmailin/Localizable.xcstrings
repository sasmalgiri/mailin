    "Appends the launch event to the tamper-evident HMAC chain; Professional-owned (§3.3 R6)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängt das Startereignis an die manipulationssichere HMAC-Kette an; gehört zu Professional (§3.3 R6)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el evento de inicio a la cadena HMAC a prueba de manipulación; pertenece a Professional (§3.3 R6)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute l'événement de lancement à la chaîne HMAC inviolable ; appartient à Professional (§3.3 R6)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉन्च घटना को छेड़छाड़-रोधी HMAC श्रृंखला में जोड़ता है; Professional के स्वामित्व में (§3.3 R6)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge l'evento di avvio alla catena HMAC a prova di manomissione; appartiene a Professional (§3.3 R6)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動イベントを改ざん防止 HMAC チェーンに追加します。Professional に属します (§3.3 R6)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 이벤트를 변조 방지 HMAC 체인에 추가합니다. Professional 소유 (§3.3 R6)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acrescenta o evento de inicialização à cadeia HMAC à prova de adulteração; pertence ao Professional (§3.3 R6)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将启动事件追加到防篡改 HMAC 链；归 Professional 所有（§3.3 R6）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將啟動事件附加到防竄改 HMAC 鏈；歸 Professional 所有（§3.3 R6）。"
          }
        }
      }
    },
