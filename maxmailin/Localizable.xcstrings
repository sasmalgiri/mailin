          }
        }
      }
    },
    "Similar text above the chosen threshold — not identical. Compare the copies before ticking one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ähnlicher Text über der gewählten Schwelle – nicht identisch. Vergleichen Sie die Kopien, bevor Sie eine ankreuzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto similar por encima del umbral elegido: no idéntico. Compare las copias antes de marcar una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte similaire au-dessus du seuil choisi — pas identique. Comparez les copies avant d'en cocher une."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनी गई सीमा से ऊपर मिलता-जुलता पाठ — समान नहीं। किसी प्रति को चुनने से पहले प्रतियों की तुलना करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testo simile sopra la soglia scelta: non identico. Confronta le copie prima di spuntarne una."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したしきい値を超える類似テキスト — 同一ではありません。チェックを入れる前にコピーを比較してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
