          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin이 먼저 파일을 만듭니다. 그런 다음 공유 시트에서 저장하거나 보낼 곳을 선택합니다(예: ‘파일에 저장’)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
