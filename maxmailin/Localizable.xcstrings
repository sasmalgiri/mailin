    "archive format not opened — files inside ZIP attachments are read, other archive formats are kept as files" : {
      "comment" : "Error message when an archive format is not supported and the files inside are not read.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
