    "Tag, export, or process many emails at once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viele E-Mails auf einmal taggen, exportieren oder verarbeiten."
          }
        },
        "es" : {
