          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin 會先寫入檔案；接著你從分享表單中選擇儲存或傳送的位置（例如「儲存到『檔案』」）。"
          }
        }
      }
