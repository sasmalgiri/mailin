    "The original email source including all headers and MIME encoding" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der ursprüngliche E-Mail-Quelltext einschließlich aller Header und MIME-Codierung"
          }
        },
