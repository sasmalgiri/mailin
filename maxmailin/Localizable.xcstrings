    "Verdict queue for user-reported suspicious emails — auto-scored, one-click verdicts, IOC blocklist export." : {
      "comment" : "Caption for the \"Phishing Triage\" hub destination.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urteilswarteschlange für von Nutzern gemeldete verdächtige E-Mails — automatisch bewertet, Ein-Klick-Urteile, IOC-Sperrlisten-Export."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cola de veredictos para correos sospechosos reportados por usuarios — puntuación automática, veredictos de un clic, exportación de lista de bloqueo de IOC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File des verdicts pour les e-mails suspects signalés par les utilisateurs — notation automatique, verdicts en un clic, export de liste de blocage IOC."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपयोगकर्ता द्वारा रिपोर्ट किए गए संदिग्ध ईमेल के लिए निर्णय कतार — स्वतः-स्कोर, एक-क्लिक निर्णय, IOC ब्लॉकलिस्ट निर्यात।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coda dei verdetti per le email sospette segnalate dagli utenti — valutazione automatica, verdetti a un clic, esportazione della lista di blocco IOC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーから報告された疑わしいメールの判定キュー — 自動スコアリング、ワンクリック判定、IOC ブロックリストの書き出し。"
          }
