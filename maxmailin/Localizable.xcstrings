    "Backs up the whole archive: %lld emails, with every file hashed. Then it is restored into a separate empty profile and compared." : {
      "comment" : "A description of a backup operation. The argument is the number of emails in the archive.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichert das gesamte Archiv: %lld E-Mails, jede Datei mit Hashwert. Danach wird es in ein separates leeres Profil wiederhergestellt und verglichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace una copia de todo el archivo: %lld correos, con el hash de cada archivo. Luego se restaura en un perfil vacío aparte y se compara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegarde l’archive entière : %lld e-mails, chaque fichier étant haché. Elle est ensuite restaurée dans un profil vide distinct et comparée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे संग्रह का बैकअप लेता है: %lld ईमेल, हर फ़ाइल के हैश के साथ। फिर उसे एक अलग खाली प्रोफ़ाइल में पुनर्स्थापित करके तुलना की जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegue il backup dell’intero archivio: %lld email, con l’hash di ogni file. Poi viene ripristinato in un profilo vuoto separato e confrontato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブ全体（%lld 件のメール）を、すべてのファイルのハッシュとともにバックアップします。その後、別の空のプロファイルに復元して比較します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 보관함(이메일 %lld개)을 모든 파일의 해시와 함께 백업합니다. 그런 다음 별도의 빈 프로파일로 복원하여 비교합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz backup do arquivo inteiro: %lld e-mails, com o hash de cada arquivo. Depois, ele é restaurado em um perfil vazio separado e comparado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份整个归档：%lld 封邮件，并对每个文件计算哈希。然后将其恢复到一个单独的空配置文件中进行比较。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份整個封存：%lld 封郵件，並為每個檔案計算雜湊。然後將其回復到一個獨立的空描述檔中進行比較。"
          }
        }
      }
    },
