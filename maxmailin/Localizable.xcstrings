    "%@" : {
      "shouldTranslate" : false
    },
    "%@\n\nA separate window opens for this. Do the work there, then come back and fill this step's fields — it saves automatically%@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nDafür öffnet sich ein eigenes Fenster. Erledigen Sie die Arbeit dort, kommen Sie dann zurück und füllen Sie die Felder dieses Schritts aus – er wird automatisch gesichert%2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@\n\nA separate window opens for this. Do the work there, then come back and fill this step's fields — it saves automatically%2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nPara esto se abre una ventana aparte. Haz el trabajo allí, vuelve y completa los campos de este paso; se guarda automáticamente%2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nUne fenêtre séparée s'ouvre pour cela. Faites le travail là-bas, puis revenez remplir les champs de cette étape — elle s'enregistre automatiquement%2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nइसके लिए एक अलग विंडो खुलती है। वहाँ काम करें, फिर वापस आकर इस चरण के फ़ील्ड भरें — यह अपने आप सहेजा जाता है%2$@।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nPer questo si apre una finestra separata. Fai il lavoro lì, poi torna e compila i campi di questo passaggio: viene salvato automaticamente%2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nこの作業用に別ウインドウが開きます。そこで作業してから戻り、このステップの項目を入力してください。自動的に保存されます%2$@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\n이 작업을 위해 별도의 윈도우가 열립니다. 거기서 작업한 뒤 돌아와 이 단계의 항목을 채우세요. 자동으로 저장됩니다%2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nUma janela separada será aberta para isso. Faça o trabalho lá, depois volte e preencha os campos desta etapa — ela é salva automaticamente%2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\n此操作将打开单独的窗口。请在那里完成工作，然后回来填写此步骤的字段——它会自动保存%2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\n此操作會另外開啟一個視窗。請在那裡完成工作，然後回來填寫此步驟的欄位——它會自動儲存%2$@。"
          }
        }
      }
    },
    "%@\n\nA separate window opens for this. Run the job there; this step completes when the job's saved receipt says it succeeded — opening the tool or filling the fields does not complete it." : {
      "comment" : "A message in a sheet that appears when the user taps a button to open a tool for a step. The argument is the step's hint text.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nDafür öffnet sich ein eigenes Fenster. Führen Sie den Auftrag dort aus; dieser Schritt ist abgeschlossen, wenn die gesicherte Quittung des Auftrags den Erfolg bestätigt – das Öffnen des Werkzeugs oder das Ausfüllen der Felder schließt ihn nicht ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nPara esto se abre una ventana aparte. Ejecuta allí la tarea; este paso se completa cuando el recibo guardado de la tarea indica que se realizó correctamente; abrir la herramienta o rellenar los campos no lo completa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nUne fenêtre distincte s’ouvre pour cela. Exécutez-y la tâche ; cette étape est terminée quand le reçu enregistré de la tâche indique sa réussite — ouvrir l’outil ou remplir les champs ne la termine pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nइसके लिए एक अलग विंडो खुलती है। कार्य वहीं चलाएँ; यह चरण तब पूरा होता है जब कार्य की सहेजी गई रसीद बताती है कि वह सफल हुआ — टूल खोलने या फ़ील्ड भरने से यह पूरा नहीं होता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nPer questo si apre una finestra separata. Esegui lì l’attività; questo passaggio si completa quando la ricevuta salvata dell’attività indica che è riuscita — aprire lo strumento o compilare i campi non lo completa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nこのために別のウインドウが開きます。そこでジョブを実行してください。このステップは、ジョブの保存済み受領書が成功を示したときに完了します。ツールを開いたりフィールドに入力したりしても完了しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n이를 위해 별도의 윈도우가 열립니다. 그곳에서 작업을 실행하십시오. 이 단계는 작업의 저장된 영수증이 성공했다고 표시할 때 완료됩니다. 도구를 열거나 필드를 채우는 것만으로는 완료되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nUma janela separada é aberta para isso. Execute a tarefa nela; esta etapa é concluída quando o recibo salvo da tarefa indica que ela foi bem-sucedida — abrir a ferramenta ou preencher os campos não a conclui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n将为此打开一个单独的窗口。请在其中运行该作业；当作业已存储的回执显示成功时，此步骤才算完成——打开工具或填写字段并不会完成此步骤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n將為此開啟一個獨立的視窗。請在其中執行該工作；當工作已儲存的收據顯示成功時，此步驟才算完成——開啟工具或填寫欄位並不會完成此步驟。"
          }
        }
      }
    },
