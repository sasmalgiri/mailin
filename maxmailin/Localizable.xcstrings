    "No similar messages were found among the newest %@ emails at the chosen similarity; older emails were not compared for similarity." : {
      "comment" : "Plural-correct text through Foundation's automatic grammar agreement (`^[1 group](inflect: true)` → \"1 group\", `^[2 group](inflect: true)` → \"",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter den neuesten %@ E-Mails wurden bei der gewählten Ähnlichkeit keine ähnlichen Nachrichten gefunden; ältere E-Mails wurden nicht auf Ähnlichkeit verglichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontraron mensajes similares entre los %@ correos más recientes con la similitud elegida; los correos más antiguos no se compararon por similitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun message similaire n’a été trouvé parmi les %@ e-mails les plus récents avec la similarité choisie ; les e-mails plus anciens n’ont pas été comparés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनी गई समानता पर नवीनतम %@ ईमेल में कोई मिलते-जुलते संदेश नहीं मिले; पुराने ईमेल की समानता के लिए तुलना नहीं की गई।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun messaggio simile trovato tra le %@ email più recenti con la somiglianza scelta; le email più vecchie non sono state confrontate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した類似度では、最新の %@ 件のメールに類似メッセージは見つかりませんでした。それより古いメールは類似性を比較していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 유사도에서 최신 이메일 %@개 중 유사한 메시지를 찾지 못했습니다. 이전 이메일은 유사성을 비교하지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma mensagem semelhante foi encontrada entre os %@ e-mails mais recentes na semelhança escolhida; e-mails mais antigos não foram comparados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所选相似度下，最新的 %@ 封邮件中未发现相似邮件；更早的邮件未做相似性比较。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所選相似度下，最新的 %@ 封郵件中未發現相似郵件；更早的郵件未做相似性比較。"
          }
        }
      }
    },
