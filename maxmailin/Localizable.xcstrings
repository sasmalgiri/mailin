    "This run is not complete: see what was not done below. Nothing here was entered by hand." : {
      "comment" : "A description of the user's task.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Durchlauf ist nicht vollständig: Was nicht erledigt wurde, sehen Sie unten. Nichts hier wurde von Hand eingegeben."
          }
        },
        "es" : {
          "stringUnit" : {
