        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "감사 로그, 파일 해시, 모든 증거 태그를 영구 삭제합니다. 실행 취소할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto apagará permanentemente o registro de auditoria, os hashes de arquivos e todas as etiquetas de evidência. Isto não pode ser desfeito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除审计日志、文件哈希值和所有证据标签。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將永久刪除稽核記錄、檔案雜湊值和所有證據標籤。此操作無法還原。"
          }
        }
      }
    },
    "This will reset all phases, checklists, and notes. This cannot be undone." : {
      "comment" : "Confirmation message for resetting the e-discovery workflow.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
