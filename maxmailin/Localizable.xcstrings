    "Turn your findings into a signed expert report, with evidence integrity verified before you attest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Befunde in einen signierten Gutachterbericht verwandeln, wobei die Integrität der Beweise vor Ihrer Bestätigung geprüft wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
