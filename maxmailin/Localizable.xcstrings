    "mailin tries again by itself at %@." : {
      "comment" : "Text that appears in the Mail account list to indicate that the account is trying to connect again at a future time. The argument is the time when the next retry will happen.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin versucht es um %@ von selbst erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin vuelve a intentarlo por sí solo a las %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin réessaie de lui-même à %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin %@ बजे अपने आप फिर से कोशिश करेगा।"
          }
        },
        "it" : {
