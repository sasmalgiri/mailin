    "Affected %lld · recovered %lld · already intact %lld · ambiguous %lld · missing source %lld · failed %lld." : {
      "comment" : "A six-line summary of the results of a raw source recovery operation. The first argument is the number of affected messages. The second argument is the number of recovered messages. The third argument is the number of messages that were already intact. The fourth argument is the number of ambiguous messages. The fifth argument is the number of messages missing their source. The sixth argument is the number of messages that failed to recover. If the recovery succeeded, a note is added to the end of the summary that says \"Recovered attachments are being indexed again.\" If the recovery succeeded, a note is added to the end of the summary that says \"Backup before the repair: ….\" If the recovery was cancelled, a note is added to the end of the summary that says \"Stopped after … of … sources; the",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betroffen %1$lld · wiederhergestellt %2$lld · bereits intakt %3$lld · mehrdeutig %4$lld · Quelle fehlt %5$lld · fehlgeschlagen %6$lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
