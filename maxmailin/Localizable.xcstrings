          }
        }
      }
    },
    "All processing stays on-device. Cloud AI is disabled in forensic mode to maintain chain of custody." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gesamte Verarbeitung bleibt auf dem Gerät. Cloud-KI ist im Forensikmodus deaktiviert, um die Beweiskette zu wahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el procesamiento permanece en el dispositivo. La IA en la nube está desactivada en modo forense para mantener la cadena de custodia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le traitement reste sur l'appareil. L'IA cloud est désactivée en mode forensique pour préserver la chaîne de conservation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सारा प्रसंस्करण डिवाइस पर रहता है। अभिरक्षा श्रृंखला बनाए रखने के लिए फ़ोरेंसिक मोड में क्लाउड AI अक्षम है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutta l'elaborazione resta sul dispositivo. L'IA cloud è disattivata in modalità forense per preservare la catena di custodia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての処理はデバイス上に留まります。証拠の連鎖を維持するため、フォレンジックモードではクラウド AI は無効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
