        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी %lld ईमेल सत्यापित — SHA-256 हैश सीलबंद मूल से मेल खाते हैं। ई-डिस्कवरी उत्पादन के लिए संग्रह की अखंडता की पुष्टि हुई।"
