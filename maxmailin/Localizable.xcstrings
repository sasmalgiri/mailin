          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Croiser deux jeux de données — les comparer, cartographier leurs recoupements et rendre compte de ce que révèlent les liens."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दो डेटासेट का मिलान करें — उनकी तुलना करें, जहाँ वे मेल खाते हैं उसे दर्शाएँ और बताएँ कि संबंध क्या दिखाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
