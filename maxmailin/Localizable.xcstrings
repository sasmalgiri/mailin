      }
    },
    "Pull quotable statements, read the surrounding threads for context, and attribute each quote to who said it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zitierfähige Aussagen herausziehen, die umgebenden Threads für den Kontext lesen und jedes Zitat der Person zuordnen, die es gesagt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extraer declaraciones citables, leer los hilos circundantes para el contexto y atribuir cada cita a quien la dijo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extraire des déclarations citables, lire les fils environnants pour le contexte et attribuer chaque citation à son auteur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उद्धरण योग्य कथन निकालें, संदर्भ के लिए आसपास के थ्रेड पढ़ें और हर उद्धरण को कहने वाले से जोड़ें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrarre dichiarazioni citabili, leggere i thread circostanti per il contesto e attribuire ogni citazione a chi l'ha detta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引用できる発言を抜き出し、前後のスレッドを読んで文脈を把握し、各引用を発言者に帰属させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인용할 만한 발언을 뽑아내고, 주변 스레드를 읽어 맥락을 파악하고, 각 인용을 말한 사람에게 귀속시킵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrair declarações citáveis, ler as conversas ao redor para contexto e atribuir cada citação a quem a disse."
