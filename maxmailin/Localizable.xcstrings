    "Screen the corpus in or out, code passages, and keep every decision on record" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Korpus ein- oder ausschließen, Passagen codieren und jede Entscheidung aktenkundig halten"
          }
        },
        "es" : {
          "stringUnit" : {
