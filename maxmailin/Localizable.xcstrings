    "Switch this page on to use anything below. These switches keep their positions meanwhile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalten Sie diese Seite ein, um alles Untenstehende zu nutzen. Diese Schalter behalten derweil ihre Stellung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa esta página para usar lo que hay abajo. Mientras tanto, estos interruptores mantienen su posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez cette page pour utiliser tout ce qui se trouve en dessous. Ces interrupteurs conservent leur position entre-temps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नीचे कुछ भी उपयोग करने के लिए यह पेज चालू करें। इस बीच ये स्विच अपनी स्थिति बनाए रखते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva questa pagina per usare tutto ciò che segue. Nel frattempo questi interruttori mantengono la loro posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下の機能を使うにはこのページをオンにしてください。その間、これらのスイッチは位置を保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래 항목을 사용하려면 이 페이지를 켜세요. 그동안 이 스위치들은 위치를 유지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligue esta página para usar qualquer item abaixo. Enquanto isso, estes interruptores mantêm suas posições."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开此页面以使用下方的任何功能。在此期间这些开关会保持其状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟此頁面以使用下方的任何功能。在此期間這些開關會保持其狀態。"
          }
        }
      }
