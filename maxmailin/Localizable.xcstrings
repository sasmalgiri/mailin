        }
      }
    },
    "Writes PST exports in the layout Outlook writes: folders, recipients, attachments, HTML and long bodies. Off: the earlier writer, which mailin reads but Outlook may not open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt PST-Exporte im Aufbau, den Outlook schreibt: Ordner, Empfänger, Anhänge, HTML und lange Texte. Aus: der frühere Schreiber, den mailin liest, Outlook aber möglicherweise nicht öffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe las exportaciones PST con la estructura que escribe Outlook: carpetas, destinatarios, adjuntos, HTML y cuerpos largos. Desactivado: el escritor anterior, que mailin lee pero que Outlook quizá no abra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrit les exports PST selon la structure qu’écrit Outlook : dossiers, destinataires, pièces jointes, HTML et corps longs. Désactivé : l’ancien rédacteur, que mailin lit mais qu’Outlook peut ne pas ouvrir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PST निर्यात उसी संरचना में लिखता है जिसमें Outlook लिखता है: फ़ोल्डर, प्राप्तकर्ता, अनुलग्नक, HTML और लंबे संदेश। बंद: पुराना राइटर, जिसे mailin पढ़ता है पर Outlook शायद न खोले।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrive le esportazioni PST con la struttura usata da Outlook: cartelle, destinatari, allegati, HTML e testi lunghi. Disattivato: lo scrittore precedente, che mailin legge ma Outlook potrebbe non aprire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outlook と同じ構造で PST を書き出します: フォルダ、宛先、添付ファイル、HTML、長い本文。オフ: 以前のライター（mailin では読めますが、Outlook では開けない場合があります）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outlook이 쓰는 구조로 PST를 내보냅니다: 폴더, 받는 사람, 첨부 파일, HTML, 긴 본문. 끔: 이전 작성기(mailin은 읽지만 Outlook에서는 열리지 않을 수 있음)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava as exportações PST na estrutura que o Outlook grava: pastas, destinatários, anexos, HTML e corpos longos. Desativado: o gravador anterior, que o mailin lê, mas o Outlook pode não abrir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 Outlook 的结构写入 PST 导出：文件夹、收件人、附件、HTML 和长正文。关闭：使用之前的写入器，mailin 可以读取，但 Outlook 可能无法打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依 Outlook 的結構寫入 PST 匯出：檔案夾、收件者、附件、HTML 和長內文。關閉：使用先前的寫入器，mailin 可以讀取，但 Outlook 可能無法開啟。"
          }
        }
      }
    },
    "Writes the database, attachment-text states, message files, source copies and receipts into a new folder with an inventory of every file's SHA-256. The search index is rebuilt on restore, not copied." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt Datenbank, Anhangstext-Zustände, Nachrichtendateien, Quellkopien und Quittungen in einen neuen Ordner mit einem Inventar der SHA-256 jeder Datei. Der Suchindex wird beim Wiederherstellen neu aufgebaut, nicht kopiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe la base de datos, los estados del texto de adjuntos, los archivos de mensajes, las copias de origen y los recibos en una carpeta nueva con un inventario del SHA-256 de cada archivo. El índice de búsqueda se reconstruye al restaurar, no se copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrit la base de données, les états du texte des pièces jointes, les fichiers de messages, les copies des sources et les reçus dans un nouveau dossier avec un inventaire du SHA-256 de chaque fichier. L'index de recherche est reconstruit à la restauration, pas copié."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेटाबेस, अनुलग्नक-पाठ की स्थितियाँ, संदेश फ़ाइलें, स्रोत प्रतियाँ और रसीदें एक नए फ़ोल्डर में लिखता है, साथ में हर फ़ाइल के SHA-256 की सूची। खोज अनुक्रमणिका पुनर्स्थापना पर फिर से बनाई जाती है, कॉपी नहीं होती।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrive database, stati del testo degli allegati, file dei messaggi, copie delle origini e ricevute in una nuova cartella con un inventario dello SHA-256 di ogni file. L'indice di ricerca viene ricostruito al ripristino, non copiato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データベース、添付ファイル本文の状態、メッセージファイル、ソースのコピー、受領書を新しいフォルダに書き出し、各ファイルの SHA-256 のインベントリを添えます。検索インデックスは復元時に再構築され、コピーされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터베이스, 첨부 파일 텍스트 상태, 메시지 파일, 원본 사본, 영수증을 새 폴더에 쓰고 각 파일의 SHA-256 인벤토리를 함께 저장합니다. 검색 색인은 복사되지 않고 복원 시 다시 만들어집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava o banco de dados, os estados de texto dos anexos, os arquivos de mensagens, as cópias de origem e os recibos em uma nova pasta com um inventário do SHA-256 de cada arquivo. O índice de pesquisa é reconstruído na restauração, não copiado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将数据库、附件文本状态、邮件文件、来源副本和回执写入一个新文件夹，并附上每个文件 SHA-256 的清单。搜索索引在恢复时重建，不会复制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將資料庫、附件文字狀態、郵件檔案、來源副本和回條寫入一個新資料夾，並附上每個檔案 SHA-256 的清單。搜尋索引在還原時重建，不會複製。"
          }
        }
      }
    },
