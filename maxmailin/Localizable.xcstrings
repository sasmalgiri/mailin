            "value" : "Ein E-Mail-erhaltendes Format: Diese Dateien können von mailin und anderen Mail-Apps wieder importiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un formato que conserva el correo: mailin y otras apps de correo pueden volver a importar estos archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un format qui préserve le courrier : ces fichiers peuvent être réimportés par mailin et par d'autres apps de messagerie."
