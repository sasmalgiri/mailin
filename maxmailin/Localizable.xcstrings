    "%@ has turned off exporting and sharing from mailin on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat das Exportieren und Teilen aus mailin auf diesem Gerät deaktiviert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha desactivado la exportación y el uso compartido desde mailin en este dispositivo."
          }
