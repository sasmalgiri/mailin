            "value" : "Dokumente verlassen Ihren Mac nie. Die Privilegierungsprüfung bleibt vertraulich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los documentos nunca salen de tu Mac. La revisión de privilegio permanece confidencial."
          }
