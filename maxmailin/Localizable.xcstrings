            "value" : "mailin पहले फ़ाइल लिखता है; फिर आप शेयर शीट से चुनते हैं कि उसे कहाँ सहेजना या भेजना है (जैसे “Files में सहेजें”)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
