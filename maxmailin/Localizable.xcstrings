    "mailin remembers emails you delete so re-importing the same file never silently brings them back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin merkt sich gelöschte E-Mails, damit ein erneuter Import derselben Datei sie nie stillschweigend zurückbringt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin recuerda los correos que eliminas para que volver a importar el mismo archivo nunca los recupere en silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin mémorise les e-mails que vous supprimez pour qu'une réimportation du même fichier ne les ramène jamais silencieusement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin आपके हटाए गए ईमेल याद रखता है ताकि वही फ़ाइल फिर आयात करने पर वे चुपचाप वापस न आएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin ricorda le email che elimini così reimportare lo stesso file non le riporta mai indietro in silenzio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin は削除したメールを記憶するため、同じファイルを再読み込みしても気づかないうちに戻ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin은 삭제한 이메일을 기억하므로 같은 파일을 다시 가져와도 조용히 되돌아오지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mailin lembra os e-mails que você apaga para que reimportar o mesmo arquivo nunca os traga de volta silenciosamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin 会记住您删除的邮件，因此重新导入同一文件绝不会悄悄将其带回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mailin 會記住您刪除的郵件，因此重新匯入同一檔案絕不會悄悄將其帶回。"
          }
        }
      }
    },
