    "Not the same set: the receipt covered %@ emails, the scope now gives %lld. The archive changed since the job ran." : {
      "comment" : "The warning message when the scope's fingerprint does not match the receipt's. The first argument is the number of emails the receipt says were covered. The second argument is the number of emails the scope actually found.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht dieselbe Menge: Der Beleg umfasste %@ E-Mails, der Umfang ergibt jetzt %lld. Das Archiv hat sich seit dem Auftrag geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not the same set: the receipt covered %1$@ emails, the scope now gives %2$lld. The archive changed since the job ran."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es el mismo conjunto: el recibo abarcaba %@ correos y el alcance ahora da %lld. El archivo cambió desde que se ejecutó el trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n’est pas le même ensemble : le reçu couvrait %@ e-mails, le périmètre en donne maintenant %lld. L’archive a changé depuis l’exécution de la tâche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समान समूह नहीं: रसीद में %@ ईमेल थे, दायरा अब %lld देता है। कार्य चलने के बाद आर्काइव बदल गया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è lo stesso insieme: la ricevuta copriva %@ email, ora l’ambito ne restituisce %lld. L’archivio è cambiato dall’esecuzione dell’attività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ集合ではありません: 受領記録の対象は %@ 件でしたが、現在の範囲では %lld 件です。ジョブの実行後にアーカイブが変更されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 집합이 아닙니다: 영수증은 이메일 %@개를 다뤘지만 지금 범위는 %lld개입니다. 작업 실행 이후 보관함이 바뀌었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é o mesmo conjunto: o recibo abrangia %@ e-mails, o escopo agora dá %lld. O arquivo mudou desde que a tarefa foi executada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不是同一组：回执涵盖 %@ 封邮件，而现在的范围得到 %lld 封。任务运行后归档已更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不是同一組：收據涵蓋 %@ 封郵件，而現在的範圍得到 %lld 封。作業執行後封存已變更。"
          }
        }
      }
    },
