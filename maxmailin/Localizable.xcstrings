          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".docx/.xlsx/.pptx 안의 이보다 큰 파트는 목록에 오르고 문서는 부분으로 표시됩니다. 조용히 버려지지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma parte maior dentro de um .docx/.xlsx/.pptx é listada e o documento marcado como parcial, nunca descartada em silêncio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".docx/.xlsx/.pptx 中超过此大小的部件会被列出，文档标记为部分读取，绝不会被悄悄丢弃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".docx/.xlsx/.pptx 中超過此大小的部件會被列出，文件標記為部分讀取，絕不會被悄悄丟棄。"
          }
        }
      }
    },
    "A part or member larger than this is listed and the attachment marked partial, never silently dropped. Resume on that attachment doubles the ceiling for its next run." : {
      "comment" : "The text for the limit on the amount of data that can be read from a single attachment during a run.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein größerer Teil oder Eintrag wird aufgelistet und der Anhang als teilweise markiert, nie stillschweigend verworfen. „Fortsetzen“ an diesem Anhang verdoppelt die Grenze für den nächsten Durchlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una parte o miembro mayor que esto se lista y el adjunto se marca como parcial, nunca se descarta en silencio. «Reanudar» en ese adjunto duplica el límite para su siguiente ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une partie ou un membre plus grand est listé et la pièce jointe marquée partielle, jamais écartée en silence. « Reprendre » sur cette pièce jointe double la limite pour la passe suivante."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे बड़ा भाग या सदस्य सूचीबद्ध होता है और अनुलग्नक आंशिक चिह्नित होता है, चुपचाप कभी नहीं छोड़ा जाता। उस अनुलग्नक पर ‘जारी रखें’ अगले दौर के लिए सीमा दोगुनी करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una parte o un membro più grande viene elencato e l'allegato segnato come parziale, mai scartato in silenzio. «Riprendi» su quell'allegato raddoppia il limite per l'esecuzione successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これより大きいパートやメンバーは一覧に示され、添付ファイルは「一部」と記録されます。黙って捨てられることはありません。その添付ファイルで「再開」すると次回の上限が 2 倍になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이보다 큰 부분이나 구성원은 목록에 표시되고 첨부 파일은 부분 읽음으로 표시되며, 조용히 버려지지 않습니다. 해당 첨부 파일에서 재개하면 다음 실행의 한도가 두 배가 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma parte ou membro maior que isto é listado e o anexo marcado como parcial, nunca descartado em silêncio. Retomar nesse anexo dobra o limite para a próxima execução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过此值的部分或成员会被列出，附件标记为部分读取，绝不会被静默丢弃。对该附件点击“继续”会将下次运行的上限加倍。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過此值的部分或成員會被列出，附件標記為部分讀取，絕不會被靜默丟棄。對該附件按「繼續」會將下次執行的上限加倍。"
          }
        }
      }
    },
    "A phrase longer than %lld characters is matched as all its words in the same text." : {
      "extractionState" : "stale",
      "localizations" : {
