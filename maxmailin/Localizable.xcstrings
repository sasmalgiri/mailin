        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um relatório, não um arquivo de e-mail: esta saída não pode ser reimportada como e-mail. Guarde uma exportação mbox ou .eml como cópia restaurável."
          }
        },
        "zh-Hans" : {
