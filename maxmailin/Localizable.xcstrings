    "A message larger than this is kept by byte range and exported byte for byte, but its text is not searchable; the import receipt counts such messages." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine größere Nachricht wird per Bytebereich aufbewahrt und Byte für Byte exportiert, ihr Text ist jedoch nicht durchsuchbar; die Importquittung zählt solche Nachrichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mensaje mayor se conserva por intervalo de bytes y se exporta byte a byte, pero su texto no se puede buscar; el recibo de importación cuenta esos mensajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un message plus grand est conservé par plage d'octets et exporté octet par octet, mais son texte n'est pas interrogeable ; le reçu d'importation compte ces messages."
          }
        },
        "hi" : {
          "stringUnit" : {
