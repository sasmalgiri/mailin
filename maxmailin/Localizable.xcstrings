          }
        }
      }
    },
    "An import is running. Let it finish or cancel it before moving the archive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Import läuft. Lassen Sie ihn abschließen oder brechen Sie ihn ab, bevor Sie das Archiv verschieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una importación en curso. Deja que termine o cancélala antes de mover el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un import est en cours. Laissez-le se terminer ou annulez-le avant de déplacer l'archive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक आयात चल रहा है। संग्रह स्थानांतरित करने से पहले इसे पूरा होने दें या रद्द करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È in corso un'importazione. Lasciala finire o annullala prima di spostare l'archivio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込みが実行中です。アーカイブを移動する前に完了させるか、キャンセルしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져오기가 실행 중입니다. 보관함을 이동하기 전에 완료되도록 두거나 취소하세요."
