    "Leave blank to auto-detect from archive, or enter your email to identify sent vs received" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer lassen, um automatisch aus dem Archiv zu erkennen, oder Ihre E-Mail eingeben, um Gesendet und Empfangen zu unterscheiden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjalo en blanco para detectarlo del archivo, o introduce tu correo para distinguir enviados de recibidos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vide pour détecter automatiquement depuis l'archive, ou saisissez votre e-mail pour distinguer envoyés et reçus"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संग्रह से स्वतः पहचान के लिए खाली छोड़ें, या भेजे/प्राप्त की पहचान के लिए अपना ईमेल दर्ज करें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto per rilevare automaticamente dall'archivio, oppure inserisci la tua email per distinguere inviate e ricevute"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空欄にするとアーカイブから自動検出します。送信と受信を区別するには自分のメールアドレスを入力してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비워 두면 보관함에서 자동 감지하고, 보낸/받은 메일을 구분하려면 내 이메일을 입력하세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe em branco para detectar automaticamente do arquivo, ou digite seu e-mail para distinguir enviados de recebidos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空则从归档自动检测，或输入您的邮箱以区分已发送与已接收"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空則從封存自動偵測，或輸入您的郵件地址以區分已傳送與已接收"
          }
        }
      }
    },
