    "Lists the email addresses, phone numbers and web addresses found in each body as the columns emails_in_body, phones and urls, for building a contact or link catalogue. Nothing is tagged." : {
      "comment" : "Help text for a bundled script that lists email addresses, phone numbers and web addresses found in the body of each email.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listet die im Text jeder E-Mail gefundenen E-Mail-Adressen, Telefonnummern und Webadressen in den Spalten emails_in_body, phones und urls, für einen Kontakt- oder Linkkatalog. Nichts wird getaggt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enumera las direcciones de correo, teléfonos y direcciones web encontrados en cada cuerpo en las columnas emails_in_body, phones y urls, para crear un catálogo de contactos o enlaces. No etiqueta nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste les adresses e-mail, numéros de téléphone et adresses web trouvés dans chaque corps dans les colonnes emails_in_body, phones et urls, pour constituer un catalogue de contacts ou de liens. Rien n’est étiqueté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर बॉडी में मिले ईमेल पते, फ़ोन नंबर और वेब पते emails_in_body, phones और urls कॉलम में लिखता है, संपर्क या लिंक सूची बनाने के लिए। कुछ टैग नहीं होता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elenca indirizzi email, numeri di telefono e indirizzi web trovati in ogni corpo nelle colonne emails_in_body, phones e urls, per creare un catalogo di contatti o link. Nulla viene taggato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各本文で見つかったメールアドレス、電話番号、Web アドレスを列 emails_in_body、phones、urls に書き出し、連絡先やリンクの一覧作りに使います。タグは付けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 본문에서 찾은 이메일 주소, 전화번호, 웹 주소를 emails_in_body, phones, urls 열에 나열해 연락처나 링크 목록을 만듭니다. 태그는 붙이지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista os endereços de e-mail, telefones e endereços web encontrados em cada corpo nas colunas emails_in_body, phones e urls, para montar um catálogo de contatos ou links. Nada é etiquetado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把每封正文中找到的邮件地址、电话号码和网址分别列入 emails_in_body、phones 和 urls 列，用于建立联系人或链接目录。不加标签。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把每封內文中找到的郵件位址、電話號碼和網址分別列入 emails_in_body、phones 和 urls 欄位，用於建立聯絡人或連結目錄。不加標籤。"
          }
        }
      }
    },
    "Lists the next %lld folders, busiest first. Every folder in the archive can be reached this way or through the filter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listet die nächsten %lld Ordner, die vollsten zuerst. Jeder Ordner im Archiv ist so oder über den Filter erreichbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra las siguientes %lld carpetas, las más llenas primero. Cada carpeta del archivo se puede alcanzar así o mediante el filtro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les %lld dossiers suivants, les plus remplis d'abord. Chaque dossier de l'archive est accessible ainsi ou par le filtre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगले %lld फ़ोल्डर सूचीबद्ध करता है, सबसे व्यस्त पहले। संग्रह का हर फ़ोल्डर इस तरह या फ़िल्टर से पहुँचा जा सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elenca le prossime %lld cartelle, le più piene per prime. Ogni cartella dell'archivio è raggiungibile così o tramite il filtro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の%lldフォルダを、件数の多い順に表示します。アーカイブ内のすべてのフォルダにこの方法または絞り込みで到達できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 %lld개 폴더를 많은 순으로 나열합니다. 아카이브의 모든 폴더는 이 방법 또는 필터로 찾을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista as próximas %lld pastas, as mais cheias primeiro. Toda pasta do arquivo pode ser alcançada assim ou pelo filtro."
          }
        },
