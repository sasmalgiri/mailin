    "The partial file is not reachable. Reconnect the drive that holds it, then choose Recover and resume again." : {
      "comment" : "Text displayed in a warning banner when the partial file is not reachable.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Teildatei ist nicht erreichbar. Schließen Sie das Laufwerk, auf dem sie liegt, wieder an und wählen Sie dann erneut „Wiederherstellen und fortsetzen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder al archivo parcial. Vuelve a conectar la unidad que lo contiene y elige de nuevo Recuperar y reanudar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier partiel est inaccessible. Reconnectez le disque qui le contient, puis choisissez à nouveau Récupérer et reprendre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आंशिक फ़ाइल तक पहुँचा नहीं जा सकता। उसे रखने वाली ड्राइव फिर से जोड़ें, फिर दोबारा पुनर्प्राप्त करें और जारी रखें चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file parziale non è raggiungibile. Ricollega l’unità che lo contiene, poi scegli di nuovo Recupera e riprendi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分ファイルにアクセスできません。ファイルがあるドライブを接続し直してから、もう一度「復旧して再開」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부분 파일에 접근할 수 없습니다. 파일이 있는 드라이브를 다시 연결한 다음 ‘복구 후 재개’를 다시 선택하세요."
