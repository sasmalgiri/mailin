    "Analyzes the emotional tone of each contact's emails — positive, negative, or neutral — to spot mood changes or tension" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysiert den emotionalen Ton der E-Mails jedes Kontakts — positiv, negativ oder neutral —, um Stimmungswechsel oder Spannungen zu erkennen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza el tono emocional de los correos de cada contacto — positivo, negativo o neutro — para detectar cambios de ánimo o tensión"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyse le ton émotionnel des e-mails de chaque contact — positif, négatif ou neutre — pour repérer les changements d'humeur ou les tensions"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर संपर्क के ईमेल के भावनात्मक स्वर का विश्लेषण करता है — सकारात्मक, नकारात्मक या तटस्थ — ताकि मनोदशा में बदलाव या तनाव पकड़ा जा सके"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizza il tono emotivo delle email di ogni contatto — positivo, negativo o neutro — per individuare cambi d'umore o tensioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各連絡先のメールの感情的なトーン — ポジティブ、ネガティブ、ニュートラル — を解析し、気分の変化や緊張を見つけます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 연락처 이메일의 감정 톤(긍정, 부정, 중립)을 분석하여 분위기 변화나 긴장을 포착합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analisa o tom emocional dos e-mails de cada contato — positivo, negativo ou neutro — para detectar mudanças de humor ou tensão"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析每位联系人邮件的情绪基调——正面、负面或中性——以发现情绪变化或紧张关系"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析每位聯絡人郵件的情緒基調——正面、負面或中立——以發現情緒變化或緊張關係"
          }
        }
      }
    },
