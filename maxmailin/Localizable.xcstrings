          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 AI 总结会话、发现矛盾并构建时间线"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 AI 總結討論串、發現矛盾並建立時間軸"
          }
        }
      }
    },
    "Use an app password created in Fastmail's Privacy & Security settings." : {
      "comment" : "Text for a note in the Mail workspace when signing in to Fastmail.",
