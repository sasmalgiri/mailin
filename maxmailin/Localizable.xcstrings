    "About %@ of text from your archive would leave this Mac and be processed by %@ under its terms. Nothing is sent unless you allow it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa %1$@ Text aus Ihrem Archiv würde diesen Mac verlassen und von %2$@ gemäß dessen Bedingungen verarbeitet. Nichts wird gesendet, bevor Sie es erlauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "About %1$@ of text from your archive would leave this Mac and be processed by %2$@ under its terms. Nothing is sent unless you allow it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alrededor de %1$@ de texto de tu archivo saldría de este Mac y sería procesado por %2$@ según sus condiciones. No se envía nada sin tu permiso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ %1$@ de texte de votre archive quitterait ce Mac pour être traité par %2$@ selon ses conditions. Rien n'est envoyé sans votre accord."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके संग्रह का लगभग %1$@ पाठ इस Mac से बाहर जाकर %2$@ द्वारा उसकी शर्तों के तहत संसाधित होगा। आपकी अनुमति के बिना कुछ नहीं भेजा जाता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circa %1$@ di testo del tuo archivio lascerebbe questo Mac per essere elaborato da %2$@ secondo le sue condizioni. Nulla viene inviato senza il tuo consenso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブのテキスト約 %1$@ がこの Mac を離れ、%2$@ によってその利用規約のもとで処理されます。許可しない限り何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함의 텍스트 약 %1$@이(가) 이 Mac을 떠나 %2$@의 약관에 따라 처리됩니다. 허용하지 않으면 아무것도 전송되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca de %1$@ de texto do seu arquivo sairia deste Mac e seria processado por %2$@ sob os termos dele. Nada é enviado sem a sua permissão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您归档中约 %1$@ 的文本将离开这台 Mac，由 %2$@ 按其条款处理。未经您允许不会发送任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您封存中約 %1$@ 的文字將離開這部 Mac，由 %2$@ 依其條款處理。未經您允許不會傳送任何內容。"
          }
        }
      }
    },
