    "The report will identify all emails containing the data subject's information, inventory PII, analyze data flows, and provide GDPR compliance recommendations." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bericht identifiziert alle E-Mails mit Informationen der betroffenen Person, inventarisiert personenbezogene Daten, analysiert Datenflüsse und gibt Empfehlungen zur DSGVO-Konformität."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El informe identificará todos los correos que contengan información del interesado, inventariará la PII, analizará los flujos de datos y ofrecerá recomendaciones de cumplimiento del RGPD."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rapport identifiera tous les e-mails contenant les informations de la personne concernée, inventoriera les données personnelles, analysera les flux de données et fournira des recommandations de conformité RGPD."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिपोर्ट डेटा विषय की जानकारी वाले सभी ईमेल की पहचान करेगी, PII की सूची बनाएगी, डेटा प्रवाह का विश्लेषण करेगी और GDPR अनुपालन सिफ़ारिशें देगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il report identificherà tutte le email contenenti le informazioni dell'interessato, farà l'inventario delle PII, analizzerà i flussi di dati e fornirà raccomandazioni per la conformità GDPR."
          }
        },
        "ja" : {
          "stringUnit" : {
