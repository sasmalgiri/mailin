    "%lld emails analysed; %lld need attention — the strongest %lld are listed. Thread outcomes use recent activity." : {
      "comment" : "A message that describes the number of emails that were analysed and the number of emails that need attention. If the number of urgent emails is greater than the number of emails in the summary, a note will be appended that highlights the number of urgent emails that are not included in the summary.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld E-Mails analysiert; %lld brauchen Aufmerksamkeit — die stärksten %lld sind aufgeführt. Gesprächsverläufe beruhen auf der jüngsten Aktivität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld emails analysed; %2$lld need attention — the strongest %3$lld are listed. Thread outcomes use recent activity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld correos analizados; %lld requieren atención — se muestran los %lld más destacados. Los desenlaces de las conversaciones usan la actividad reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld e-mails analysés ; %lld demandent votre attention — les %lld plus marqués sont listés. L’issue des conversations s’appuie sur l’activité récente."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ईमेल का विश्लेषण हुआ; %lld पर ध्यान देने की ज़रूरत है — सबसे प्रमुख %lld सूचीबद्ध हैं। बातचीत के परिणाम हाल की गतिविधि पर आधारित हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld email analizzate; %lld richiedono attenzione — sono elencate le %lld più rilevanti. Gli esiti delle conversazioni si basano sull’attività recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件のメールを分析しました。%lld 件に対応が必要です — 上位 %lld 件を表示しています。会話の結末は最近のアクティビティに基づきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일 %lld개를 분석했습니다. %lld개에 주의가 필요하며 가장 두드러진 %lld개를 표시합니다. 대화 결과는 최근 활동을 기준으로 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld e-mails analisados; %lld precisam de atenção — os %lld mais relevantes estão listados. Os desfechos das conversas usam a atividade recente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已分析 %lld 封邮件；%lld 封需要关注 — 列出了最突出的 %lld 封。对话走向基于最近的活动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已分析 %lld 封郵件；%lld 封需要注意 — 列出最突出的 %lld 封。對話走向依據最近的活動。"
          }
        }
      }
    },
