        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source originale de l'e-mail, y compris tous les en-têtes et l'encodage MIME"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी हेडर और MIME एन्कोडिंग सहित मूल ईमेल स्रोत"
