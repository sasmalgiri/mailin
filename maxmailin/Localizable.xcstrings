    "Searched %lld emails using your custodian and date filters. %lld emails match your criteria across %lld unique domain(s). Refine filters to narrow or broaden your identification scope." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld E-Mails mit Ihren Verwahrer- und Datumsfiltern durchsucht. %2$lld E-Mails entsprechen Ihren Kriterien in %3$lld eindeutigen Domain(s). Verfeinern Sie die Filter, um den Identifizierungsumfang einzugrenzen oder zu erweitern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Searched %1$lld emails using your custodian and date filters. %2$lld emails match your criteria across %3$lld unique domain(s). Refine filters to narrow or broaden your identification scope."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se buscaron %1$lld correos con tus filtros de custodio y fecha. %2$lld correos cumplen tus criterios en %3$lld dominio(s) único(s). Ajusta los filtros para acotar o ampliar el ámbito de identificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld e-mails recherchés avec vos filtres de dépositaire et de date. %2$lld e-mails correspondent à vos critères sur %3$lld domaine(s) unique(s). Affinez les filtres pour restreindre ou élargir le périmètre d'identification."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके संरक्षक और तिथि फ़िल्टर के साथ %1$lld ईमेल खोजे गए। %2$lld ईमेल %3$lld अद्वितीय डोमेन में आपके मानदंडों से मेल खाते हैं। पहचान के दायरे को सीमित या विस्तृत करने के लिए फ़िल्टर समायोजित करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cercate %1$lld email con i tuoi filtri di custode e data. %2$lld email corrispondono ai tuoi criteri in %3$lld dominio/i univoco/i. Affina i filtri per restringere o ampliare l'ambito di identificazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管者と日付のフィルタで %1$lld 件のメールを検索しました。%2$lld 件のメールが条件に一致し、%3$lld 個の一意なドメインにまたがっています。フィルタを調整して識別範囲を絞り込むか広げてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관자 및 날짜 필터로 이메일 %1$lld개를 검색했습니다. %2$lld개의 이메일이 고유 도메인 %3$lld개에 걸쳐 조건과 일치합니다. 필터를 조정하여 식별 범위를 좁히거나 넓히세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foram pesquisados %1$lld e-mails com seus filtros de custodiante e data. %2$lld e-mails correspondem aos seus critérios em %3$lld domínio(s) único(s). Refine os filtros para restringir ou ampliar o escopo de identificação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已使用您的保管人和日期筛选条件搜索了 %1$lld 封邮件。%2$lld 封邮件符合条件，涉及 %3$lld 个唯一域名。调整筛选条件以缩小或扩大识别范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已使用您的保管人和日期篩選條件搜尋了 %1$lld 封郵件。%2$lld 封郵件符合條件，涉及 %3$lld 個唯一網域。調整篩選條件以縮小或擴大識別範圍。"
          }
        }
      }
    },
    "Searched every message. %@ very large messages are indexed only in their first %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Nachricht durchsucht. %1$@ sehr große Nachrichten sind nur in ihren ersten %2$@ indiziert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Searched every message. %1$@ very large messages are indexed only in their first %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se buscó en todos los mensajes. %1$@ mensajes muy grandes están indexados solo en sus primeros %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les messages ont été recherchés. %1$@ très grands messages ne sont indexés que sur leurs premiers %2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर संदेश खोजा गया। %1$@ बहुत बड़े संदेश केवल अपने पहले %2$@ में अनुक्रमित हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricerca effettuata su ogni messaggio. %1$@ messaggi molto grandi sono indicizzati solo nei primi %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
