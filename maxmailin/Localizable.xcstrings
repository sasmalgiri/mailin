    "%@ stays off until you allow the extra permission." : {
      "comment" : "Text displayed in a message in the UI.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ bleibt ausgeschaltet, bis Sie die zusätzliche Berechtigung erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» sigue desactivado hasta que permitas el permiso adicional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » reste désactivé jusqu'à ce que vous accordiez l'autorisation supplémentaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब तक आप अतिरिक्त अनुमति नहीं देते, “%@” बंद रहता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» resta disattivato finché non consenti l'autorizzazione aggiuntiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加の権限を許可するまで、「%@」はオフのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가 권한을 허용할 때까지 ‘%@’은(는) 꺼진 상태로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” continua desativado até você permitir a permissão adicional."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你允许额外权限之前，“%@”保持关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你允許額外權限之前，「%@」保持關閉。"
          }
        }
      }
    },
    "%@ This tool belongs to the %@ page. Turn the page on in Settings ▸ Modules to use it." : {
