    "Alternatively, “Detect on this Mac” looks in ~/Library/Mail for mailboxes Mail already stores locally." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ sucht „Auf diesem Mac erkennen“ in ~/Library/Mail nach Postfächern, die Mail bereits lokal speichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativamente, «Detectar en este Mac» busca en ~/Library/Mail los buzones que Mail ya guarda localmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinon, « Détecter sur ce Mac » cherche dans ~/Library/Mail les boîtes que Mail stocke déjà localement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वैकल्पिक रूप से, “इस Mac पर पता लगाएँ” ~/Library/Mail में उन मेलबॉक्स को खोजता है जिन्हें Mail पहले से स्थानीय रूप से रखता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In alternativa, «Rileva su questo Mac» cerca in ~/Library/Mail le caselle che Mail archivia già localmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "または、「この Mac で検出」は ~/Library/Mail 内で、メールがすでにローカルに保存しているメールボックスを探します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또는 “이 Mac에서 감지”는 ~/Library/Mail에서 Mail이 이미 로컬에 저장한 메일함을 찾습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativamente, “Detectar neste Mac” procura em ~/Library/Mail as caixas que o Mail já armazena localmente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者，“在此 Mac 上检测”会在 ~/Library/Mail 中查找“邮件”已在本地存储的邮箱。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者，「在此 Mac 上偵測」會在 ~/Library/Mail 中尋找「郵件」已在本機儲存的信箱。"
          }
        }
      }
    },
