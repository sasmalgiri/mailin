    "Shows HTML email in an isolated renderer with scripts off and all remote content blocked, so opening a message never contacts the sender and a large message cannot freeze the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt HTML-E-Mails in einem isolierten Renderer mit deaktivierten Skripten und blockierten externen Inhalten, sodass das Öffnen einer Nachricht nie den Absender kontaktiert und eine große Nachricht die App nicht einfrieren kann."
          }
        },
        "es" : {
          "stringUnit" : {
