    "A BagIt bag with every original message and PREMIS metadata — the archival standard" : {
      "comment" : "A description of the archival standard for email preservation.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein BagIt-Paket mit jeder Originalnachricht und PREMIS-Metadaten — der Archivstandard"
          }
        },
        "es" : {
          "stringUnit" : {
