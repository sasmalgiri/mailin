    "Round up receipts and records — search, select, collect attachments, and export them in one go." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belege und Unterlagen zusammentragen — suchen, auswählen, Anhänge sammeln und in einem Zug exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reunir recibos y registros — buscar, seleccionar, recopilar adjuntos y exportarlos de una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rassembler reçus et justificatifs — rechercher, sélectionner, collecter les pièces jointes et tout exporter d'un coup."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रसीदें और रिकॉर्ड एकत्र करें — खोजें, चुनें, अटैचमेंट एकत्र करें और एक बार में निर्यात करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccogliere ricevute e documenti — cercare, selezionare, raccogliere gli allegati ed esportarli in un colpo solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "領収書や記録をまとめて収集 — 検索、選択、添付ファイルの収集を行い、一度に書き出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영수증과 기록 모으기 — 검색하고, 선택하고, 첨부 파일을 모아 한 번에 내보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reunir recibos e registros — buscar, selecionar, coletar anexos e exportá-los de uma vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汇集收据和记录 — 搜索、选择、收集附件并一次性导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彙集收據與紀錄 — 搜尋、選取、收集附件並一次匯出。"
          }
        }
      }
    },
    "Round up your key contacts — analyze who you talk to, spot the patterns, pick the keepers, and export them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre wichtigsten Kontakte zusammentragen — analysieren, mit wem Sie sprechen, Muster erkennen, die Wichtigen auswählen und exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reunir tus contactos clave — analizar con quién hablas, detectar patrones, elegir los importantes y exportarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rassembler vos contacts clés — analyser avec qui vous échangez, repérer les schémas, choisir ceux à garder et les exporter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने प्रमुख संपर्क एकत्र करें — विश्लेषण करें कि आप किससे बात करते हैं, पैटर्न पहचानें, रखने लायक चुनें और निर्यात करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccogliere i tuoi contatti chiave — analizzare con chi parli, individuare gli schemi, scegliere quelli da tenere ed esportarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主要な連絡先をまとめる — やり取りの相手を分析し、傾向を見つけ、残す相手を選んで書き出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주요 연락처 모으기 — 대화 상대를 분석하고, 패턴을 찾고, 남길 사람을 골라 내보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reunir seus contatos principais — analisar com quem você fala, identificar padrões, escolher os importantes e exportá-los."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汇总你的主要联系人 — 分析与你沟通的人、发现模式、挑选要保留的人并导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彙整你的主要聯絡人 — 分析與你往來的人、找出模式、挑選要保留的人並匯出。"
          }
        }
      }
    },
