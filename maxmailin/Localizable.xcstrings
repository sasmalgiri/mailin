    "Apple Intelligence re-checks every entry and removes ones that aren't really PII — timestamps, order numbers, tracking IDs" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence prüft jeden Eintrag erneut und entfernt, was keine echten personenbezogenen Daten sind — Zeitstempel, Bestellnummern, Sendungsnummern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence vuelve a comprobar cada entrada y elimina las que no son realmente PII — marcas de tiempo, números de pedido, códigos de seguimiento"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence revérifie chaque entrée et retire celles qui ne sont pas réellement des données personnelles — horodatages, numéros de commande, numéros de suivi"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence हर प्रविष्टि की दोबारा जाँच करता है और उन्हें हटाता है जो वास्तव में PII नहीं हैं — टाइमस्टैम्प, ऑर्डर नंबर, ट्रैकिंग ID"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ricontrolla ogni voce e rimuove quelle che non sono davvero PII — timestamp, numeri d'ordine, codici di tracciamento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence が各エントリを再チェックし、実際には個人情報でないもの — タイムスタンプ、注文番号、追跡 ID — を取り除きます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence가 각 항목을 다시 확인하고 실제 PII가 아닌 항목(타임스탬프, 주문 번호, 추적 ID)을 제거합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple Intelligence reverifica cada entrada e remove as que não são realmente PII — carimbos de data/hora, números de pedido, códigos de rastreamento"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 会复查每条记录，并移除并非真正 PII 的内容——时间戳、订单号、追踪编号"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 會重新檢查每筆項目，並移除並非真正 PII 的內容——時間戳記、訂單編號、追蹤編號"
          }
        }
      }
    },
