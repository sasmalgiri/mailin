    "Electronic discovery — the process of identifying, collecting, and producing electronic documents for a lawsuit, investigation, or regulatory matter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electronic Discovery — der Prozess des Identifizierens, Sammelns und Vorlegens elektronischer Dokumente für einen Rechtsstreit, eine Ermittlung oder eine behördliche Angelegenheit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubrimiento electrónico — el proceso de identificar, recopilar y producir documentos electrónicos para un litigio, una investigación o un asunto regulatorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découverte électronique — le processus d'identification, de collecte et de production de documents électroniques pour un procès, une enquête ou une affaire réglementaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इलेक्ट्रॉनिक डिस्कवरी — मुकदमे, जाँच या नियामक मामले के लिए इलेक्ट्रॉनिक दस्तावेज़ों की पहचान, संग्रहण और प्रस्तुति की प्रक्रिया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electronic discovery — il processo di identificazione, raccolta e produzione di documenti elettronici per una causa, un'indagine o una questione normativa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電子証拠開示 — 訴訟、調査、規制対応のために電子文書を特定、収集、提出するプロセス。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전자 증거 개시 — 소송, 조사 또는 규제 사안을 위해 전자 문서를 식별, 수집, 제출하는 과정입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descoberta eletrônica — o processo de identificar, coletar e produzir documentos eletrônicos para um processo judicial, investigação ou questão regulatória."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电子取证 — 为诉讼、调查或监管事项识别、收集和出示电子文档的过程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電子取證 — 為訴訟、調查或監管事項識別、收集和提出電子文件的過程。"
          }
        }
      }
    },
