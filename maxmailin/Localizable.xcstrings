        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTML 이메일을 스크립트를 끄고 원격 콘텐츠를 모두 차단한 격리된 렌더러로 표시하므로, 메시지를 열어도 보낸 사람에게 연결하지 않고 큰 메시지 때문에 앱이 멈추지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
