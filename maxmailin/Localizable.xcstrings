    },
    "This copy of mailin is not allowed to keep sign-ins in the Keychain. Install mailin from the App Store or TestFlight and sign in again." : {
      "comment" : "Error message when the app is not allowed to store sign-ins in the Keychain.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kopie von mailin darf keine Anmeldungen im Schlüsselbund aufbewahren. Installieren Sie mailin aus dem App Store oder über TestFlight und melden Sie sich erneut an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de mailin no puede guardar inicios de sesión en el llavero. Instala mailin desde el App Store o TestFlight y vuelve a iniciar sesión."
