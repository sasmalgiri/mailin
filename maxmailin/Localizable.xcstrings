          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り込んだメールは今すぐ検索できます（ヘッダと本文）。添付ファイルの本文：残り %1$lld 件、完了 %2$lld 件 — %3$@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져온 메일은 지금 검색할 수 있습니다(헤더와 본문). 첨부 파일 텍스트: 남은 메일 %1$lld개, 완료 %2$lld개 — %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O e-mail importado já pode ser pesquisado (cabeçalhos e corpos). Texto dos anexos: %1$lld e-mails ainda por indexar, %2$lld concluídos — %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
