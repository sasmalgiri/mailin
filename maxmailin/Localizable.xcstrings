          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全重复项的内容完全相同（主题、正文和邮件头）。移除重复项可在不丢失信息的情况下减小归档体积。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
