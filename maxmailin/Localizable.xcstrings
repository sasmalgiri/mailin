        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データ収集はゼロ。すべてデバイス上で動作し、クラウド AI はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터 수집 없음. 모든 것이 기기에서 실행되며 클라우드 AI는 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
