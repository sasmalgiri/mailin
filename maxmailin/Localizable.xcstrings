    "Analyses each email once and stores the results, so analysis tools answer from the index instantly for the whole archive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysiert jede E-Mail einmal und speichert die Ergebnisse, sodass Analysewerkzeuge sofort aus dem Index für das gesamte Archiv antworten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza cada correo una vez y guarda los resultados, para que las herramientas de análisis respondan al instante desde el índice para todo el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyse chaque e-mail une fois et enregistre les résultats, pour que les outils d’analyse répondent instantanément depuis l’index pour toute l’archive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर ईमेल का एक बार विश्लेषण करके परिणाम सहेजता है, ताकि विश्लेषण टूल पूरे आर्काइव के लिए इंडेक्स से तुरंत उत्तर दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizza ogni email una volta e salva i risultati, così gli strumenti di analisi rispondono subito dall’indice per l’intero archivio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各メールを一度だけ分析して結果を保存するため、分析ツールはアーカイブ全体についてインデックスから即座に回答します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 이메일을 한 번만 분석해 결과를 저장하므로, 분석 도구가 전체 보관함에 대해 색인에서 즉시 답합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analisa cada e-mail uma vez e salva os resultados, para que as ferramentas de análise respondam na hora a partir do índice para o arquivo inteiro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每封邮件只分析一次并保存结果，因此分析工具可直接从索引即时回答整个归档的问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每封郵件只分析一次並儲存結果，因此分析工具可直接從索引即時回答整個封存的問題。"
          }
        }
      }
    },
