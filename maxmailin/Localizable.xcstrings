    "The license for %@ expired on %@. Professional tools keep working for %lld more days — renew to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lizenz für %1$@ ist am %2$@ abgelaufen. Die Professional-Werkzeuge funktionieren noch %3$lld Tage — verlängern Sie, um weiterzuarbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The license for %1$@ expired on %2$@. Professional tools keep working for %3$lld more days — renew to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licencia de %1$@ caducó el %2$@. Las herramientas Professional siguen funcionando %3$lld días más; renueva para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licence de %1$@ a expiré le %2$@. Les outils Professional fonctionnent encore %3$lld jours — renouvelez pour continuer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ का लाइसेंस %2$@ को समाप्त हो गया। Professional टूल %3$lld दिन और काम करेंगे — जारी रखने के लिए नवीनीकरण करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licenza di %1$@ è scaduta il %2$@. Gli strumenti Professional funzionano ancora per %3$lld giorni — rinnova per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ のライセンスは %2$@ に期限切れになりました。Professional ツールはあと %3$lld 日使えます。引き続き使うには更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 라이선스가 %2$@에 만료되었습니다. Professional 도구는 %3$lld일 더 작동합니다. 계속 사용하려면 갱신하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A licença de %1$@ expirou em %2$@. As ferramentas Professional continuam funcionando por mais %3$lld dias — renove para continuar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的许可证已于 %2$@ 到期。Professional 工具还可使用 %3$lld 天——请续订以继续使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的授權已於 %2$@ 到期。Professional 工具還可使用 %3$lld 天——請續約以繼續使用。"
          }
        }
      }
    },
    "The license for %@ expired on %@. The archive, search and exports work; renew to use the Professional tools again." : {
      "comment" : "Text displayed in a warning banner at the top of the screen when a license has expired. The argument is the organization name.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lizenz für %1$@ ist am %2$@ abgelaufen. Archiv, Suche und Exporte funktionieren; verlängern Sie, um die Professional-Werkzeuge wieder zu nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The license for %1$@ expired on %2$@. The archive, search and exports work; renew to use the Professional tools again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licencia de %1$@ caducó el %2$@. El archivo, la búsqueda y las exportaciones funcionan; renueva para volver a usar las herramientas Professional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licence de %1$@ a expiré le %2$@. L’archive, la recherche et les exportations fonctionnent ; renouvelez pour utiliser à nouveau les outils Professional."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ का लाइसेंस %2$@ को समाप्त हो गया। आर्काइव, खोज और निर्यात काम करते हैं; Professional टूल फिर से उपयोग करने के लिए नवीनीकरण करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licenza di %1$@ è scaduta il %2$@. Archivio, ricerca ed esportazioni funzionano; rinnova per usare di nuovo gli strumenti Professional."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ のライセンスは %2$@ に期限切れになりました。アーカイブ、検索、書き出しは使えます。Professional ツールを再び使うには更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 라이선스가 %2$@에 만료되었습니다. 보관함, 검색, 내보내기는 작동합니다. Professional 도구를 다시 사용하려면 갱신하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A licença de %1$@ expirou em %2$@. O arquivo, a busca e as exportações funcionam; renove para usar as ferramentas Professional novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的许可证已于 %2$@ 到期。归档、搜索和导出可以使用；请续订以再次使用 Professional 工具。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的授權已於 %2$@ 到期。封存、搜尋和輸出可以使用；請續約以再次使用 Professional 工具。"
          }
        }
      }
    },
    "The license key's expiry date cannot be read." : {
