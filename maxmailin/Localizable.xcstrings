    "Five practical recipes: find and export, save attachments, clean up duplicates, back up and restore, collect and hand over" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünf praktische Rezepte: suchen und exportieren, Anhänge sichern, Duplikate aufräumen, sichern und wiederherstellen, sammeln und übergeben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinco recetas prácticas: buscar y exportar, guardar adjuntos, limpiar duplicados, copia de seguridad y restauración, recopilar y entregar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinq recettes pratiques : trouver et exporter, enregistrer les pièces jointes, nettoyer les doublons, sauvegarder et restaurer, rassembler et remettre"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पाँच व्यावहारिक रेसिपी: खोजें और निर्यात करें, अटैचमेंट सहेजें, डुप्लिकेट साफ़ करें, बैकअप लें और पुनर्स्थापित करें, एकत्र करें और सौंपें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinque ricette pratiche: trova ed esporta, salva allegati, ripulisci duplicati, backup e ripristino, raccogli e consegna"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
