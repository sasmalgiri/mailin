          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部 %lld 封邮件已校验——SHA-256 哈希与封存原件一致。已确认集合完整性，可用于电子取证生成。"
          }
        },
